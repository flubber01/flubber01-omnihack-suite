@@ -0,0 +1,250 @@
+"""🖼️ STREAM WALL :: multi-monitor quad-grid with PiP expand + live control."""
+
+from __future__ import annotations
+
+import gradio as gr
+
+from ..core.stream_bridge import BRIDGE, KINDS
+
+_CARD_CSS = """
+<style>
+.stream-card { border:1px solid rgba(0,229,255,.35); border-radius:8px;
+  background:linear-gradient(160deg,#071018 0%,#0b1b28 100%);
+  padding:8px 10px; font-size:12px; min-height:118px; position:relative; }
+.stream-card.focused { border-color:#ffb300; box-shadow:0 0 12px rgba(255,179,0,.35); }
+.sc-head { font-weight:700; color:#9adcff; letter-spacing:.04em; }
+.sc-badge { display:inline-block; padding:0 6px; border-radius:6px;
+  background:rgba(0,229,255,.12); color:#00e5ff; margin-right:4px; font-size:10px; }
+.sc-row { color:#cfe9ff; opacity:.9; margin-top:3px; }
+.viewport { border:1px solid rgba(255,179,0,.5); border-radius:8px;
+  background:#04070b; min-height:230px; position:relative; overflow:hidden; }
+.vp-frame { position:absolute; inset:0; background:
+  repeating-linear-gradient(0deg, rgba(0,229,255,.05) 0 1px, transparent 1px 26px),
+  repeating-linear-gradient(90deg, rgba(0,229,255,.05) 0 1px, transparent 1px 26px),
+  radial-gradient(circle at 30% 30%, #0b2233 0%, #04070b 70%); }
+.vp-cross { position:absolute; width:14px; height:14px; border-radius:50%;
+  border:2px solid #ffb300; transform:translate(-50%,-50%);
+  box-shadow:0 0 10px rgba(255,179,0,.8); }
+.vp-hud { position:absolute; top:6px; left:8px; font-size:11px; color:#00ff9f; }
+.pip { border:1px dashed rgba(0,229,255,.4); border-radius:6px; min-height:64px;
+  background:#071018; font-size:11px; color:#9adcff; padding:6px 8px; }
+</style>
+"""
+
+
+# ------------------------------------------------------------------ helpers
+def session_choices():
+    ids = sorted(BRIDGE.sessions)
+    return gr.update(choices=ids, value=ids[0] if ids else None)
+
+
+def _slots():
+    cards = sorted(BRIDGE.session_cards(), key=lambda c: c["session_id"])
+    while len(cards) < 4:
+        cards.append(None)
+    return cards[:4]
+
+
+def card_html(idx: int) -> str:
+    cards = _slots()
+    c = cards[idx] if idx < len(cards) else None
+    if not c:
+        return (_CARD_CSS +
+                f"<div class='stream-card'><div class='sc-head'>SLOT {idx + 1} — EMPTY</div>"
+                f"<div class='sc-row'>Attach a notebook / browser stream below.</div></div>")
+    led = "#00ff9f" if c["state"] == "FOCUSED" else "#00e5ff"
+    return (_CARD_CSS +
+            f"<div class='stream-card {'focused' if c['state'] == 'FOCUSED' else ''}'>"
+            f"<div class='sc-head' style='color:{led}'>▣ {c['kind'].upper()} · {c['session_id']}</div>"
+            f"<div class='sc-row'><span class='sc-badge'>{c['fps']} FPS</span>"
+            f"<span class='sc-badge'>🕶 {c['stealth']}</span>"
+            f"<span class='sc-badge'>{c['state']}</span></div>"
+            f"<div class='sc-row'>agent {c['agent']} @ {c['node']}</div>"
+            f"<div class='sc-row'>CPU {c['cpu']}% · GPU {c['gpu']}% · "
+            f"{c['frames']} frames · {c['kb_streamed']} KiB</div></div>")
+
+
+def wall_cards():
+    return (card_html(0), card_html(1), card_html(2), card_html(3))
+
+
+def status_md():
+    s = BRIDGE.stats()
+    return (f"**STREAM BRIDGE** · {s['sessions']} session(s) · "
+            f"**{s['total_fps']}/{s['fps_budget']} fps** (budget) · "
+            f"focus `{s['focused'] or '—'}` · {s['kb_streamed']} KiB streamed · "
+            f"{s['injections']} injections · guard cycles {s['throttle_cycles']}")
+
+
+def viewport_html():
+    BRIDGE.throttle_cycle()
+    if not BRIDGE.focused:
+        return (_CARD_CSS + "<div class='viewport'><div class='vp-hud'>"
+                "NO FOCUSED STREAM — click ⤢ EXPAND on a wall card.</div></div>")
+    fr = BRIDGE.frame(BRIDGE.focused)
+    if not fr.get("ok"):
+        return _CARD_CSS + "<div class='viewport'><div class='vp-hud'>feed lost</div></div>"
+    s = BRIDGE.sessions[BRIDGE.focused]
+    w, h = (1280, 720) if s.state == "FOCUSED" else (320, 180)
+    px = fr["mouse"][0] / max(w, 1) * 100
+    py = fr["mouse"][1] / max(h, 1) * 100
+    return (_CARD_CSS +
+            f"<div class='viewport'><div class='vp-frame'></div>"
+            f"<div class='vp-cross' style='left:{px:.1f}%;top:{py:.1f}%'></div>"
+            f"<div class='vp-hud'>◉ LIVE {fr['session_id']} · {fr['fps']} FPS · "
+            f"{fr['resolution']} · {fr['bytes']} B/frame · dom:{fr['dom_hash']} · "
+            f"mouse {fr['mouse']}</div></div>")
+
+
+def pip_html():
+    if not BRIDGE.focused:
+        return _CARD_CSS + "<div class='pip'>PiP: idle</div>"
+    fr = BRIDGE.frame(BRIDGE.focused)
+    return (_CARD_CSS +
+            f"<div class='pip'>🪟 PiP :: {fr['session_id']} · seq {fr['seq']} · "
+            f"{fr['fps']} fps · {fr['bytes']} B · {fr['encoding']}</div>")
+
+
+# ------------------------------------------------------------------ actions
+def expand(idx: int):
+    cards = _slots()
+    c = cards[idx] if idx < len(cards) else None
+    if not c:
+        return ("⚠️ Empty slot — attach a stream first.",
+                viewport_html(), pip_html(), *wall_cards(), status_md(),
+                session_choices(), session_choices())
+    res = BRIDGE.focus(c["session_id"])
+    msg = (f"⤢ **{c['session_id']}** maximized @ 30 FPS — background cards "
+           f"throttled to 2–5 FPS (streams keep running)." if res["ok"]
+           else f"❌ {res['error']}")
+    return (msg, viewport_html(), pip_html(), *wall_cards(), status_md(),
+            session_choices(), session_choices())
+
+
+def release_focus():
+    msg = BRIDGE.unfocus()
+    return (msg, viewport_html(), pip_html(), *wall_cards(), status_md(),
+            session_choices(), session_choices())
+
+
+def attach_stream(kind, agent, node):
+    res = BRIDGE.attach(kind, agent, node)
+    if not res["ok"]:
+        return (f"❌ {res['error']}", viewport_html(), pip_html(), *wall_cards(),
+                status_md(), session_choices(), session_choices())
+    return (f"🔌 Attached {kind} :: **{res['session_id']}** @ {node} "
+            f"({res['transport']}).", viewport_html(), pip_html(), *wall_cards(),
+            status_md(), session_choices(), session_choices())
+
+
+def detach_stream(session_id):
+    msg = BRIDGE.detach(session_id)
+    return (msg, viewport_html(), pip_html(), *wall_cards(), status_md(),
+            session_choices(), session_choices())
+
+
+def inject_click(session_id, x, y):
+    res = BRIDGE.inject(session_id, "click", int(x), int(y))
+    return _inject_msg(res), viewport_html()
+
+
+def inject_key(session_id, text):
+    res = BRIDGE.inject(session_id, "key", payload=text)
+    return _inject_msg(res), viewport_html()
+
+
+def inject_scroll(session_id, delta):
+    res = BRIDGE.inject(session_id, "scroll", int(delta), 0)
+    return _inject_msg(res), viewport_html()
+
+
+def _inject_msg(res):
+    if not res["ok"]:
+        return f"❌ {res['error']}"
+    return (f"🖱 Injected **{res['detail']}** → `{res['session_id']}` · "
+            f"ack {res['ack_latency_ms']}ms")
+
+
+def refresh_all():
+    return (*wall_cards(), status_md(), viewport_html(), pip_html())
+
+
+# ------------------------------------------------------------------- render
+def render() -> dict:
+    with gr.Row():
+        gr.Markdown("## 🖼️ STREAM WALL\n"
+                    "<span class='cyber-sub'>MULTI-MONITOR QUAD-GRID · PiP EXPAND · "
+                    "PYTHON RPC/WS CONTROL BRIDGE · FPS GUARD</span>")
+    status_bar = gr.Markdown(status_md, elem_classes="cyber-panel")
+
+    with gr.Row():
+        # ------------------------------------------------------- quad grid
+        with gr.Column(scale=7):
+            gr.Markdown("#### ▦ QUAD-GRID (live thumbnails, 2–5 FPS background)")
+            with gr.Row():
+                card0 = gr.HTML(card_html(0))
+                card1 = gr.HTML(card_html(1))
+            with gr.Row():
+                card2 = gr.HTML(card_html(2))
+                card3 = gr.HTML(card_html(3))
+            with gr.Row():
+                exp0 = gr.Button("⤢ EXPAND 1", variant="secondary")
+                exp1 = gr.Button("⤢ EXPAND 2", variant="secondary")
+                exp2 = gr.Button("⤢ EXPAND 3", variant="secondary")
+                exp3 = gr.Button("⤢ EXPAND 4", variant="secondary")
+            gr.Markdown("#### 🔌 ATTACH / DETACH STREAM")
+            with gr.Row():
+                kind_dd = gr.Dropdown(KINDS, value=KINDS[0], label="KIND", scale=2)
+                agent_tx = gr.Textbox(value="MINION-09", label="AGENT", scale=1)
+                node_tx = gr.Textbox(value="CLOUD-POOL-1", label="NODE", scale=1)
+                attach_btn = gr.Button("🔌 ATTACH", variant="primary", scale=1)
+            with gr.Row():
+                detach_dd = gr.Dropdown(value=None, label="SESSION TO DETACH",
+                                         scale=3)
+                detach_btn = gr.Button("🔌 DETACH", variant="stop", scale=1)
+
+        # ------------------------------------------------- viewport + control
+        with gr.Column(scale=5):
+            gr.Markdown("#### ◉ LIVE BROWSER STREAM & REPLICA WINDOW (30 FPS)")
+            viewport = gr.HTML(viewport_html)
+            pip = gr.HTML(pip_html)
+            with gr.Row():
+                unfocus_btn = gr.Button("🪟 RELEASE FOCUS", variant="secondary")
+            msg = gr.Markdown("")
+            gr.Markdown("#### 🖱 BIDIRECTIONAL INJECTION (RPC → remote instance)")
+            target_dd = gr.Dropdown(value=None, label="TARGET SESSION", scale=1)
+            with gr.Row():
+                x_sl = gr.Slider(0, 1280, value=640, step=1, label="X", scale=1)
+                y_sl = gr.Slider(0, 720, value=360, step=1, label="Y", scale=1)
+                click_btn = gr.Button("🖱 CLICK", variant="primary", scale=1)
+            with gr.Row():
+                key_tx = gr.Textbox(placeholder="e.g. 'Enter' or text…",
+                                     label="KEYBOARD", scale=3)
+                key_btn = gr.Button("⌨ SEND", variant="primary", scale=1)
+            with gr.Row():
+                scroll_sl = gr.Slider(-500, 500, value=-120, step=10,
+                                       label="SCROLL Δ", scale=3)
+                scroll_btn = gr.Button("⇅ SCROLL", variant="secondary", scale=1)
+
+    # ---------------------------------------------------------------- wiring
+    # expand(i) → msg, viewport, pip, 4 cards, status, 2 dropdowns (9 outs)
+    full_outs = [msg, viewport, pip, card0, card1, card2, card3, status_bar,
+                 target_dd, detach_dd]
+    for btn, i in ((exp0, 0), (exp1, 1), (exp2, 2), (exp3, 3)):
+        btn.click(lambda i=i: expand(i), outputs=full_outs)
+    attach_btn.click(attach_stream, inputs=[kind_dd, agent_tx, node_tx],
+                      outputs=full_outs)
+    detach_btn.click(detach_stream, inputs=[detach_dd], outputs=full_outs)
+    unfocus_btn.click(release_focus, outputs=full_outs)
+    click_btn.click(inject_click, inputs=[target_dd, x_sl, y_sl],
+                     outputs=[msg, viewport])
+    key_btn.click(inject_key, inputs=[target_dd, key_tx], outputs=[msg, viewport])
+    scroll_btn.click(inject_scroll, inputs=[target_dd, scroll_sl],
+                      outputs=[msg, viewport])
+
+    timer = gr.Timer(2.0)
+    timer.tick(refresh_all, outputs=[card0, card1, card2, card3,
+                                      status_bar, viewport, pip])
+
+    return {"cards": [card0, card1, card2, card3], "viewport": viewport,
+            "pip": pip, "target_dd": target_dd, "detach_dd": detach_dd}
