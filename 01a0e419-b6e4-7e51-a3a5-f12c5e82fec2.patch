+++ b/mission_control/core/dbal_engine.py
@@ -0,0 +1,222 @@
+"""🗄️ DBAL ENGINE :: database abstraction layer unifying all vaults.
+
+One connector surface over:
+
+* the **local SQLite vaults** (``omni_memory.db`` + every ``*.db`` under
+  ``~/.omnihack/vault/``) — real, fully introspectable, and
+* **external SQL endpoints** (PostgreSQL, MySQL, Supabase, Neon) registered
+  by connection string.  Without installed drivers the external links run
+  in *registered-simulated* mode so the suite stays native-safe.
+
+Plus **auto-schema discovery** (column introspection + type mapping) and a
+**migration wrapper generator** that emits idempotent CREATE/INDEX DDL for
+any discovered table.
+"""
+
+from __future__ import annotations
+
+import glob
+import os
+import re
+import sqlite3
+import threading
+from typing import Any, Dict, List, Optional
+from urllib.parse import urlparse
+
+from .state import STATE, now_iso
+
+DB_PATH = os.environ.get(
+    "OMNI_DBAL_DB", os.path.expanduser("~/.omnihack/vault/dbal.db"))
+VAULT_DIR = os.path.expanduser("~/.omnihack/vault")
+MEMORY_DB = os.path.join(
+    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "data",
+    "omni_memory.db")
+
+SUPPORTED_SCHEMES = ("postgresql", "postgres", "mysql", "supabase", "neon")
+_DRIVERS = {"postgresql": "psycopg2", "postgres": "psycopg2",
+            "mysql": "pymysql", "supabase": "supabase", "neon": "psycopg2"}
+
+
+def _mask_conn(conn_string: str) -> str:
+    return re.sub(r"://[^@/]+@", "://***:***@", conn_string or "")
+
+
+class DBAL:
+    """Registry + discovery + migration surface over every vault."""
+
+    def __init__(self, db_path: Optional[str] = None) -> None:
+        self.db_path = db_path or DB_PATH
+        self.lock = threading.RLock()
+        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
+        self._init_db()
+
+    # ------------------------------------------------------------------ db
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.db_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS registry (
+                name TEXT PRIMARY KEY, kind TEXT, target TEXT,
+                status TEXT, registered TEXT);
+            CREATE TABLE IF NOT EXISTS migrations (
+                ts TEXT, source TEXT, table_name TEXT, ddl TEXT);
+            CREATE TABLE IF NOT EXISTS sync_log (
+                ts TEXT, source TEXT, rows INTEGER, note TEXT);
+            """)
+        self._sync_local_registry()
+
+    def _sync_local_registry(self) -> None:
+        """Pick up vaults created after engine init (cheap INSERT OR IGNORE)."""
+        with self.lock, self._conn() as conn:
+            for path in self.local_vaults():
+                conn.execute("INSERT OR IGNORE INTO registry (name, kind, target,"
+                             " status, registered) VALUES (?,?,?,?,?)",
+                             (os.path.basename(path), "sqlite", path,
+                              "ONLINE", now_iso()))
+
+    # ------------------------------------------------------------- registry
+    def local_vaults(self) -> List[str]:
+        paths = sorted(glob.glob(os.path.join(VAULT_DIR, "*.db")))
+        if os.path.exists(MEMORY_DB):
+            paths = [MEMORY_DB] + [p for p in paths if p != MEMORY_DB]
+        return paths
+
+    def register_external(self, name: str, conn_string: str) -> Dict[str, Any]:
+        name = (name or "").strip().lower()
+        conn_string = (conn_string or "").strip()
+        if not name or not re.match(r"^[a-z0-9_-]{2,32}$", name):
+            return {"ok": False, "error": "invalid registry name"}
+        parsed = urlparse(conn_string)
+        scheme = parsed.scheme.split("+")[0].lower()
+        if scheme not in SUPPORTED_SCHEMES:
+            return {"ok": False,
+                    "error": f"unsupported scheme '{scheme}'",
+                    "supported": sorted(set(SUPPORTED_SCHEMES))}
+        driver = _DRIVERS[scheme]
+        try:
+            __import__(driver)
+            status = "ONLINE (driver present)"
+        except ImportError:
+            status = "REGISTERED (driver pending — simulated link)"
+        with self.lock, self._conn() as conn:
+            conn.execute("INSERT OR REPLACE INTO registry (name, kind, target,"
+                         " status, registered) VALUES (?,?,?,?,?)",
+                         (name, scheme, _mask_conn(conn_string), status, now_iso()))
+        STATE.log("OK", "DBAL", f"External endpoint registered :: {name} "
+                                f"({scheme}) — {status}")
+        return {"ok": True, "name": name, "scheme": scheme, "status": status}
+
+    def registry_rows(self) -> List[Dict[str, Any]]:
+        self._sync_local_registry()
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT * FROM registry ORDER BY kind, name"
+                                ).fetchall()
+        return [dict(r) for r in rows]
+
+    # ------------------------------------------------------------- discovery
+    def discover_schema(self, name: str) -> Dict[str, Any]:
+        """Introspect a registered source: tables → columns → type mapping."""
+        self._sync_local_registry()
+        with self.lock, self._conn() as conn:
+            reg = conn.execute("SELECT * FROM registry WHERE name=?",
+                               (name,)).fetchone()
+        if not reg:
+            return {"ok": False, "error": f"unknown source '{name}'",
+                    "sources": [r["name"] for r in self.registry_rows()]}
+        if reg["kind"] == "sqlite":
+            try:
+                target = sqlite3.connect(reg["target"], timeout=3)
+                tables = [t[0] for t in target.execute(
+                    "SELECT name FROM sqlite_master WHERE type='table'"
+                    " AND name NOT LIKE 'sqlite_%'").fetchall()]
+                schema = {}
+                for t in tables:
+                    cols = target.execute(f"PRAGMA table_info('{t}')").fetchall()
+                    schema[t] = [{"column": c[1], "type": c[2] or "TEXT",
+                                  "notnull": bool(c[3]), "pk": bool(c[5])}
+                                 for c in cols]
+                target.close()
+                return {"ok": True, "source": name, "kind": "sqlite",
+                        "tables": len(schema), "schema": schema}
+            except sqlite3.Error as exc:
+                return {"ok": False, "error": f"introspection failed: {exc}"}
+        # external endpoint without live driver → generic projection
+        return {"ok": True, "source": name, "kind": reg["kind"],
+                "tables": 0, "schema": {},
+                "note": f"{reg['status']} — schema discovery runs once the "
+                        f"driver connects (mapping rules ready)"}
+
+    TYPE_MAP = {"INTEGER": "BIGINT", "REAL": "DOUBLE PRECISION",
+                "TEXT": "TEXT", "BLOB": "BYTEA", "NUMERIC": "NUMERIC"}
+
+    def generate_migration(self, name: str, table: str) -> Dict[str, Any]:
+        """Emit idempotent DDL mirroring a discovered table."""
+        disc = self.discover_schema(name)
+        if not disc["ok"]:
+            return disc
+        schema = disc.get("schema", {})
+        if table not in schema:
+            return {"ok": False, "error": f"table '{table}' not found on "
+                                          f"'{name}'", "tables": sorted(schema)}
+        cols, pks = [], []
+        for c in schema[table]:
+            ext_type = self.TYPE_MAP.get(c["type"].upper().split("(")[0], "TEXT")
+            cols.append(f"    {c['column']} {ext_type}"
+                        + (" NOT NULL" if c["notnull"] else ""))
+            if c["pk"]:
+                pks.append(c["column"])
+        if pks:
+            cols.append(f"    PRIMARY KEY ({', '.join(pks)})")
+        ddl = (f"CREATE TABLE IF NOT EXISTS {table} (\n"
+               + ",\n".join(cols) + "\n);")
+        with self.lock, self._conn() as conn:
+            conn.execute("INSERT INTO migrations (ts, source, table_name, ddl)"
+                         " VALUES (?,?,?,?)", (now_iso(), name, table, ddl))
+        return {"ok": True, "source": name, "table": table, "ddl": ddl,
+                "columns": len(schema[table])}
+
+    # --------------------------------------------------------- local queries
+    def query_local(self, vault: str, sql: str, limit: int = 20) -> Dict[str, Any]:
+        """SELECT-only window into any registered SQLite vault."""
+        sql = (sql or "").strip().rstrip(";")
+        if not re.match(r"(?is)^\s*SELECT\b", sql) or re.search(
+                r"(?is)\b(insert|update|delete|drop|alter|attach|pragma)\b", sql):
+            return {"ok": False, "error": "only SELECT queries are allowed"}
+        self._sync_local_registry()
+        with self.lock, self._conn() as conn:
+            reg = conn.execute("SELECT * FROM registry WHERE name=? AND kind='sqlite'",
+                               (vault,)).fetchone()
+        if not reg:
+            return {"ok": False, "error": f"unknown sqlite vault '{vault}'"}
+        try:
+            target = sqlite3.connect(reg["target"], timeout=3)
+            target.row_factory = sqlite3.Row
+            rows = target.execute(sql + " LIMIT ?", (max(1, min(200, limit)),)).fetchall()
+            target.close()
+            return {"ok": True, "vault": vault, "rows": [dict(r) for r in rows]}
+        except sqlite3.Error as exc:
+            return {"ok": False, "error": f"query failed: {exc}"}
+
+    # ------------------------------------------------------------- telemetry
+    def stats(self) -> Dict[str, Any]:
+        self._sync_local_registry()
+        with self.lock, self._conn() as conn:
+            n_reg = conn.execute("SELECT COUNT(*) c FROM registry").fetchone()["c"]
+            n_ext = conn.execute("SELECT COUNT(*) c FROM registry"
+                                 " WHERE kind != 'sqlite'").fetchone()["c"]
+            n_mig = conn.execute("SELECT COUNT(*) c FROM migrations").fetchone()["c"]
+        return {"sources": n_reg, "external": n_ext,
+                "local_vaults": n_reg - n_ext, "migrations": n_mig,
+                "db_path": self.db_path}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return (f"[DBAL] {s['sources']} sources ({s['external']} external) · "
+                f"{s['migrations']} migrations")
+
+
+DBAL_ENGINE = DBAL()
