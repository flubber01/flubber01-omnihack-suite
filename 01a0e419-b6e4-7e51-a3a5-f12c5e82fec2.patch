@@ -0,0 +1,247 @@
+"""🔌 MCP BRIDGE :: Model Context Protocol tool gateway (backend middleware).
+
+Standardised, sandboxed protocol bridges that let sub-agents invoke external
+tool families (file system, git/GitHub, databases, HTTP, memory, browser,
+shell) through ONE routing surface — without touching core routing or any
+frontend UI.
+
+Design
+------
+* **MCP_SERVERS** — declarative server registry: each server exposes typed
+  tool specs (JSON-schema-like) and an auth/state block.
+* **MCPBridge.call_tool()** — validates params against the tool spec,
+  applies the same destructive-pattern guard used by the SSH sandbox, then
+  returns a simulated execution receipt (the app stays native-safe).
+* **gateway_tools()** — exports MCP tools into the Hermes tool gateway so
+  the cross-reference engine and agents discover them uniformly.
+
+Everything is in-process, thread-safe and deterministic.  No UI involved.
+"""
+
+from __future__ import annotations
+
+import re
+import threading
+import time
+from typing import Any, Dict, List, Optional
+
+from .state import STATE, now_iso, uid
+
+# --------------------------------------------------------------------------- #
+# Server registry — each MCP server = typed tool surface + state
+# --------------------------------------------------------------------------- #
+MCP_SERVERS: Dict[str, Dict[str, Any]] = {
+    "filesystem": {
+        "desc": "Local file-system bridge (read/list/stat only by default)",
+        "transport": "stdio", "auth": "none",
+        "tools": {
+            "fs.read": {"params": {"path": "str"}, "readonly": True,
+                        "desc": "read a file from the workspace"},
+            "fs.list": {"params": {"path": "str"}, "readonly": True,
+                        "desc": "list directory entries"},
+            "fs.stat": {"params": {"path": "str"}, "readonly": True,
+                        "desc": "file metadata"},
+        },
+    },
+    "git": {
+        "desc": "Git operations bridge",
+        "transport": "stdio", "auth": "none",
+        "tools": {
+            "git.status": {"params": {"repo": "str"}, "readonly": True,
+                           "desc": "working-tree status"},
+            "git.log": {"params": {"repo": "str", "limit": "int"}, "readonly": True,
+                        "desc": "commit log"},
+            "git.diff": {"params": {"repo": "str"}, "readonly": True,
+                         "desc": "pending diff"},
+        },
+    },
+    "github": {
+        "desc": "GitHub REST bridge (repos, issues, search)",
+        "transport": "https", "auth": "token-optional",
+        "tools": {
+            "gh.repo_info": {"params": {"repo": "str"}, "readonly": True,
+                             "desc": "repository metadata"},
+            "gh.search": {"params": {"query": "str"}, "readonly": True,
+                          "desc": "code/repo search"},
+            "gh.template_list": {"params": {"topic": "str"}, "readonly": True,
+                                 "desc": "starter template discovery"},
+        },
+    },
+    "sql": {
+        "desc": "SQLite/DBAL bridge for the local vaults",
+        "transport": "stdio", "auth": "none",
+        "tools": {
+            "sql.query": {"params": {"sql": "str"}, "readonly": True,
+                          "desc": "SELECT against a vault db"},
+            "sql.tables": {"params": {"db": "str"}, "readonly": True,
+                           "desc": "list tables"},
+        },
+    },
+    "http": {
+        "desc": "Outbound HTTP bridge (GET/HEAD, egress-guarded)",
+        "transport": "https", "auth": "none",
+        "tools": {
+            "http.get": {"params": {"url": "str"}, "readonly": True,
+                         "desc": "fetch a URL"},
+            "http.head": {"params": {"url": "str"}, "readonly": True,
+                          "desc": "headers only"},
+        },
+    },
+    "memory": {
+        "desc": "Memory-vault bridge (store/recall)",
+        "transport": "stdio", "auth": "none",
+        "tools": {
+            "memory.store": {"params": {"content": "str", "kind": "str"},
+                             "readonly": False, "desc": "store a memory"},
+            "memory.recall": {"params": {"query": "str"}, "readonly": True,
+                              "desc": "recall memories"},
+        },
+    },
+    "browser": {
+        "desc": "Remote browser bridge (navigate/snapshot)",
+        "transport": "ws", "auth": "session",
+        "tools": {
+            "browser.navigate": {"params": {"url": "str"}, "readonly": False,
+                                 "desc": "open a page"},
+            "browser.snapshot": {"params": {}, "readonly": True,
+                                 "desc": "DOM + frame capture"},
+        },
+    },
+    "shell": {
+        "desc": "Sandboxed shell bridge (destructive patterns blocked)",
+        "transport": "stdio", "auth": "none",
+        "tools": {
+            "shell.exec": {"params": {"cmd": "str"}, "readonly": False,
+                           "desc": "run a sandboxed command"},
+        },
+    },
+}
+
+# same destructive-pattern guard philosophy as the SSH sandbox
+_BLOCKED_CMD = re.compile(
+    r"(rm\s+-rf\s+/|mkfs|dd\s+if=|:(){|chmod\s+-R\s+777\s+/|shutdown|reboot"
+    r"|>\s*/dev/sd|curl[^\n]*\|\s*(ba)?sh)", re.I)
+
+_MISSING = object()
+
+
+class MCPBridge:
+    """One routing surface for all MCP tool invocations."""
+
+    def __init__(self) -> None:
+        self.lock = threading.RLock()
+        self.call_count = 0
+        self.blocked_count = 0
+        self.recent: List[Dict[str, Any]] = []
+        self._registry: Dict[str, Dict[str, Any]] = {
+            name: {**cfg, "status": "ONLINE", "calls": 0}
+            for name, cfg in MCP_SERVERS.items()
+        }
+
+    # ------------------------------------------------------------- discovery
+    def list_servers(self) -> List[Dict[str, Any]]:
+        with self.lock:
+            return [{"name": n, "desc": s["desc"], "transport": s["transport"],
+                     "auth": s["auth"], "status": s["status"],
+                     "tools": len(s["tools"]), "calls": s["calls"]}
+                    for n, s in self._registry.items()]
+
+    def server_info(self, name: str) -> Dict[str, Any]:
+        with self.lock:
+            srv = self._registry.get((name or "").lower())
+        if not srv:
+            return {"ok": False, "error": f"unknown MCP server '{name}'"}
+        return {"ok": True, "name": name.lower(), **srv}
+
+    def register_server(self, name: str, desc: str, tools: Dict[str, Dict[str, Any]],
+                        transport: str = "stdio") -> str:
+        name = (name or "").strip().lower()
+        if not name or not tools:
+            return "⚠️ Server name + tools required."
+        with self.lock:
+            self._registry[name] = {
+                "desc": desc or "custom MCP server", "transport": transport,
+                "auth": "none", "tools": tools, "status": "ONLINE", "calls": 0}
+        STATE.log("INFO", "MCP", f"Server registered :: {name} ({len(tools)} tools).")
+        return f"🔌 MCP server '{name}' registered with {len(tools)} tool(s)."
+
+    # ------------------------------------------------------------ invocation
+    def call_tool(self, tool_id: str, params: Optional[Dict[str, Any]] = None,
+                  agent: str = "—") -> Dict[str, Any]:
+        """Validate → guard → route.  Returns a simulated receipt."""
+        tool_id = (tool_id or "").strip()
+        params = params or {}
+
+        with self.lock:
+            # global tool index: tool ids are unique across all servers
+            srv, server_name, spec = None, "", None
+            for name, candidate in self._registry.items():
+                if tool_id in candidate["tools"]:
+                    srv, server_name, spec = candidate, name, candidate["tools"][tool_id]
+                    break
+            if not spec:
+                return {"ok": False, "error": f"tool '{tool_id}' not found on any "
+                                               f"MCP server",
+                        "servers": sorted(self._registry),
+                        "tools": sorted(t["id"] for t in self.gateway_tools())}
+
+            # schema-style param validation
+            missing = [k for k in spec.get("params", {}) if k not in params]
+            if missing:
+                return {"ok": False, "error": f"missing params: {', '.join(missing)}",
+                        "spec": spec}
+            extra = [k for k in params if k not in spec.get("params", {})]
+            if extra:
+                return {"ok": False, "error": f"unknown params: {', '.join(extra)}"}
+
+            # sandbox guard for shell-ish payloads
+            blob = " ".join(str(v) for v in params.values())
+            if _BLOCKED_CMD.search(blob):
+                self.blocked_count += 1
+                STATE.log("CRIT", "MCP", f"BLOCKED destructive call :: {tool_id}")
+                return {"ok": False, "error": "destructive pattern blocked by sandbox"}
+
+            srv["calls"] += 1
+            self.call_count += 1
+
+        t0 = time.time()
+        receipt = {
+            "ok": True, "tool": tool_id, "server": server_name,
+            "transport": srv["transport"], "agent": agent,
+            "runtime_ms": int((time.time() - t0) * 1000) + 3,
+            "status": "SIMULATED_OK", "params": params,
+            "output": f"[{server_name}] {tool_id} executed via MCP bridge "
+                      f"(simulated, {srv['transport']}).",
+            "ts": now_iso(), "id": uid("mcp"),
+        }
+        with self.lock:
+            self.recent.append(receipt)
+            if len(self.recent) > 200:
+                del self.recent[:100]
+        STATE.log("INFO", "MCP", f"{tool_id} ← {agent} :: SIMULATED_OK")
+        return receipt
+
+    # ----------------------------------------------------- gateway export
+    def gateway_tools(self) -> List[Dict[str, Any]]:
+        """Flat tool list for the Hermes gateway / cross-reference engine."""
+        out = []
+        with self.lock:
+            for name, srv in self._registry.items():
+                for tool_id, spec in srv["tools"].items():
+                    out.append({"id": tool_id, "server": name,
+                                "readonly": spec.get("readonly", True),
+                                "desc": spec.get("desc", "")})
+        return out
+
+    # ----------------------------------------------------------- telemetry
+    def stats(self) -> Dict[str, Any]:
+        with self.lock:
+            servers = len(self._registry)
+            online = sum(1 for s in self._registry.values() if s["status"] == "ONLINE")
+            tools = sum(len(s["tools"]) for s in self._registry.values())
+        return {"servers": servers, "online": online, "tools": tools,
+                "calls": self.call_count, "blocked": self.blocked_count,
+                "recent_buffer": len(self.recent)}
+
+
+BRIDGE_MCP = MCPBridge()
