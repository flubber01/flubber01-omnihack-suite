+        nav = ("➡️ Antworte `next` für Schritt "
+               f"{self.step + 2}/{total}." if self.step < total - 1
+               else "✅ Guide abgeschlossen. Schreib `topics` für weitere Themen.")
+        return (f"{g['title']} — Schritt {self.step + 1}/{total}\n\n{step}\n\n{nav}")
