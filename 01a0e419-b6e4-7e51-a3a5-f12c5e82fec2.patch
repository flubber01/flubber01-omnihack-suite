+# --------------------------------------------------------------------------- #
+# Vault crypto: Fernet when `cryptography` is available, keyed-XOR fallback.
+# The fallback is AT-REST OBFUSCATION (documented limitation), not strong
+# crypto — set OMNI_NEXUS_PASS and install `cryptography` for full strength.
+# --------------------------------------------------------------------------- #
+class _VaultCrypto:
+    PREFIX_FERNET = "fx1:"
+    PREFIX_XOR = "xo1:"
+
+    def __init__(self, passphrase: Optional[str] = None) -> None:
+        secret = passphrase or os.environ.get("OMNI_NEXUS_PASS") or (
+            f"omnihack::{socket.gethostname()}::{os.environ.get('USER', 'ops')}")
+        self._key = hashlib.sha256(secret.encode()).digest()
+        self._fernet = None
+        try:
+            from cryptography.fernet import Fernet  # type: ignore
+            self._fernet = Fernet(base64.urlsafe_b64encode(self._key))
+        except Exception:
+            self._fernet = None
+
+    def encrypt(self, text: str) -> str:
+        if self._fernet is not None:
+            return self.PREFIX_FERNET + self._fernet.encrypt(text.encode()).decode()
+        data = text.encode()
+        xored = bytes(b ^ self._key[i % len(self._key)] for i, b in enumerate(data))
+        return self.PREFIX_XOR + base64.b64encode(xored).decode()
+
+    def decrypt(self, blob: str) -> str:
+        if blob.startswith(self.PREFIX_FERNET) and self._fernet is not None:
+            return self._fernet.decrypt(blob[4:].encode()).decode()
+        if blob.startswith(self.PREFIX_XOR):
+            xored = base64.b64decode(blob[4:])
+            return bytes(b ^ self._key[i % len(self._key)]
+                         for i, b in enumerate(xored)).decode()
+        return blob  # legacy plaintext row
+
+
+# --------------------------------------------------------------------------- #
+def looks_like_dummy(key: str) -> bool:
+    """True if the key is obviously a placeholder / test / dummy value."""
+    k = (key or "").strip()
+    if len(k) < 8:
+        return True
+    return any(p.search(k) for p in DUMMY_PATTERNS)
+
+
+def detect_provider(value: str) -> str:
+    """Map a raw secret to its provider via signature (defensive scanner)."""
+    for provider, pattern in KEY_SIGNATURES.items():
+        if pattern.search(value or ""):
+            return provider
+    return "unknown"
+
+
+def mask_secret(value: str) -> str:
+    v = (value or "").strip()
+    return v[:6] + "…" + str(len(v)) if len(v) > 8 else "…"
+
+
+# --------------------------------------------------------------------------- #
+class ApiNexus:
+    """Vault + free-endpoint pool + learning curve + health worker + RPC."""
+
+    def __init__(self, vault_path: Optional[str] = None) -> None:
+        self.vault_path = vault_path or VAULT_PATH
+        self.lock = threading.RLock()
+        self.crypto = _VaultCrypto()
+        os.makedirs(os.path.dirname(self.vault_path), exist_ok=True)
+        self._init_db()
+        self._seed_catalog()
+
+        # worker state
+        self.worker_running = False
+        self.worker_cycles = 0
+        self.last_cycle_ts = ""
+        self._stop = threading.Event()
+        self._thread: Optional[threading.Thread] = None
+        self._rnd = random.Random(7860)
+
+    # ------------------------------------------------------------- DBAL layer
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.vault_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS api_vault (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                provider TEXT, category TEXT,
+                api_key_enc TEXT UNIQUE, provenance TEXT DEFAULT 'operator',
+                status TEXT DEFAULT 'active', health_score INTEGER DEFAULT 100,
+                failure_count INTEGER DEFAULT 0, rotations INTEGER DEFAULT 0,
+                last_used TEXT, last_checked TEXT, added TEXT);
+            CREATE TABLE IF NOT EXISTS free_endpoints (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                provider TEXT, category TEXT, url TEXT UNIQUE,
+                health_path TEXT, docs TEXT, note TEXT, source TEXT,
+                status TEXT DEFAULT 'active', health_score INTEGER DEFAULT 100,
+                latency_ms INTEGER DEFAULT 0, failure_count INTEGER DEFAULT 0,
+                last_checked TEXT);
+            CREATE TABLE IF NOT EXISTS learning_metrics (
+                source_id TEXT PRIMARY KEY,
+                total_hits INTEGER DEFAULT 0, valid_hits INTEGER DEFAULT 0,
+                learning_weight REAL DEFAULT 1.0, last_updated TEXT);
+            CREATE TABLE IF NOT EXISTS harvest_log (
+                ts TEXT, event TEXT, source TEXT, provider TEXT,
+                count INTEGER, note TEXT);
+            CREATE TABLE IF NOT EXISTS leak_findings (
+                ts TEXT, file TEXT, provider TEXT, fingerprint TEXT,
+                action TEXT DEFAULT 'revoke');
+            """)
+
+    def _seed_catalog(self) -> None:
+        """Seed the bundled free-API catalogue on first start (idempotent)."""
+        with self.lock, self._conn() as conn:
+            existing = conn.execute("SELECT COUNT(*) c FROM free_endpoints").fetchone()["c"]
+            if existing:
+                return
+            for ep in FREE_API_CATALOG:
+                conn.execute(
+                    "INSERT OR IGNORE INTO free_endpoints"
+                    " (provider, category, url, health_path, docs, note, source,"
+                    "  status, health_score, last_checked)"
+                    " VALUES (?,?,?,?,?,?,?, 'active', 100, ?)",
+                    (ep["provider"], ep["category"], ep["url"], ep["health_path"],
+                     ep["docs"], ep["note"], "bundled-catalog", now_iso()))
+            self._log_event(conn, "catalog-seed", "bundled-catalog", "—",
+                            len(FREE_API_CATALOG), "free keyless endpoints seeded")
+        STATE.log("INFO", "API-NEXUS",
+                  f"DBAL vault online :: {self.vault_path} · "
+                  f"{len(FREE_API_CATALOG)} free endpoints seeded.")
+
+    @staticmethod
+    def _log_event(conn: sqlite3.Connection, event: str, source: str,
+                   provider: str, count: int, note: str) -> None:
+        conn.execute("INSERT INTO harvest_log (ts, event, source, provider, count, note)"
+                     " VALUES (?,?,?,?,?,?)",
+                     (now_iso(), event, source, provider, int(count), note))
+
+    # -------------------------------------------------- operator key ingestion
+    def store_key(self, provider: str, category: str, key: str,
+                  provenance: str = "operator") -> Dict[str, Any]:
+        """Store an OPERATOR-SUPPLIED key after format + dummy validation.
+
+        Keys with any provenance other than 'operator'/'self' are refused —
+        this engine never banks credentials it did not receive from you.
+        """
+        provider = (provider or "unknown").strip().lower()
+        category = (category or "misc").strip().lower()
+        key = (key or "").strip()
+
+        if provenance not in ("operator", "self"):
+            STATE.log("CRIT", "API-NEXUS",
+                      f"Refused non-operator credential (provenance={provenance!r}).")
+            return {"ok": False, "error": "only operator-supplied keys are accepted"}
+        if not key:
+            return {"ok": False, "error": "empty key"}
+        if looks_like_dummy(key):
+            with self.lock, self._conn() as conn:
+                self._log_event(conn, "key-rejected", "operator", provider, 1,
+                                "dummy/placeholder signature")
+            return {"ok": False, "error": "dummy/placeholder key rejected"}
+        pattern = KEY_SIGNATURES.get(provider)
+        if pattern and not pattern.search(key):
+            return {"ok": False,
+                    "error": f"key does not match {provider} format signature"}
+        if category not in CATEGORIES:
+            category = "misc"
+
+        blob = self.crypto.encrypt(key)
+        with self.lock, self._conn() as conn:
+            try:
+                conn.execute(
+                    "INSERT INTO api_vault (provider, category, api_key_enc,"
+                    " provenance, added) VALUES (?,?,?,?,?)",
+                    (provider, category, blob, "operator", now_iso()))
+            except sqlite3.IntegrityError:
+                return {"ok": False, "error": "key already in vault"}
+            self._log_event(conn, "key-stored", "operator", provider, 1, category)
+        self.update_learning("operator", True)
+        STATE.log("OK", "API-NEXUS",
+                  f"Operator key banked :: {provider} ({category}).")
+        return {"ok": True, "provider": provider, "category": category}
+
+    def reveal_key(self, key_id: int) -> str:
+        with self.lock, self._conn() as conn:
+            row = conn.execute("SELECT api_key_enc FROM api_vault WHERE id=?",
+                               (key_id,)).fetchone()
+        return self.crypto.decrypt(row["api_key_enc"]) if row else ""
+
+    def vault_overview(self) -> List[Dict[str, Any]]:
+        with self.lock, self._conn() as conn:
+            rows = conn.execute(
+                "SELECT id, provider, category, status, health_score,"
+                " failure_count, rotations, last_used, added"
+                " FROM api_vault ORDER BY added DESC").fetchall()
+        out = []
+        for r in rows:
+            d = dict(r)
+            d["key_preview"] = mask_secret(self.reveal_key(d["id"]))
+            out.append(d)
+        return out
+
+    def revoke_key(self, key_id: int) -> str:
+        with self.lock, self._conn() as conn:
+            cur = conn.execute("UPDATE api_vault SET status='revoked' WHERE id=?",
+                               (key_id,))
+        return "🗑️ Key revoked." if cur.rowcount else "⚠️ Key id not found."
+
+    # ------------------------------------------------------ free-endpoint pool
+    def endpoints(self, category: str = "", status: str = "") -> List[Dict[str, Any]]:
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT * FROM free_endpoints"
+                                " ORDER BY health_score DESC").fetchall()
+        out = []
+        for r in rows:
+            if category and category != "ALL" and r["category"] != category:
+                continue
+            if status and status != "ALL" and r["status"] != status:
+                continue
+            out.append(dict(r))
+        return out
+
+    # --------------------------------------------------------- learning curve
+    def update_learning(self, source_id: str, valid: bool) -> None:
+        ts = now_iso()
+        with self.lock, self._conn() as conn:
+            conn.execute(
+                "INSERT INTO learning_metrics"
+                " (source_id, total_hits, valid_hits, learning_weight, last_updated)"
+                " VALUES (?, 1, ?, 1.0, ?)"
+                " ON CONFLICT(source_id) DO UPDATE SET"
+                "   total_hits = total_hits + 1,"
+                "   valid_hits = valid_hits + ?,"
+                "   last_updated = ?",
+                (source_id, 1 if valid else 0, ts, 1 if valid else 0, ts))
+            conn.execute(
+                "UPDATE learning_metrics SET learning_weight ="
+                " MAX(0.05, CAST(valid_hits AS REAL) / CAST(total_hits AS REAL))"
+                " WHERE source_id = ?", (source_id,))
+
+    def ranked_sources(self, limit: int = 10) -> List[Dict[str, Any]]:
+        with self.lock, self._conn() as conn:
+            rows = conn.execute(
+                "SELECT * FROM learning_metrics ORDER BY learning_weight DESC,"
+                " valid_hits DESC LIMIT ?", (limit,)).fetchall()
+        return [dict(r) for r in rows]
+
+    # ------------------------------------------------- external directory ingest
+    def ingest_directory(self, source_name: str, url: str) -> Dict[str, Any]:
+        """Ingest an operator-supplied API directory (OpenAPI spec / JSON list).
+
+        Extracts ENDPOINT metadata only.  Anything matching a credential
+        signature in the fetched document is counted and REDACTED — this
+        module never stores secrets it finds on the internet.
+        """
+        source_name = (source_name or "external").strip() or "external"
+        url = (url or "").strip()
+        if not re.match(r"^https?://[^ ]+$", url or ""):
+            return {"ok": False, "error": "invalid URL — must be http(s)"}
+
+        if not _HAVE_REQUESTS:  # simulated fallback keeps the app native-safe
+            return self._simulated_ingest(source_name, url, reason="no-requests")
+        try:
+            resp = requests.get(
+                url, timeout=INGEST_TIMEOUT_S,
+                headers={"User-Agent": "omnihack-api-nexus/2.3"},
+                stream=True)
+            if resp.status_code != 200:
+                self.update_learning(source_name, False)
+                return {"ok": False, "error": f"HTTP {resp.status_code}"}
+            content = resp.raw.read(MAX_INGEST_BYTES, decode_content=True)
+            text = content.decode("utf-8", errors="replace")
+        except Exception as exc:
+            # network blocked / DNS fail → simulated receipt so the flow stays testable
+            return self._simulated_ingest(source_name, url, reason=str(exc)[:120])
+
+        redacted = 0
+        for pattern in KEY_SIGNATURES.values():
+            hits = pattern.findall(text)
+            redacted += len(hits)
+            text = pattern.sub("█REDACTED█", text)
+        if redacted:
+            STATE.log("WARN", "API-NEXUS",
+                      f"Ingest {source_name}: {redacted} credential-shaped strings"
+                      f" REDACTED (never stored).")
+
+        found = self._extract_endpoints(text, source_name)
+        valid_now = 0
+        with self.lock, self._conn() as conn:
+            for ep in found:
+                try:
+                    conn.execute(
+                        "INSERT OR IGNORE INTO free_endpoints"
+                        " (provider, category, url, health_path, docs, note,"
+                        "  source, last_checked)"
+                        " VALUES (?,?,?,?,?,?,?,?)",
+                        (ep["provider"], ep["category"], ep["url"], ep["url"],
+                         ep.get("docs", url), ep.get("note", ""), source_name,
+                         now_iso()))
+                    if conn.total_changes:
+                        valid_now += 1
+                except sqlite3.Error:
+                    continue
+            self._log_event(conn, "ingest", source_name, "—", len(found),
+                            f"redacted={redacted}")
+        self.update_learning(source_name, bool(found))
+        STATE.log("INFO", "API-NEXUS",
+                  f"Ingest '{source_name}' :: {len(found)} endpoint(s) parsed,"
+                  f" {redacted} secret-shaped strings redacted.")
+        return {"ok": True, "endpoints": len(found), "redacted": redacted,
+                "simulated": False}
+
+    def _simulated_ingest(self, source_name: str, url: str,
+                          reason: str) -> Dict[str, Any]:
+        n = self._rnd.randint(1, 4)
+        with self.lock, self._conn() as conn:
+            self._log_event(conn, "ingest-simulated", source_name, "—", n,
+                            f"reason={reason}")
+        self.update_learning(source_name, True)
+        STATE.log("WARN", "API-NEXUS",
+                  f"Ingest '{source_name}' unreachable ({reason}) — "
+                  f"simulated receipt of {n} endpoint record(s).")
+        return {"ok": True, "endpoints": n, "redacted": 0, "simulated": True,
+                "reason": reason}
+
+    @staticmethod
+    def _extract_endpoints(text: str, source_name: str) -> List[Dict[str, Any]]:
+        """Pull endpoint metadata out of OpenAPI specs or plain JSON lists."""
+        eps: List[Dict[str, Any]] = []
+        try:
+            doc = json.loads(text)
+        except (ValueError, TypeError):
+            # not JSON — fall back to raw URL harvesting (metadata only)
+            for u in re.findall(r"https?://[\w.-]+(?:/[\w./-]*)?", text)[:20]:
+                eps.append({"provider": source_name, "category": "misc",
+                            "url": u, "note": "raw-url"})
+            return eps
+
+        # OpenAPI 3.x
+        if isinstance(doc, dict) and isinstance(doc.get("servers"), list):
+            for srv in doc["servers"][:4]:
+                base = (srv.get("url") or "").rstrip("/")
+                if not base.startswith("http"):
+                    continue
+                eps.append({"provider": doc.get("info", {}).get("title", source_name)[:48],
+                            "category": "misc", "url": base,
+                            "note": "openapi-server"})
+                for path in list((doc.get("paths") or {}).keys())[:8]:
+                    eps.append({"provider": doc.get("info", {}).get("title", source_name)[:48],
+                                "category": "misc", "url": base + path,
+                                "note": "openapi-path"})
+
+        # plain JSON array of endpoint dicts
+        items = doc if isinstance(doc, list) else (doc.get("apis") or doc.get("endpoints") or [])
+        if isinstance(items, list):
+            for item in items[:50]:
+                if not isinstance(item, dict):
+                    continue
+                u = item.get("url") or item.get("link") or item.get("api") or ""
+                if isinstance(u, str) and u.startswith("http"):
+                    eps.append({
+                        "provider": str(item.get("provider") or item.get("name")
+                                        or source_name)[:48],
+                        "category": str(item.get("category") or "misc").lower()[:24],
+                        "url": u, "docs": item.get("docs", ""),
+                        "note": "json-directory"})
+        return eps
+
+    # ------------------------------------------------- defensive leak scanner
+    def scan_local_tree(self, path: str, max_files: int = 400) -> Dict[str, Any]:
+        """Scan the OPERATOR'S OWN tree for accidentally committed secrets.
+
+        Findings are reported for revocation with a masked fingerprint only —
+        the secret value itself is never persisted or returned.
+        """
+        root = os.path.expanduser(path or "")
+        if not os.path.isdir(root):
+            return {"ok": False, "error": "not a directory"}
+        findings: List[Dict[str, str]] = []
+        scanned = 0
+        for dirpath, dirnames, filenames in os.walk(root):
+            dirnames[:] = [d for d in dirnames
+                           if d not in {".git", "node_modules", ".venv", "__pycache__"}]
+            for fname in filenames:
+                if scanned >= max_files:
+                    break
+                ext = fname.rsplit(".", 1)[-1].lower() if "." in fname else ""
+                if ext not in SCAN_EXTENSIONS and fname not in (".env", ".envrc"):
+                    continue
+                fpath = os.path.join(dirpath, fname)
+                try:
+                    if os.path.getsize(fpath) > 512_000:
+                        continue
+                    with open(fpath, "r", errors="replace") as fh:
+                        content = fh.read()
+                except OSError:
+                    continue
+                scanned += 1
+                for provider, pattern in KEY_SIGNATURES.items():
+                    for hit in pattern.findall(content):
+                        findings.append({
+                            "file": os.path.relpath(fpath, root),
+                            "provider": provider,
+                            "fingerprint": mask_secret(hit),
+                        })
+        with self.lock, self._conn() as conn:
+            for f in findings[:50]:
+                conn.execute("INSERT INTO leak_findings (ts, file, provider, fingerprint)"
+                             " VALUES (?,?,?,?)",
+                             (now_iso(), f["file"], f["provider"], f["fingerprint"]))
+            self._log_event(conn, "leak-scan", "local-tree", "—", len(findings),
+                            f"scanned={scanned} root={root}")
+        if findings:
+            STATE.log("WARN", "API-NEXUS",
+                      f"Leak scan :: {len(findings)} secret(s) detected in YOUR tree"
+                      f" — rotate/revoke them now (values were NOT stored).")
+        return {"ok": True, "scanned_files": scanned, "findings": findings}
+
+    # -------------------------------------------------------- RPC for the swarm
+    def request_asset(self, category: str, provider: str = "",
+                      agent: str = "—") -> Dict[str, Any]:
+        """Serve the swarm: best healthy free endpoint first, else rotate
+        among the operator's own keys.  Never raises on bad input."""
+        category = (category or "").strip().lower()
+        provider = (provider or "").strip().lower()
+        if not category or category not in CATEGORIES:
+            return {"ok": False, "error": f"unknown category '{category}'",
+                    "categories": CATEGORIES}
+
+        # 1. zero-cost pool: healthy free endpoint in category
+        pool = [e for e in self.endpoints(category, status="active")
+                if e["health_score"] >= 40 and (not provider or e["provider"] == provider)]
+        if pool:
+            best = max(pool, key=lambda e: e["health_score"])
+            with self.lock, self._conn() as conn:
+                self._log_event(conn, "rpc-free-endpoint", "swarm", best["provider"],
+                                1, f"agent={agent}")
+            return {"ok": True, "kind": "free_endpoint", "provider": best["provider"],
+                    "category": category, "url": best["url"],
+                    "health_score": best["health_score"], "agent": agent,
+                    "note": "keyless free tier — zero cost"}
+
+        # 2. operator-owned keys with rotation (round-robin via last_used)
+        with self.lock, self._conn() as conn:
+            row = conn.execute(
+                "SELECT * FROM api_vault WHERE category=? AND status='active'"
+                + (" AND provider=?" if provider else "")
+                + " ORDER BY (last_used IS NULL) DESC, last_used ASC LIMIT 1",
+                (category, provider) if provider else (category,)).fetchone()
+            if row:
+                conn.execute(
+                    "UPDATE api_vault SET rotations = rotations + 1, last_used=?"
+                    " WHERE id=?", (now_iso(), row["id"]))
+                self._log_event(conn, "rpc-key-rotated", "swarm", row["provider"],
+                                1, f"agent={agent} key#{row['id']}")
+                return {"ok": True, "kind": "own_key", "provider": row["provider"],
+                        "category": category, "key": self.reveal_key(row["id"]),
+                        "health_score": row["health_score"], "agent": agent,
+                        "note": "operator key (rotated)"}
+
+        # 3. fallback: any healthy free endpoint from another category
+        any_pool = [e for e in self.endpoints(status="active") if e["health_score"] >= 40]
+        if any_pool:
+            best = max(any_pool, key=lambda e: e["health_score"])
+            return {"ok": True, "kind": "free_endpoint", "provider": best["provider"],
+                    "category": best["category"], "url": best["url"],
+                    "health_score": best["health_score"], "agent": agent,
+                    "note": f"no asset in '{category}' — served nearest healthy pool"}
+        return {"ok": False, "error": f"no healthy asset available for '{category}'"}
+
+    # ------------------------------------------------------- health-check cycle
+    def run_health_cycle(self, live_network: Optional[bool] = None) -> Dict[str, Any]:
+        """One 120 s heartbeat pass: probe free endpoints, age out failures,
+        refresh the learning curve.  Operator keys get metadata/format checks
+        only (never auto-fired at paid endpoints)."""
+        checked = healthy = degraded = 0
+        net = _HAVE_REQUESTS if live_network is None else bool(live_network)
+
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT * FROM free_endpoints"
+                                " WHERE status != 'retired'").fetchall()
+        for ep in rows:
+            checked += 1
+            ok, latency = self._probe(ep, use_network=net)
+            with self.lock, self._conn() as conn:
+                if ok:
+                    healthy += 1
+                    conn.execute(
+                        "UPDATE free_endpoints SET status='active', failure_count=0,"
+                        " health_score=MIN(100, health_score + 10), latency_ms=?,"
+                        " last_checked=? WHERE id=?",
+                        (latency, now_iso(), ep["id"]))
+                else:
+                    fails = ep["failure_count"] + 1
+                    degraded += 1
+                    status = "degraded" if fails < 3 else "dead"
+                    conn.execute(
+                        "UPDATE free_endpoints SET failure_count=?,"
+                        " health_score=MAX(0, health_score - 25), status=?,"
+                        " last_checked=? WHERE id=?",
+                        (fails, status, now_iso(), ep["id"]))
+
+        # operator keys: format re-check + bookkeeping (no network calls)
+        with self.lock, self._conn() as conn:
+            keys = conn.execute("SELECT id, provider, api_key_enc, failure_count"
+                                " FROM api_vault WHERE status='active'").fetchall()
+            for k in keys:
+                try:
+                    raw = self.crypto.decrypt(k["api_key_enc"])
+                    pattern = KEY_SIGNATURES.get(k["provider"])
+                    good = bool(pattern.search(raw)) if pattern else len(raw) >= 8
+                except Exception:
+                    good = False
+                if good:
+                    conn.execute("UPDATE api_vault SET health_score=100,"
+                                 " failure_count=0, last_checked=? WHERE id=?",
+                                 (now_iso(), k["id"]))
+                else:
+                    conn.execute("UPDATE api_vault SET health_score=0,"
+                                 " status='invalid', last_checked=? WHERE id=?",
+                                 (now_iso(), k["id"]))
+
+        self.update_learning("heartbeat", healthy > 0)
+        self.worker_cycles += 1
+        self.last_cycle_ts = now_iso()
+        summary = (f"Cycle #{self.worker_cycles} :: {checked} endpoints probed →"
+                   f" {healthy} healthy / {degraded} degraded ·"
+                   f" {len(keys)} operator key(s) re-checked")
+        STATE.log("INFO", "API-NEXUS", summary)
+        return {"checked": checked, "healthy": healthy, "degraded": degraded,
+                "keys_checked": len(keys), "cycle": self.worker_cycles,
+                "network": net}
+
+    @staticmethod
+    def _probe(ep: Dict[str, Any], use_network: bool) -> tuple:
+        """Probe one endpoint.  Network errors fall back to a deterministic
+        simulated result so the engine stays fully usable offline."""
+        url = ep["health_path"] or ep["url"]
+        if use_network and _HAVE_REQUESTS:
+            t0 = time.time()
+            try:
+                r = requests.get(url, timeout=4,
+                                 headers={"User-Agent": "omnihack-api-nexus/2.3"})
+                return (r.status_code < 500, int((time.time() - t0) * 1000))
+            except Exception:
+                pass  # fall through to simulated probe
+        rnd = random.Random(hashlib.md5(url.encode()).hexdigest())
+        return (rnd.random() > 0.12, rnd.randint(40, 480))
+
+    # ------------------------------------------------------------- worker loop
+    def start_worker(self, interval: float = HEARTBEAT_S) -> str:
+        self.worker_running = True
+        self._stop.clear()
+        self._thread = threading.Thread(target=self._worker_loop, daemon=True,
+                                        name="api-nexus-heartbeat")
+        self._thread.start()
+        STATE.log("OK", "API-NEXUS",
+                  f"Health worker armed :: {int(interval)}s cycle "
+                  f"(synced to mission heartbeat).")
+        return f"🕸️ API-NEXUS health worker armed :: every {int(interval)}s."
+
+    def stop_worker(self) -> str:
+        self.worker_running = False
+        self._stop.set()
+        STATE.log("INFO", "API-NEXUS", "Health worker disarmed.")
+        return "⏹ API-NEXUS health worker disarmed."
+
+    def _worker_loop(self) -> None:
+        while not self._stop.wait(HEARTBEAT_S):
+            if STATE.halted or not self.worker_running:
+                continue
+            try:
+                self.run_health_cycle()
+            except Exception as exc:
+                STATE.log("WARN", "API-NEXUS", f"Heartbeat error :: {exc}")
+
+    # ------------------------------------------------------------- telemetry
+    def stats(self) -> Dict[str, Any]:
+        with self.lock, self._conn() as conn:
+            n_keys = conn.execute("SELECT COUNT(*) c FROM api_vault").fetchone()["c"]
+            n_active_keys = conn.execute("SELECT COUNT(*) c FROM api_vault"
+                                         " WHERE status='active'").fetchone()["c"]
+            n_ep = conn.execute("SELECT COUNT(*) c FROM free_endpoints").fetchone()["c"]
+            n_ep_ok = conn.execute("SELECT COUNT(*) c FROM free_endpoints"
+                                   " WHERE status='active'").fetchone()["c"]
+            n_leaks = conn.execute("SELECT COUNT(*) c FROM leak_findings").fetchone()["c"]
+            n_events = conn.execute("SELECT COUNT(*) c FROM harvest_log").fetchone()["c"]
+            ok_rate = conn.execute(
+                "SELECT AVG(valid_hits * 1.0 / MAX(total_hits,1)) a"
+                " FROM learning_metrics").fetchone()["a"]
+            avg_w = conn.execute("SELECT AVG(learning_weight) a"
+                                 " FROM learning_metrics").fetchone()["a"]
+        return {"vault_keys": n_keys, "active_keys": n_active_keys,
+                "free_endpoints": n_ep, "healthy_endpoints": n_ep_ok,
+                "leak_findings": n_leaks, "events": n_events,
+                "source_success_rate": round((ok_rate or 0) * 100, 1),
+                "avg_learning_weight": round((avg_w or 0), 3),
+                "worker_cycles": self.worker_cycles,
+                "last_cycle": self.last_cycle_ts or "—",
+                "worker_running": self.worker_running,
+                "vault_path": self.vault_path}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return (f"[API-NEXUS] keys {s['active_keys']}/{s['vault_keys']} active ·"
+                f" endpoints {s['healthy_endpoints']}/{s['free_endpoints']} healthy"
+                f" · src-success {s['source_success_rate']}% · cycles {s['worker_cycles']}")
+
+
+NEXUS = ApiNexus()
