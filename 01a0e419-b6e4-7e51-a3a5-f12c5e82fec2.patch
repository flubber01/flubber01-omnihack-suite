+"""external_tools — backend library mounts (reference mode).
+
+The ``awesome-llm-apps`` mount uses a hyphenated directory name (it mirrors
+the upstream repo path), which is not a valid Python package identifier.
+Load its RPC facade through :func:`awesome_llm_apps_rpc` instead of a plain
+``import``::
+
+    from external_tools import awesome_llm_apps_rpc
+    rpc = awesome_llm_apps_rpc()
+    rpc.StarterRPC.query("rag vector search")
+"""
+from __future__ import annotations
+
+import importlib.util
+import os
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_RPC_PATH = os.path.join(_HERE, "awesome-llm-apps", "rpc.py")
+_cache = None
+
+
+def awesome_llm_apps_rpc():
+    """Return the awesome-llm-apps RPC module (loaded once, then cached)."""
+    global _cache
+    if _cache is None:
+        spec = importlib.util.spec_from_file_location(
+            "external_tools.awesome_llm_apps.rpc", _RPC_PATH)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        _cache = mod
+    return _cache
