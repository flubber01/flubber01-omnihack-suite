@@ -0,0 +1,157 @@
+"""🐝 ZERO-COST SWARM :: lookup-grid visualisation (vita threads + hit rates)."""
+
+from __future__ import annotations
+
+import gradio as gr
+
+from ..core.c99_bridge import C99
+from ..core.lookup_swarm import LOOKUP_SWARM, PLATFORMS, INTENTS
+
+
+# ------------------------------------------------------------------ views
+def grid_md():
+    s = LOOKUP_SWARM.stats()
+    c99 = C99.stats()
+    build = "READY" if s["ready"] else ("BUILDING…" if s["building"] else "PENDING")
+    return (
+        f"**🐝 VITA GRID (offline-compressed)**\n\n"
+        f"- Personas indexed: **{s['indexed']:,} / {s['total']:,}** · state: {build}\n"
+        f"- Active vitas: **{s['active']}** · dialogue bank: {s['dialogue_bank']} patterns\n"
+        f"- Lookup hit-rate: **{s['hit_rate']}%** ({s['hits']} hits / {s['misses']} misses)"
+        f" · avg {s['avg_lookup_us']}µs\n\n"
+        f"**⚙️ C99 INFERENCE ENGINE**\n\n"
+        f"- Backend: **{c99['backend']}** · calls: {c99['calls']} · "
+        f"avg latency {c99['avg_latency_us']}µs\n"
+        f"- Live model calls served: **0** — 100% lookup + C99 routing"
+    )
+
+
+def thread_rows():
+    rows = [[t["thread_id"], t["persona_key"], t["platform"],
+             t["started"][-8:], str(t["turns"]), t["last_intent"] or "—",
+             t["state"]] for t in LOOKUP_SWARM.active_threads(16)]
+    return rows or [["—", "no open vita threads", "—", "—", "—", "—", "—"]]
+
+
+def stats_md():
+    return grid_md()
+
+
+# ---------------------------------------------------------------- actions
+def spawn_vita(niche):
+    res = LOOKUP_SWARM.spawn_vita(niche.strip() if niche else "")
+    if not res["ok"]:
+        return f"⚠️ {res['error']}", grid_md(), thread_rows()
+    return (f"🐝 Vita active :: **{res['persona_key']}** ({res['handle']}, "
+            f"{res['tone']}/{res['archetype']})", grid_md(), thread_rows())
+
+
+def open_thread(persona_key, platform):
+    if not (persona_key or "").strip():
+        return "⚠️ Paste a persona key first (spawn a vita).", thread_rows(), grid_md()
+    res = LOOKUP_SWARM.thread_open(persona_key.strip(), platform)
+    if not res["ok"]:
+        return f"⚠️ {res['error']}", thread_rows(), grid_md()
+    return (f"🧵 Thread `{res['thread_id']}` open on {platform}.",
+            thread_rows(), grid_md())
+
+
+def turn_thread(thread_id, intent):
+    res = LOOKUP_SWARM.thread_turn((thread_id or "").strip(), intent)
+    if not res["ok"]:
+        return f"⚠️ {res['error']}", "", thread_rows(), grid_md()
+    return (f"✅ Reply in {res['latency_us']}µs (0 model calls)",
+            f"**{res['reply']}**", thread_rows(), grid_md())
+
+
+def run_daemon(platform, n):
+    res = LOOKUP_SWARM.simulate_daemon_cycle(platform, int(n))
+    if not res["ok"]:
+        return f"⚠️ {res['error']}", grid_md(), thread_rows()
+    return (f"📡 {platform} daemon :: {res['answered']} organic replies served "
+            f"from lookup, {res['threads_opened']} thread(s) opened "
+            f"(0 model calls).", grid_md(), thread_rows())
+
+
+def heartbeat_now():
+    hb = LOOKUP_SWARM.run_heartbeat()
+    return (f"💓 Heartbeat :: hit-rate {hb['hit_rate']}% · "
+            f"C99 {hb['c99_backend']} ({hb['c99_calls']} calls) logged to DBAL.",
+            grid_md())
+
+
+def auto_refresh():
+    return grid_md(), thread_rows()
+
+
+# ----------------------------------------------------------------- render
+def render() -> dict:
+    with gr.Row():
+        gr.Markdown("## 🐝 ZERO-COST SWARM\n"
+                    "<span class='cyber-sub'>OFFLINE-COMPRESSED VITA GRID · "
+                    "0 LIVE MODEL CALLS · C99 LIGHTWEIGHT INFERENCE</span>")
+
+    with gr.Row():
+        # ---------------------------------------------------------- control
+        with gr.Column(scale=4):
+            panel = gr.Markdown(grid_md, elem_classes="cyber-panel")
+            gr.Markdown("#### 🐝 SPAWN VITA")
+            with gr.Row():
