+"""⏰ DAEMON RUNNER :: always-on background agents (zero main-thread cost).
+
+Deploys scheduled/event-driven daemons that run asynchronously behind the
+scenes and synchronise every log line + artifact into the central DBAL via
+the 120 s heartbeat:
+
+* **telemetry-watchdog** — periodic VPS/swarm telemetry snapshots + anomaly
+  flags (CPU/RAM drift, halted-state watch).
+* **release-radar** — deterministic pseudo-feed of upstream releases the
+  swarm should know about (simulated egress; no network required).
+* **vault-integrity** — verifies the local DBAL vaults are intact and
+  writable; flags corruption early.
+
+All output lands in ``~/.omnihack/vault/daemons.db`` (tables ``daemon_log``
+and ``daemon_artifacts``) and is mirrored to the central telemetry bus.
+Backend only — the frontend layout is never touched.
+"""
+
+from __future__ import annotations
+
+import os
+import random
+import sqlite3
+import threading
+from typing import Any, Callable, Dict, List, Optional
+
+from .state import STATE, now_iso
+
+DAEMON_DB = os.environ.get(
+    "OMNI_DAEMON_DB", os.path.expanduser("~/.omnihack/vault/daemons.db"))
+SYNC_S = 120  # central heartbeat sync period
+
+
+class _Daemon:
+    def __init__(self, name: str, interval: int, fn: Callable[[], Dict[str, Any]],
+                 desc: str) -> None:
+        self.name = name
+        self.interval = max(15, int(interval))
+        self.fn = fn
+        self.desc = desc
+        self.ticks = 0
+        self.last_result: Dict[str, Any] = {}
+
+
+class DaemonRunner:
+    """Single scheduler thread driving N registered daemons."""
+
+    def __init__(self, db_path: Optional[str] = None) -> None:
+        self.db_path = db_path or DAEMON_DB
+        self.lock = threading.RLock()
+        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
+        self._daemons: Dict[str, _Daemon] = {}
+        self._pending: List[Dict[str, Any]] = []   # flush on heartbeat sync
+        self._pending_artifacts: List[Dict[str, Any]] = []
+        self.running = False
+        self.sync_cycles = 0
+        self.last_sync_ts = ""
+        self._tick = 0
+        self._stop = threading.Event()
+        self._thread: Optional[threading.Thread] = None
+        self._rnd = random.Random(1200)
+        self._init_db()
+        self._register_builtin()
+
+    # ------------------------------------------------------------------ db
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.db_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS daemon_log (
+                ts TEXT, daemon TEXT, level TEXT, message TEXT);
+            CREATE TABLE IF NOT EXISTS daemon_artifacts (
+                ts TEXT, daemon TEXT, kind TEXT, payload TEXT);
+            CREATE TABLE IF NOT EXISTS sync_log (
+                ts TEXT, cycle INTEGER, flushed INTEGER, artifacts INTEGER);
+            """)
+
+    def _log(self, daemon: str, level: str, message: str) -> None:
+        entry = {"ts": now_iso(), "daemon": daemon, "level": level,
+                 "message": message}
+        with self.lock:
+            self._pending.append(entry)
+        STATE.log(level if level in ("INFO", "OK", "WARN", "CRIT") else "INFO",
+                  daemon.upper(), message)
+
+    def _artifact(self, daemon: str, kind: str, payload: Dict[str, Any]) -> None:
+        with self.lock:
+            self._pending_artifacts.append({"ts": now_iso(), "daemon": daemon,
+                                            "kind": kind, "payload": payload})
+
+    # -------------------------------------------------------- built-in daemons
+    def _register_builtin(self) -> None:
+        self.register("telemetry-watchdog", 30, self._watchdog_tick,
+                      "VPS/swarm telemetry snapshots + anomaly flags")
+        self.register("release-radar", 60, self._radar_tick,
+                      "upstream release pseudo-feed (simulated egress)")
+        self.register("vault-integrity", 90, self._integrity_tick,
+                      "DBAL vault integrity verification")
+        self.register("lookup-swarm-keeper", 120, self._keeper_tick,
+                      "0-cost vita grid heartbeat (hit-rate + C99 log)")
+        self.register("forecast-quantum-watch", 120, self._fq_tick,
+                      "TimesFM forecasts + quantum anomaly pipeline")
+        self.register("compute-commander-watch", 120, self._cc_tick,
+                      "remote pool telemetry → central DBAL (120s)")
+        self.register("stream-bridge-guard", 120, self._stream_tick,
+                      "multi-stream FPS guard + telemetry (120s)")
+        self.register("dbal-heartbeat-sync", 120, self._hb_tick,
+                      "DBAL 120 s sync heartbeat worker watchdog")
+
+    def _hb_tick(self) -> Dict[str, Any]:
+        from .sync_heartbeat import HEARTBEAT
+        st = HEARTBEAT.status()
+        if not st["running"]:
+            HEARTBEAT.start()
+            st = HEARTBEAT.status()
+        self._log("dbal-heartbeat-sync", "INFO",
+                  f"worker running={st['running']} · beats {st['beats']} · "
+                  f"ring {st['ring']['fill']}/{st['ring']['size']}")
+        self._artifact("dbal-heartbeat-sync", "status", st)
+        return st
+
+    def _stream_tick(self) -> Dict[str, Any]:
+        from .stream_bridge import BRIDGE
+        cyc = BRIDGE.throttle_cycle()
+        s = BRIDGE.stats()
+        self._log("stream-bridge-guard", "INFO",
+                  f"{s['sessions']} sessions · {s['total_fps']}/{s['fps_budget']} fps"
+                  f" · focus {s['focused'] or '—'} · {s['kb_streamed']} KiB")
+        self._artifact("stream-bridge-guard", "throttle-cycle", cyc)
+        return cyc
+
+    def _cc_tick(self) -> Dict[str, Any]:
+        from .compute_commander import COMMANDER
+        cyc = COMMANDER.telemetry_cycle()
+        s = COMMANDER.stats()
+        self._log("compute-commander-watch", "INFO",
+                  f"{cyc['nodes']} nodes · {cyc['total_w']}W draw · "
+                  f"offloads {s['offloaded']} · local {s['local_kept']}")
+        self._artifact("compute-commander-watch", "telemetry", cyc)
+        return cyc
+
+    def _fq_tick(self) -> Dict[str, Any]:
+        from .timesfm import TIMESFM
+        from .quantum_agents import QUANTUM
+        hw_fc = TIMESFM.forecast_hardware("cpu", horizon=4)
+        advice = TIMESFM.renderfarm_advice()
+        scan = QUANTUM.run_pipeline()
+        summary = {
+            "hw_next": hw_fc["points"][0], "hw_p90": hw_fc["p90"][0],
+            "render_action": advice["action"],
+            "hw_verdict": scan["hardware"]["verdict"],
+            "traffic_verdict": scan["traffic"]["verdict"],
+        }
+        level = "CRIT" if "ANOMALY" in (summary["hw_verdict"],
+                                        summary["traffic_verdict"]) else "INFO"
+        self._log("forecast-quantum-watch", level,
+                  f"hw→{summary['hw_next']} (p90 {summary['hw_p90']}) · "
+                  f"render: {summary['render_action']} · "
+                  f"verdicts hw={summary['hw_verdict']} "
+                  f"traffic={summary['traffic_verdict']}")
+        self._artifact("forecast-quantum-watch", "forecast-quantum", summary)
+        return summary
+
+    def _keeper_tick(self) -> Dict[str, Any]:
+        from .lookup_swarm import LOOKUP_SWARM
+        hb = LOOKUP_SWARM.keeper_tick()
+        self._log("lookup-swarm-keeper", "INFO",
+                  f"hit-rate {hb['hit_rate']}% · {hb['hits']} hits · "
+                  f"c99 {hb['c99_backend']} ({hb['c99_calls']} calls)")
+        self._artifact("lookup-swarm-keeper", "heartbeat", hb)
+        return hb
+
+    def _watchdog_tick(self) -> Dict[str, Any]:
+        m = STATE.metrics()
+        anomalies = []
+        if m["cpu"] > 85:
+            anomalies.append(f"cpu {m['cpu']:.0f}%")
+        if m["ram_pct"] > 88:
+            anomalies.append(f"ram {m['ram_pct']:.0f}%")
+        if m["halted"]:
+            anomalies.append("swarm HALTED")
+        level = "WARN" if anomalies else "INFO"
+        self._log("telemetry-watchdog", level,
+                  f"cpu {m['cpu']:.0f}% · ram {m['ram_pct']:.0f}% · "
+                  f"agents {m['commanders_active'] + m['minions_active']} · "
+                  + ("anomalies: " + ", ".join(anomalies) if anomalies else "nominal"))
+        snap = {"cpu": round(m["cpu"], 1), "ram": round(m["ram_pct"], 1),
+                "halted": m["halted"], "anomalies": anomalies}
+        self._artifact("telemetry-watchdog", "telemetry-snapshot", snap)
+        return snap
+
+    def _radar_tick(self) -> Dict[str, Any]:
+        feed = [
+            ("ollama/ollama", "v0.9.4", "runtime"),
+            ("langchain-ai/langgraph", "0.4.21", "framework"),
+            ("browser-use/browser-use", "0.3.9", "browser"),
+            ("ggerganov/llama.cpp", "b5117", "inference"),
+            ("vllm-project/vllm", "0.8.5", "inference"),
+        ]
+        repo, ver, kind = self._rnd.choice(feed)
+        self._log("release-radar", "INFO",
+                  f"radar ping :: {repo} {ver} ({kind}) — review for adoption")
+        rel = {"repo": repo, "version": ver, "kind": kind,
+               "action": "queued-for-review"}
+        self._artifact("release-radar", "release", rel)
+        return rel
+
+    def _integrity_tick(self) -> Dict[str, Any]:
+        vault_root = os.path.expanduser("~/.omnihack/vault")
+        issues: List[str] = []
+        checked = 0
+        if os.path.isdir(vault_root):
+            for fname in os.listdir(vault_root):
+                if not fname.endswith(".db"):
+                    continue
+                checked += 1
+                fpath = os.path.join(vault_root, fname)
+                try:
+                    conn = sqlite3.connect(fpath, timeout=3)
+                    ok = conn.execute("PRAGMA integrity_check").fetchone()[0]
+                    conn.close()
+                    if ok != "ok":
+                        issues.append(f"{fname}: {ok}")
+                except Exception as exc:
+                    issues.append(f"{fname}: {exc}")
+        level = "WARN" if issues else "OK"
+        self._log("vault-integrity", level,
+                  f"{checked} vault db(s) checked"
+                  + (f" — issues: {'; '.join(issues)}" if issues else " — all intact"))
+        rep = {"checked": checked, "issues": issues}
+        self._artifact("vault-integrity", "integrity-report", rep)
+        return rep
+
+    # ------------------------------------------------------------- registry
+    def register(self, name: str, interval: int, fn: Callable[[], Dict[str, Any]],
+                 desc: str = "") -> str:
+        self._daemons[name] = _Daemon(name, interval, fn, desc)
+        return f"⏰ Daemon '{name}' registered :: every {max(15, int(interval))}s."
+
+    def trigger(self, name: str) -> Dict[str, Any]:
+        """Event-driven manual trigger (runs inline, still daemon-logged)."""
+        d = self._daemons.get(name)
+        if not d:
+            return {"ok": False, "error": f"unknown daemon '{name}'",
+                    "daemons": sorted(self._daemons)}
+        return self._run_daemon(d)
+
+    def _run_daemon(self, d: _Daemon) -> Dict[str, Any]:
+        try:
+            result = d.fn()
+            d.ticks += 1
+            d.last_result = {"ok": True, "result": result}
+        except Exception as exc:
+            d.last_result = {"ok": False, "error": str(exc)}
+            self._log(d.name, "WARN", f"tick error :: {exc}")
+        return d.last_result
+
+    # ------------------------------------------------------------ lifecycle
+    def start(self) -> str:
+        if self.running:
+            return "⏰ Daemon runner already running."
+        self.running = True
+        self._stop.clear()
+        self._thread = threading.Thread(target=self._loop, daemon=True,
+                                        name="omni-daemons")
+        self._thread.start()
+        STATE.log("OK", "DAEMONS",
+                  f"Daemon runner armed :: {len(self._daemons)} always-on agents, "
+                  f"heartbeat sync every {SYNC_S}s.")
+        return f"⏰ Daemon runner armed :: {len(self._daemons)} daemons."
+
+    def stop(self) -> str:
+        self.running = False
+        self._stop.set()
+        STATE.log("INFO", "DAEMONS", "Daemon runner stopped.")
+        return "⏹ Daemon runner stopped."
+
+    def _loop(self) -> None:
+        while not self._stop.wait(5):
+            if STATE.halted or not self.running:
+                continue
+            self._tick += 5
+            for d in self._daemons.values():
+                if self._tick % d.interval == 0:
+                    self._run_daemon(d)
+            if self._tick % SYNC_S == 0:
+                try:
+                    self.run_sync()
+                except Exception as exc:
+                    STATE.log("WARN", "DAEMONS", f"Sync error :: {exc}")
+
+    # ---------------------------------------------------- 120 s heartbeat sync
+    def run_sync(self) -> Dict[str, Any]:
+        """Flush all pending daemon logs + artifacts into the central DBAL."""
+        with self.lock:
+            logs, self._pending = self._pending, []
+            arts, self._pending_artifacts = self._pending_artifacts, []
+        with self.lock, self._conn() as conn:
+            conn.executemany(
+                "INSERT INTO daemon_log (ts, daemon, level, message)"
+                " VALUES (?,?,?,?)",
+                [(e["ts"], e["daemon"], e["level"], e["message"]) for e in logs])
+            conn.executemany(
+                "INSERT INTO daemon_artifacts (ts, daemon, kind, payload)"
+                " VALUES (?,?,?,?)",
+                [(a["ts"], a["daemon"], a["kind"], str(a["payload"])) for a in arts])
+            self.sync_cycles += 1
+            self.last_sync_ts = now_iso()
+            conn.execute("INSERT INTO sync_log (ts, cycle, flushed, artifacts)"
+                         " VALUES (?,?,?,?)",
+                         (now_iso(), self.sync_cycles, len(logs), len(arts)))
+        return {"cycle": self.sync_cycles, "flushed_logs": len(logs),
+                "flushed_artifacts": len(arts)}
+
+    # ------------------------------------------------------------ reporting
+    def overview(self) -> List[Dict[str, Any]]:
+        return [{"name": d.name, "desc": d.desc, "interval_s": d.interval,
+                 "ticks": d.ticks, "last_ok": d.last_result.get("ok", None)}
+                for d in self._daemons.values()]
+
+    def recent_logs(self, n: int = 20) -> List[Dict[str, Any]]:
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT * FROM daemon_log ORDER BY ts DESC"
+                                " LIMIT ?", (n,)).fetchall()
+        return [dict(r) for r in rows]
+
+    def stats(self) -> Dict[str, Any]:
+        with self.lock, self._conn() as conn:
+            n_log = conn.execute("SELECT COUNT(*) c FROM daemon_log").fetchone()["c"]
+            n_art = conn.execute("SELECT COUNT(*) c FROM daemon_artifacts").fetchone()["c"]
+        return {"daemons": len(self._daemons), "running": self.running,
+                "db_logs": n_log, "db_artifacts": n_art,
+                "pending": len(self._pending),
+                "sync_cycles": self.sync_cycles, "last_sync": self.last_sync_ts or "—",
+                "db_path": self.db_path}
+
+
+DAEMONS = DaemonRunner()
