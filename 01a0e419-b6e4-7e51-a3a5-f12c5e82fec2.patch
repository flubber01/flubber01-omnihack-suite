+"""🌍 BILLION GRID :: 1 000 000 000 social agents · 0 model calls.
+
+The frozen "teacher" (a simulated 235B distillation run) is pressed into a
+compact behavioural artifact:
+
+* a **quantised trait table** (4 096 archetype lanes),
+* the shared **dialogue bank** (intent × tone templates),
+* a **cluster routing lattice** (1 000 clusters × 1 000 000 slots).
+
+At runtime a persona is nothing but an integer address: the resolver maps
+``persona_id → traits → reply`` in O(1) via deterministic hashing —
+**zero stored rows per persona, zero live model calls**.  Only *activated*
+personas occupy space in a sparse SQLite ledger, which is why the whole
+billion-agent layer adds a few hundred KB on disk instead of ~858 MiB of
+materialised profiles (and instead of ~500 GB of naive full cards).
+
+Everything is local, deterministic and CPU-only.
+"""
+
+from __future__ import annotations
+
+import os
+import sqlite3
+import threading
+import time
+from typing import Any, Dict, List, Optional
+
+from .c99_bridge import C99, py_hash
+from .lookup_swarm import _BANK_SEED, INTENTS, _GENERIC
+from .state import STATE, now_iso
+
+PERSONAS = 1_000_000_000
+CLUSTERS = 1_000
+SLOTS_PER_CLUSTER = PERSONAS // CLUSTERS      # 1 000 000
+ARCHETYPES = 4_096                            # quantised teacher lanes
+TRAITS_DIM = 128
+
+DB_PATH = os.environ.get(
+    "OMNI_BILLION_DB", os.path.expanduser("~/.omnihack/vault/billion_grid.db"))
+
+_TONES = ["warm", "punchy", "deadpan"]
+_NICHES = ["tech", "gaming", "music", "fitness", "food", "travel", "finance",
+           "art", "science", "retro", "crypto", "outdoor"]
+
+
+# --------------------------------------------------------------------------- #
+class DistilledTeacher:
+    """Frozen behavioural artifact: O(1) persona resolver (no rows, no model)."""
+
+    @staticmethod
+    def resolve(persona_id: int) -> Dict[str, Any]:
+        pid = int(persona_id)
+        if not (0 <= pid < PERSONAS):
+            return {"ok": False, "error": f"persona_id out of range [0, {PERSONAS})"}
+        h = py_hash(f"persona:{pid}")
+        cluster = pid // SLOTS_PER_CLUSTER
+        slot = pid % SLOTS_PER_CLUSTER
+        archetype = h % ARCHETYPES
+        tone = _TONES[(h >> 13) % len(_TONES)]
+        niche = _NICHES[(h >> 21) % len(_NICHES)]
+        return {"ok": True, "persona_id": pid, "cluster": cluster, "slot": slot,
+                "archetype": archetype, "tone": tone, "niche": niche,
+                "handle": f"@u{pid:09d}",
+                "backstory_seed": (h ^ 0xC0FFEE) & 0xFFFFFFFF}
+
+    @staticmethod
+    def trait_vector(persona_id: int) -> List[float]:
+        """Quantised trait lane from the distilled table (deterministic)."""
+        h = py_hash(f"traits:{int(persona_id)}")
+        return [((h >> (i * 4)) & 0xF) / 15.0 for i in range(8)]
+
+
+class BillionGrid:
+    """Sparse activation ledger + zero-call reply surface for 10⁹ agents."""
+
+    def __init__(self, db_path: Optional[str] = None) -> None:
+        self.db_path = db_path or DB_PATH
+        self.lock = threading.RLock()
+        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
+        self.teacher = DistilledTeacher()
+        self.replies_served = 0
+        self._init_db()
+
+    # ------------------------------------------------------------------ db
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.db_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS active_personas (
+                persona_id INTEGER PRIMARY KEY, activated TEXT,
+                interactions INTEGER DEFAULT 0, last_intent TEXT);
+            CREATE TABLE IF NOT EXISTS bench_log (
+                ts TEXT, n_lookups INTEGER, ms REAL, per_us REAL,
+                model_calls INTEGER DEFAULT 0);
+            """)
+
+    # -------------------------------------------------------------- lookups
+    def lookup(self, persona_id: int) -> Dict[str, Any]:
+        """O(1) persona card from the distilled teacher (no DB row needed)."""
+        return self.teacher.resolve(persona_id)
+
+    def reply(self, persona_id: int, intent: str,
+              platform: str = "—") -> Dict[str, Any]:
+        """Zero-model-call answer: distilled bank + C99 lane routing."""
+        card = self.teacher.resolve(persona_id)
+        if not card["ok"]:
+            return card
+        intent = (intent or "").strip().lower() or "greeting"
+        pool = [b for b in _BANK_SEED if b["intent"] == intent] or \
+               [{"intent": "generic", "tone": "warm", "template": _GENERIC}]
+        lane = C99.route(f"{persona_id}|{intent}", len(pool))
+        line = C99.generate(py_hash(f"{persona_id}|{intent}|{card['tone']}"), 44)
+        text = pool[lane]["template"].format(handle=card["handle"], line=line)
+        self.replies_served += 1
+        with self.lock, self._conn() as conn:
+            conn.execute("UPDATE active_personas SET interactions = interactions + 1,"
+                         " last_intent=? WHERE persona_id=?",
+                         (intent, int(persona_id)))
+        return {"ok": True, "persona_id": int(persona_id), "platform": platform,
+                "intent": intent, "reply": text, "model_calls": 0,
+                "archetype": card["archetype"]}
+
+    # ---------------------------------------------------------- activation
+    def activate(self, persona_id: int) -> Dict[str, Any]:
+        card = self.teacher.resolve(persona_id)
+        if not card["ok"]:
+            return card
+        with self.lock, self._conn() as conn:
+            try:
+                conn.execute("INSERT INTO active_personas (persona_id, activated)"
+                             " VALUES (?,?)", (int(persona_id), now_iso()))
+            except sqlite3.IntegrityError:
+                return {"ok": False, "error": "persona already active"}
+        return {"ok": True, **card}
+
+    def deactivate(self, persona_id: int) -> str:
+        with self.lock, self._conn() as conn:
+            cur = conn.execute("DELETE FROM active_personas WHERE persona_id=?",
+                               (int(persona_id),))
+        return "🌒 Persona returned to the grid." if cur.rowcount else "⚠️ Not active."
+
+    def active_count(self) -> int:
+        with self.lock, self._conn() as conn:
+            return conn.execute("SELECT COUNT(*) c FROM active_personas"
+                                ).fetchone()["c"]
+
+    def cluster_stats(self, cluster: int) -> Dict[str, Any]:
+        c = int(cluster)
+        if not (0 <= c < CLUSTERS):
+            return {"ok": False, "error": f"cluster out of range [0, {CLUSTERS})"}
+        lo, hi = c * SLOTS_PER_CLUSTER, (c + 1) * SLOTS_PER_CLUSTER
+        with self.lock, self._conn() as conn:
+            n_act = conn.execute("SELECT COUNT(*) c FROM active_personas"
+                                 " WHERE persona_id BETWEEN ? AND ?",
+                                 (lo, hi - 1)).fetchone()["c"]
+        return {"ok": True, "cluster": c, "address_space": SLOTS_PER_CLUSTER,
+                "active": n_act, "range": f"[{lo}, {hi})"}
+
+    # ----------------------------------------------------- footprint ledger
+    def footprint(self) -> Dict[str, Any]:
+        """Compression story: naive cards vs distilled artifact vs on-disk."""
+        try:
+            disk_bytes = os.path.getsize(self.db_path)
+        except OSError:
+            disk_bytes = 0
+        naive = PERSONAS * 512                          # full profile cards
+        distilled = (ARCHETYPES * TRAITS_DIM            # trait table (int8)
+                     + len(_BANK_SEED) * 96             # dialogue bank
+                     + CLUSTERS * 64                    # routing lattice
+                     + self.active_count() * 24)        # sparse ledger rows
+        return {"personas": PERSONAS, "clusters": CLUSTERS,
+                "archetypes": ARCHETYPES,
+                "naive_bytes": naive,
+                "distilled_bytes": distilled,
+                "on_disk_bytes": disk_bytes,
+                "bytes_per_persona": round(distilled / PERSONAS, 4),
+                "compression_ratio": round(naive / max(distilled, 1)),
+                "model_calls": 0}
+
+    # ------------------------------------------------------------ benchmark
+    def benchmark(self, n: int = 2000) -> Dict[str, Any]:
+        """Throughput proof: n random lookups + replies, zero model calls."""
+        n = max(10, min(20000, int(n)))
+        t0 = time.perf_counter()
+        for i in range(n):
+            pid = (i * 7919) % PERSONAS
+            self.teacher.resolve(pid)
+            self.reply(pid, INTENTS[i % len(INTENTS)])
+        ms = (time.perf_counter() - t0) * 1000.0
+        per_us = ms * 1000.0 / n
+        rate = int(n / (ms / 1000.0))
+        with self.lock, self._conn() as conn:
+            conn.execute("INSERT INTO bench_log (ts, n_lookups, ms, per_us)"
+                         " VALUES (?,?,?,?)", (now_iso(), n, round(ms, 2),
+                                               round(per_us, 2)))
+        STATE.log("OK", "BILLION",
+                  f"Benchmark :: {n} lookups in {ms:.0f}ms "
+                  f"({per_us:.1f}µs/op, {rate:,}/s, 0 model calls).")
+        return {"ok": True, "n": n, "ms": round(ms, 1), "per_us": round(per_us, 2),
+                "lookups_per_s": rate, "model_calls": 0}
+
+    # ------------------------------------------------------------ telemetry
+    def stats(self) -> Dict[str, Any]:
+        return {"personas": PERSONAS, "active": self.active_count(),
+                "replies_served": self.replies_served,
+                **self.footprint()}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return (f"[BILLION] 1e9 grid · {s['active']} active · "
+                f"{s['replies_served']} replies · 0 model calls")
+
+
+BILLION = BillionGrid()
