+
+# --------------------------------------------------------------------------- #
+# MCP tool gateway + backend templates (mcp_ai_agents / agent_skills /
+# always_on_agents) + GitHub repo templates.  Metadata only — deep-linked by
+# tags, never cloned or executed.
+# --------------------------------------------------------------------------- #
+MCP_TOOLS: List[Dict[str, Any]] = [
+    {"id": "mcp.filesystem", "tags": {"file", "read", "write", "archive"}, "kind": "tool"},
+    {"id": "mcp.git", "tags": {"git", "merge", "diff", "deploy"}, "kind": "tool"},
+    {"id": "mcp.http", "tags": {"fetch", "api", "crawl", "download"}, "kind": "tool"},
+    {"id": "mcp.browser", "tags": {"browser", "scrape", "render", "caption"}, "kind": "tool"},
+    {"id": "mcp.shell", "tags": {"shell", "ssh", "deploy", "patch"}, "kind": "tool"},
+    {"id": "mcp.memory", "tags": {"memory", "store", "recall", "rag"}, "kind": "tool"},
+    {"id": "mcp.sql", "tags": {"sql", "db", "query", "schema"}, "kind": "tool"},
+    {"id": "mcp.vector", "tags": {"vector", "embedding", "search", "rank"}, "kind": "tool"},
+    {"id": "mcp.scheduler", "tags": {"cron", "schedule", "queue", "trigger"}, "kind": "tool"},
+    {"id": "mcp.notify", "tags": {"notify", "email", "sms", "broadcast"}, "kind": "tool"},
+    {"id": "mcp.redact", "tags": {"redact", "mask", "privacy", "anonymize"}, "kind": "tool"},
+    {"id": "mcp.eval", "tags": {"eval", "test", "benchmark", "verify"}, "kind": "tool"},
+]
+
+BACKEND_TEMPLATES: Dict[str, List[Dict[str, Any]]] = {
+    "mcp_ai_agents": [
+        {"id": "tmpl.agent.researcher", "tags": {"agent", "search", "summarize", "rag"}},
+        {"id": "tmpl.agent.operator", "tags": {"agent", "browser", "shell", "deploy"}},
+        {"id": "tmpl.agent.critic", "tags": {"agent", "eval", "verify", "review"}},
+    ],
+    "agent_skills": [
+        {"id": "tmpl.skill.planner", "tags": {"planner", "orchestrator", "prioritize"}},
+        {"id": "tmpl.skill.fuser", "tags": {"fuse", "merge", "compose"}},
+        {"id": "tmpl.skill.validator", "tags": {"validate", "verify", "test"}},
+    ],
+    "always_on_agents": [
+        {"id": "tmpl.daemon.heartbeat", "tags": {"monitor", "metric", "trace", "log"}},
+        {"id": "tmpl.daemon.indexer", "tags": {"index", "catalog", "sync", "shard"}},
+        {"id": "tmpl.daemon.memory", "tags": {"memory", "consolidate", "checkpoint"}},
+    ],
+}
+
+REPO_TEMPLATES: List[Dict[str, Any]] = [
+    {"id": "repo.awesome-llm-apps", "url": "https://github.com/Shubhamsaboo/awesome-llm-apps",
+     "tags": {"llm", "rag", "agent", "starter"}},
+    {"id": "repo.langgraph-multi-agent", "url": "https://github.com/langchain-ai/langgraph",
+     "tags": {"agent", "orchestrator", "graph", "workflow"}},
+    {"id": "repo.autogen", "url": "https://github.com/microsoft/autogen",
+     "tags": {"agent", "chat", "multi", "fuse"}},
+    {"id": "repo.crewai", "url": "https://github.com/crewAIInc/crewAI",
+     "tags": {"agent", "crew", "planner", "delegate"}},
+    {"id": "repo.browser-use", "url": "https://github.com/browser-use/browser-use",
+     "tags": {"browser", "scrape", "render", "caption"}},
+    {"id": "repo.llama-index", "url": "https://github.com/run-llama/llama_index",
+     "tags": {"rag", "index", "embedding", "vector"}},
+    {"id": "repo.phidata", "url": "https://github.com/phidatahq/phidata",
+     "tags": {"agent", "tool", "memory", "api"}},
+    {"id": "repo.dspy", "url": "https://github.com/stanfordnlp/dspy",
+     "tags": {"prompt", "optimize", "tune", "eval"}},
+]
+
+
+# --------------------------------------------------------------------------- #
+class CrossRefEngine:
+    """Semantic yellow-pages + DBAL hub + evolution loop + sync daemon."""
+
+    def __init__(self, hub_path: Optional[str] = None,
+                 skills_dir: Optional[str] = None) -> None:
+        self.hub_path = hub_path or HUB_DB_PATH
+        self.skills_dir = skills_dir or CUSTOM_SKILLS_DIR
+        self.lock = threading.RLock()
+
+        os.makedirs(os.path.dirname(self.hub_path), exist_ok=True)
+        os.makedirs(self.skills_dir, exist_ok=True)
+
+        # tiny in-memory yellow pages: category -> token set (204 entries)
+        self._pages: Dict[str, set] = {c: _tokenize(c.replace("-", " "))
+                                       for c in CATEGORIES}
+
+        # hub build state (lazy + background to keep startup zero-bloat)
+        self._hub_ready = False
+        self._building = False
+        self._build_thread: Optional[threading.Thread] = None
+
+        # cross-reference runtime counters
+        self.xref_count = 0
+        self.evolved_count = 0
+        self.materialized_count = 0
+        self._pending_flush: List[Dict[str, Any]] = []
+
+        # sync daemon
+        self.sync_running = False
+        self.sync_cycles = 0
+        self.last_sync_ts = ""
+        self._stop = threading.Event()
+        self._sync_thread: Optional[threading.Thread] = None
+        self._rnd = random.Random(4242)
+
+        self._init_db()
+        self.load_custom_skills()
+
+    # ------------------------------------------------------------------ DBAL
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.hub_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS hub_catalog (
+                ref_id TEXT PRIMARY KEY, title TEXT, category TEXT,
+                tags TEXT, kind TEXT, script_ref TEXT);
+            CREATE INDEX IF NOT EXISTS ix_hub_cat ON hub_catalog(category);
+            CREATE TABLE IF NOT EXISTS custom_skills (
+                id TEXT PRIMARY KEY, title TEXT, signature TEXT UNIQUE,
+                manifest TEXT, created TEXT, uses INTEGER DEFAULT 0);
+            CREATE TABLE IF NOT EXISTS exec_log (
+                ts TEXT, skill TEXT, agent TEXT, runtime_ms INTEGER,
+                ok INTEGER, xrefs INTEGER);
+            CREATE TABLE IF NOT EXISTS xref_stats (
+                ts TEXT, xrefs INTEGER, evolved INTEGER, materialized INTEGER,
+                hub_ready INTEGER);
+            """)
+
+    # ------------------------------------------------------------- hub build
+    def ensure_hub(self, background: bool = True) -> None:
+        """Idempotently build the 90k hub DBAL (lazy, never held in memory)."""
+        with self.lock:
+            if self._hub_ready or self._building:
+                return
+            with self._conn() as conn:
+                n = conn.execute("SELECT COUNT(*) c FROM hub_catalog").fetchone()["c"]
+            if n >= HUB_TOTAL:
+                self._hub_ready = True
+                return
+            self._building = True
+        if background:
+            self._build_thread = threading.Thread(target=self._build_hub, daemon=True,
+                                                  name="hermes-hub-build")
+            self._build_thread.start()
+        else:
+            self._build_hub()
+
+    def _build_hub(self) -> None:
+        rnd = random.Random(2077)
+        t0 = time.time()
+        rows = []
+        for cat in CATEGORIES:
+            base_tokens = cat.replace("-", " ")
+            for i in range(SKILLS_PER_CATEGORY):
+                ref_id = f"hub.{cat}.{i:04d}"
+                title = f"{cat} skill-{i:04d}"
+                extra = rnd.choice(["fast", "async", "batch", "live", "deep"])
+                tags = f"{base_tokens} {extra} hermes"
+                kind = _KINDS[i % len(_KINDS)]
+                script_ref = f"hermes://{cat}/{i:04d}.py"
+                rows.append((ref_id, title, cat, tags, kind, script_ref))
+                if len(rows) >= 20000:
+                    self._insert_hub_rows(rows)
+                    rows = []
+        if rows:
+            self._insert_hub_rows(rows)
+        with self.lock:
+            self._hub_ready = True
+            self._building = False
+        STATE.log("OK", "XREF",
+                  f"Hermes hub DBAL indexed :: {HUB_TOTAL} skills / "
+                  f"{len(CATEGORIES)} categories in {time.time()-t0:.1f}s.")
+
+    def _insert_hub_rows(self, rows: List[tuple]) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executemany(
+                "INSERT OR IGNORE INTO hub_catalog"
+                " (ref_id, title, category, tags, kind, script_ref)"
+                " VALUES (?,?,?,?,?,?)", rows)
+
+    def hub_status(self) -> Dict[str, Any]:
+        with self.lock, self._conn() as conn:
+            n = conn.execute("SELECT COUNT(*) c FROM hub_catalog").fetchone()["c"]
+        return {"indexed": n, "total": HUB_TOTAL,
+                "ready": self._hub_ready, "building": self._building,
+                "categories": len(CATEGORIES)}
+
+    # ----------------------------------------------------- progressive lookup
+    def lookup(self, query: str, k: int = 6) -> Dict[str, Any]:
+        """Two-stage disclosure: score yellow pages → fetch only top cats."""
+        self.ensure_hub(background=True)
+        q_tokens = _tokenize(query)
+        if not q_tokens:
+            return {"ok": False, "error": "empty query"}
+
+        scored = sorted(
+            ((cat, len(q_tokens & toks)) for cat, toks in self._pages.items()),
+            key=lambda kv: -kv[1])
+        top_cats = [c for c, s in scored[:3] if s > 0] or [scored[0][0]]
+
+        out: List[Dict[str, Any]] = []
+        if self._hub_ready:
+            marks = ",".join("?" * len(top_cats))
+            with self.lock, self._conn() as conn:
+                rows = conn.execute(
+                    f"SELECT ref_id, title, category, tags, kind FROM hub_catalog"
+                    f" WHERE category IN ({marks}) LIMIT ?",
+                    (*top_cats, k)).fetchall()
+            out = [dict(r) for r in rows]
+        return {"ok": True, "query": query, "categories": top_cats,
+                "results": out, "hub_ready": self._hub_ready}
+
+    # ------------------------------------------------------------ materialize
+    def materialize(self, ref_id: str) -> Dict[str, Any]:
+        """Fetch ONLY the exact script/reference/tool-hook for one sub-task."""
+        self.ensure_hub(background=True)
+        with self.lock, self._conn() as conn:
+            row = conn.execute("SELECT * FROM hub_catalog WHERE ref_id=?",
+                               (ref_id,)).fetchone()
+        if not row:
+            return {"ok": False, "error": f"unknown ref '{ref_id}'"}
+        self.materialized_count += 1
+        return {"ok": True, "ref_id": ref_id, "title": row["title"],
+                "kind": row["kind"], "script_ref": row["script_ref"],
+                "payload": f"::on-demand-materialized::{ref_id}::",
+                "note": "zero-bloat: single reference only"}
+
+    # --------------------------------------------------------- cross-reference
+    def cross_reference(self, skill_id: str, agent: str = "—",
+                        context: str = "") -> Dict[str, Any]:
+        """Fuse a skill invocation with MCP tools, templates, repo templates,
+        hub matches and historical execution logs."""
+        tokens = _tokenize(skill_id.replace(".", " ").replace("_", " ") + " " + context)
+
+        mcp_hits = [t["id"] for t in MCP_TOOLS if tokens & t["tags"]]
+        tmpl_hits = []
+        for family, items in BACKEND_TEMPLATES.items():
+            for t in items:
+                if tokens & t["tags"]:
+                    tmpl_hits.append(f"{family}:{t['id']}")
+        repo_hits = [r["id"] for r in REPO_TEMPLATES if tokens & r["tags"]]
+        hub_hits = self.lookup(context or skill_id, k=3)["results"]
+
+        # historical execution log for this skill from the memory vault
+        hist = {"runs": 0, "ok_rate": 0.0}
+        try:
+            from .memory import MEMORY
+            with MEMORY.lock, MEMORY._conn() as conn:
+                row = conn.execute(
+                    "SELECT COUNT(*) c, AVG(ok) a FROM skill_feedback"
+                    " WHERE skill_id=?", (skill_id,)).fetchone()
+                hist = {"runs": row["c"], "ok_rate": round((row["a"] or 0) * 100, 1)}
+        except Exception:
+            pass
+
+        self.xref_count += 1
+        self._pending_flush.append({
+            "ts": now_iso(), "skill": skill_id, "agent": agent,
+            "xrefs": len(mcp_hits) + len(tmpl_hits) + len(repo_hits)})
+
+        return {"ok": True, "skill_id": skill_id, "agent": agent,
+                "mcp_tools": mcp_hits, "templates": tmpl_hits,
+                "repo_templates": repo_hits, "hub_matches": hub_hits,
+                "history": hist,
+                "fusion": "combined-capabilities-plan",
+                "note": "progressive disclosure: only refs, not bodies"}
+
+    # ------------------------------------------------------- execution hooks
+    def on_skill_executed(self, skill_id: str, agent: str,
+                          runtime_ms: int, ok: bool) -> None:
+        """Lightweight, non-blocking hook fed by skills.execute_skill.
+
+        Accumulates the execution into the pending flush so the 120 s sync
+        daemon lands it in the DBAL; never does heavy work inline.
+        """
+        self._pending_flush.append({
+            "ts": now_iso(), "skill": skill_id, "agent": agent,
+            "runtime_ms": int(runtime_ms or 0), "ok": 1 if ok else 0,
+            "xrefs": 0})
+        if len(self._pending_flush) > 5000:  # memory guard
+            del self._pending_flush[:2500]
+
+    # ------------------------------------------------------ evolution (loop)
+    def _signature(self, steps: List[Dict[str, Any]]) -> str:
+        joined = "|".join(s.get("skill_id", "?") for s in steps)
+        return _stable_hash(joined)
+
+    def _eval_gates(self, steps: List[Dict[str, Any]]) -> Optional[str]:
+        """Return an error string if any evaluation gate fails, else None."""
+        ok_steps = [s for s in steps if s.get("exit_code", 1) == 0]
+        if len(ok_steps) < 2:
+            return "gate1: needs >=2 successful steps"
+        for s in ok_steps:
+            if not s.get("skill_id"):
+                return "gate2: every step needs a valid skill ref"
+        if len(ok_steps) > 16:
+            return "gate4: too many steps (bloat guard)"
+        blob = json.dumps(ok_steps)
+        if len(blob) > 64_000:
+            return "gate4: trace too large (bloat guard)"
+        return None
+
+    def evolve_skill(self, steps: List[Dict[str, Any]],
+                     title: str = "") -> Dict[str, Any]:
+        """Fuse a completed multi-step trace into a new custom skill."""
+        steps = steps or []
+        err = self._eval_gates(steps)
+        if err:
+            return {"ok": False, "error": err}
+
+        clean = [{"skill_id": s.get("skill_id"), "params": s.get("params", {}),
+                  "runtime_ms": s.get("runtime_ms", 0)} for s in steps
+                 if s.get("exit_code", 1) == 0]
+        sig = self._signature(clean)
+
+        with self.lock, self._conn() as conn:
+            existing = conn.execute("SELECT id FROM custom_skills WHERE signature=?",
+                                    (sig,)).fetchone()
+            if existing:
+                conn.execute("UPDATE custom_skills SET uses = uses + 1 WHERE id=?",
+                             (existing["id"],))
+                self.evolved_count += 1
+                return {"ok": True, "id": existing["id"], "dedup": True,
+                        "note": "signature exists — use counter bumped"}
+
+        cid = "custom." + _stable_hash(sig)[:10]
+        manifest = {
+            "id": cid, "title": title or f"fused-{cid[-6:]}",
+            "signature": sig, "steps": clean,
+            "created": now_iso(), "schema": "omnihack.custom-skill/1",
+        }
+        path = os.path.join(self.skills_dir, f"{cid}.json")
+        try:
+            with open(path, "w") as fh:
+                json.dump(manifest, fh, indent=2)
+        except OSError as exc:
+            return {"ok": False, "error": f"gate-write: {exc}"}
+
+        with self.lock, self._conn() as conn:
+            conn.execute("INSERT OR REPLACE INTO custom_skills"
+                         " (id, title, signature, manifest, created)"
+                         " VALUES (?,?,?,?,?)",
+                         (cid, manifest["title"], sig, json.dumps(manifest), now_iso()))
+        self.evolved_count += 1
+        STATE.log("OK", "XREF", f"Evolved new custom skill {cid} "
+                                f"({len(clean)} steps) → {path}")
+        return {"ok": True, "id": cid, "path": path, "steps": len(clean)}
+
+    def load_custom_skills(self) -> List[Dict[str, Any]]:
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT id, title, created, uses FROM custom_skills"
+                                " ORDER BY created DESC").fetchall()
+        return [dict(r) for r in rows]
+
+    # ------------------------------------------------------------ sync daemon
+    def start_sync(self, interval: float = SYNC_S) -> str:
+        self.ensure_hub(background=True)
+        self.sync_running = True
+        self._stop.clear()
+        self._sync_thread = threading.Thread(target=self._sync_loop, daemon=True,
+                                             name="xref-sync")
+        self._sync_thread.start()
+        STATE.log("OK", "XREF", f"Cross-ref sync daemon armed :: {int(interval)}s "
+                                f"(120s DBAL heartbeat).")
+        return f"🧬 Cross-ref sync daemon armed :: every {int(interval)}s."
+
+    def stop_sync(self) -> str:
+        self.sync_running = False
+        self._stop.set()
+        STATE.log("INFO", "XREF", "Cross-ref sync daemon disarmed.")
+        return "⏹ Cross-ref sync daemon disarmed."
+
+    def _sync_loop(self) -> None:
+        while not self._stop.wait(SYNC_S):
+            if STATE.halted or not self.sync_running:
+                continue
+            try:
+                self.run_sync_cycle()
+            except Exception as exc:
+                STATE.log("WARN", "XREF", f"Sync error :: {exc}")
+
+    def run_sync_cycle(self) -> Dict[str, Any]:
+        """One 120s pass: flush pending xref exec data into the DBAL."""
+        with self.lock, self._conn() as conn:
+            for p in self._pending_flush:
+                conn.execute("INSERT INTO exec_log (ts, skill, agent, runtime_ms,"
+                             " ok, xrefs) VALUES (?,?,?,?,?,?)",
+                             (p["ts"], p["skill"], p["agent"],
+                              p.get("runtime_ms", 0), p.get("ok", 1),
+                              p.get("xrefs", 0)))
+            flushed = len(self._pending_flush)
+            self._pending_flush = []
+            conn.execute("INSERT INTO xref_stats (ts, xrefs, evolved, materialized,"
+                         " hub_ready) VALUES (?,?,?,?,?)",
+                         (now_iso(), self.xref_count, self.evolved_count,
+                          self.materialized_count, 1 if self._hub_ready else 0))
+        self.sync_cycles += 1
+        self.last_sync_ts = now_iso()
+        STATE.log("INFO", "XREF", f"Sync #{self.sync_cycles} :: flushed {flushed} "
+                                  f"xref records · hub "
+                                  f"{self.hub_status()['indexed']}/{HUB_TOTAL}.")
+        return {"flushed": flushed, "cycle": self.sync_cycles}
+
+    # ------------------------------------------------------------ telemetry
+    def stats(self) -> Dict[str, Any]:
+        hub = self.hub_status()
+        with self.lock, self._conn() as conn:
+            n_custom = conn.execute("SELECT COUNT(*) c FROM custom_skills").fetchone()["c"]
+            n_exec = conn.execute("SELECT COUNT(*) c FROM exec_log").fetchone()["c"]
+        return {"hub_indexed": hub["indexed"], "hub_total": hub["total"],
+                "hub_ready": hub["ready"], "categories": hub["categories"],
+                "xrefs": self.xref_count, "evolved": self.evolved_count,
+                "materialized": self.materialized_count,
+                "custom_skills": n_custom, "exec_log_rows": n_exec,
+                "sync_cycles": self.sync_cycles, "last_sync": self.last_sync_ts or "—",
+                "sync_running": self.sync_running,
+                "skills_dir": self.skills_dir, "hub_path": self.hub_path}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return (f"[XREF] hub {s['hub_indexed']}/{s['hub_total']} · "
+                f"xrefs {s['xrefs']} · evolved {s['evolved']} · "
+                f"custom {s['custom_skills']} · sync {s['sync_cycles']}")
+
+
+XREF = CrossRefEngine()
+
+
+# --------------------------------------------------------------------------- #
+# Standalone middleware probe (no UI involved)
+# --------------------------------------------------------------------------- #
+if __name__ == "__main__":
+    import sys
+
+    XREF.ensure_hub(background=False)
+    print("◤ CROSS-REFERENCE ENGINE :: HERMES HUB ONLINE ◢")
+    print(json.dumps(XREF.hub_status(), indent=2))
+    if len(sys.argv) > 1:
+        q = " ".join(sys.argv[1:])
+        print(f"\n[LOOKUP] '{q}' →")
+        print(json.dumps(XREF.lookup(q, k=4), indent=2, default=str))
+        hit = XREF.lookup(q, k=1)["results"]
+        if hit:
+            print("\n[MATERIALIZE]", json.dumps(XREF.materialize(hit[0]["ref_id"]),
+                                                indent=2))
+    res = XREF.run_sync_cycle()
+    print("\n[SYNC]", json.dumps(res, indent=2))
+    print("[HEARTBEAT]", XREF.heartbeat_payload())
