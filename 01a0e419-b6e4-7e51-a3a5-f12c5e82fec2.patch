+def _leak_scan_check():
+    """Defensive scanner: detect + mask + NEVER persist the secret value."""
+    import os as _os
+    target = _os.path.join(_probe_dir, "leaktree")
+    _os.makedirs(target, exist_ok=True)
+    secret = "ghp_" + "Le4k" * 10
+    with open(_os.path.join(target, ".env"), "w") as fh:
+        fh.write(f"GITHUB_TOKEN={secret}\n")
+    report = _probe.scan_local_tree(target)
+    assert report["ok"] and len(report["findings"]) == 1, report
+    blob = _json.dumps(report)
+    assert secret not in blob, "raw secret leaked into report"
+    with _probe._conn() as conn:  # verify DB side is masked too
+        row = conn.execute("SELECT fingerprint FROM leak_findings"
+                           " ORDER BY ts DESC LIMIT 1").fetchone()
+        assert row and secret not in row["fingerprint"]
+
