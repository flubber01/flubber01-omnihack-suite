@@ -0,0 +1,302 @@
+"""📱 TELEGRAM CONTROL BRIDGE :: operate the swarm from your phone.
+
+Paste a BotFather token, hit ARM — the bridge validates the bot via
+``getMe`` and starts a background long-polling loop.  Supported commands:
+
+    /status                telemetry snapshot
+    /agents                commander + minion roster
+    /kill                  EMERGENCY KILL SWITCH
+    /resume                re-arm the swarm
+    /ping                  broadcast heartbeat
+    /short <topic>         run the full content autopilot
+    /say <AGENT> <msg>     direct-talk any agent
+    /skin <JARVIS|CYBERPUNK|MILITARY OPS>   swap the HUD style
+    /nexus                 API vault + free-pool status
+    /help                  command list
+
+Works against the real Telegram Bot API when the VPS has egress; otherwise
+it fails gracefully with a CRIT log line.
+"""
+
+from __future__ import annotations
+
+import threading
+from typing import Any, Dict, List, Optional
+
+import requests
+
+from . import swarm
+from .api_nexus import NEXUS
+from .billion_grid import BILLION
+from .compute_commander import COMMANDER
+from .cross_ref_engine import XREF
+from .dbal_engine import DBAL_ENGINE
+from .model_binding import MODEL
+from .pipeline import PIPELINE, PLATFORMS, TONES, VOICES
+from .prompt_router import ROUTER
+from .quantum_agents import QUANTUM
+from .state import STATE
+from .stream_bridge import BRIDGE as STREAM_BRIDGE
+from .sync_heartbeat import HEARTBEAT
+from .timesfm import TIMESFM
+
+API = "https://api.telegram.org/bot{token}/{method}"
+HELP_TEXT = (
+    "🛰️ OMNIHACK TELEGRAM BRIDGE\n"
+    "/status — telemetry\n/agents — roster\n/kill — kill switch\n"
+    "/resume — re-arm\n/ping — heartbeat\n/short <topic> — content autopilot\n"
+    "/say <AGENT> <msg> — talk to an agent\n/skin <name> — HUD style\n"
+    "/nexus — API vault + free-pool status\n/xref <query> — Hermes hub lookup\n"
+    "/forecast — TimesFM hardware + traffic forecast\n"
+    "/quant — quantum anomaly pipeline\n/billion — 1e9 grid footprint + bench\n"
+    "/compute [cmd] — Compute-Commander chat/status\n"
+    "/streams — stream wall sessions + fps guard\n"
+    "/dbal — DBAL registry + sync heartbeat\n"
+    "/prompt <task> — master→minion prompt dispatch\n"
+    "/model — bound reasoning engine\n/help — this list"
+)
+
+
+class TelegramBridge:
+    def __init__(self) -> None:
+        self.token: str = ""
+        self.allowed: List[str] = []
+        self._thread: Optional[threading.Thread] = None
+        self._stop = threading.Event()
+        self.offset: int = 0
+
+    # ------------------------------------------------------------------ api
+    def _call(self, method: str, **params: Any) -> Dict[str, Any]:
+        url = API.format(token=self.token, method=method)
+        r = requests.get(url, params=params, timeout=35)
+        data = r.json()
+        if not data.get("ok"):
+            raise RuntimeError(data.get("description", method + " failed"))
+        return data["result"]
+
+    def _send(self, chat_id: int, text: str) -> None:
+        try:
+            self._call("sendMessage", chat_id=chat_id, text=text[:4000])
+        except Exception as exc:
+            STATE.log("WARN", "TELEGRAM", f"sendMessage failed :: {exc}")
+
+    # ------------------------------------------------------------- lifecycle
+    def start(self, token: str, allowed: str) -> str:
+        token = (token or "").strip()
+        if not token:
+            return "❌ Paste your BotFather token first."
+        self.token = token
+        self.allowed = [c.strip() for c in (allowed or "").replace(";", ",").split(",") if c.strip()]
+        try:
+            me = self._call("getMe")
+        except Exception as exc:
+            STATE.telegram_cfg.update(running=False)
+            STATE.log("CRIT", "TELEGRAM", f"getMe failed :: {exc}")
+            return f"❌ Bot unreachable :: {exc}"
+        STATE.telegram_cfg.update(token=token, allowed=allowed or "",
+                                   running=True, bot_name=me.get("username", "?"))
+        self._stop.clear()
+        self._thread = threading.Thread(target=self._loop, daemon=True,
+                                         name="omni-telegram")
+        self._thread.start()
+        STATE.log("OK", "TELEGRAM", f"Bridge armed :: @{me.get('username')} "
+                                     f"(allowed: {len(self.allowed) or 'everyone'}).")
+        return (f"🟢 Bridge armed :: @{me.get('username')} · "
+                f"chat whitelist: {', '.join(self.allowed) or 'OPEN'} · send /help to the bot.")
+
+    def stop(self) -> str:
+        self._stop.set()
+        STATE.telegram_cfg["running"] = False
+        STATE.log("INFO", "TELEGRAM", "Bridge disarmed.")
+        return "⏹ Telegram bridge disarmed."
+
+    @property
+    def running(self) -> bool:
+        return STATE.telegram_cfg.get("running", False) and not self._stop.is_set()
+
+    # ------------------------------------------------------------------ loop
+    def _loop(self) -> None:
+        while not self._stop.is_set():
+            try:
+                updates = self._call("getUpdates", offset=self.offset + 1,
+                                      timeout=25, allowed_updates='["message"]')
+            except Exception:
+                if self._stop.wait(5):
+                    return
+                continue
+            for upd in updates:
+                self.offset = max(self.offset, upd.get("update_id", 0))
+                msg = upd.get("message") or {}
+                text = (msg.get("text") or "").strip()
+                chat = msg.get("chat", {})
+                chat_id = chat.get("id")
+                if not text or chat_id is None:
+                    continue
+                if self.allowed and str(chat_id) not in self.allowed \
+                        and str(chat.get("username", "")) not in self.allowed:
+                    self._send(chat_id, "⛔ Unauthorized — your chat id is not whitelisted.")
+                    STATE.log("WARN", "TELEGRAM", f"Rejected chat {chat_id}.")
+                    continue
+                STATE.log("INFO", "TELEGRAM", f"cmd from {chat.get('username', chat_id)} :: {text[:60]}")
+                try:
+                    self._send(chat_id, self.handle(text))
+                except Exception as exc:
+                    self._send(chat_id, f"❌ Handler error :: {exc}")
+
+    # --------------------------------------------------------------- handlers
+    def handle(self, text: str) -> str:
+        text = (text or "").strip()
+        if not text:
+            return HELP_TEXT
+        parts = text.split(maxsplit=2)
+        cmd = parts[0].lower().split("@")[0]
+
+        if cmd == "/help":
+            return HELP_TEXT
+        if cmd == "/status":
+            m = STATE.metrics()
+            return (f"📊 SWARM STATUS\nCPU {m['cpu']:.0f}% · RAM {m['ram_pct']:.0f}%\n"
+                    f"Commanders {m['commanders_active']}/{m['commanders']} · "
+                    f"Minions {m['minions_active']}/{m['minions']}\n"
+                    f"Browsers {m['browser_instances']} · Renders {m['render_tasks']} · "
+                    f"Pipelines {m['pipelines']}\n"
+                    f"State: {'⛔ HALTED' if m['halted'] else '🟢 NOMINAL'} · up {m['uptime']}")
+        if cmd == "/agents":
+            lines = []
+            for a in STATE.agents.values():
+                mark = "👑" if a["tier"] == "commander" else "▸"
+                lines.append(f"{mark} {a['name']} [{a['status']}] model={a['model']}")
+            return "🤖 ROSTER\n" + "\n".join(lines) if lines else "Swarm empty."
+        if cmd == "/kill":
+            return STATE.halt_all("TELEGRAM KILL SWITCH")
+        if cmd == "/resume":
+            return STATE.resume_all()
+        if cmd == "/ping":
+            n = sum(1 for a in STATE.agents.values() if a["status"] != "HALTED")
+            return f"📡 PING → {n} agents acknowledged."
+        if cmd == "/skin":
+            from .theme import SKIN_NAMES
+            want = (parts[1].upper() if len(parts) > 1 else "")
+            match = next((s for s in SKIN_NAMES if s.upper().startswith(want)), None)
+            if not match:
+                return f"Unknown skin. Options: {', '.join(SKIN_NAMES)}"
+            STATE.skin = match
+            return f"🎨 HUD skin switched → {match} (applies on next tab refresh)."
+        if cmd == "/short":
+            topic = text[len("/short"):].strip() or "untitled brief"
+            res = PIPELINE.run_autopilot(topic, TONES[0], 45, PLATFORMS[:3],
+                                          "ALEX-TECH", VOICES[0])
+            posts = ", ".join(p["platform"] for p in res["posts"])
+            return f"🎬 Autopilot done :: {res['job']['id']}\n→ {posts}"
+        if cmd == "/nexus":
+            s = NEXUS.stats()
+            return (f"🕸️ API-NEXUS VAULT\n"
+                    f"Own keys {s['active_keys']}/{s['vault_keys']} active · "
+                    f"free endpoints {s['healthy_endpoints']}/{s['free_endpoints']} healthy\n"
+                    f"Src success {s['source_success_rate']}% · "
+                    f"learning weight {s['avg_learning_weight']}\n"
+                    f"Worker {'RUNNING' if s['worker_running'] else 'idle'} · "
+                    f"cycles {s['worker_cycles']} · last {s['last_cycle']}\n"
+                    f"Mode: LEGITIMATE (own keys + free endpoints only)")
+        if cmd == "/streams":
+            s = STREAM_BRIDGE.stats()
+            lines = [f"🖼️ STREAM WALL :: {s['sessions']} sessions · "
+                     f"{s['total_fps']}/{s['fps_budget']} fps · "
+                     f"focus {s['focused'] or '—'}"]
+            for c in STREAM_BRIDGE.session_cards():
+                lines.append(f"▸ {c['session_id']} [{c['kind']}] {c['state']} "
+                             f"{c['fps']}fps 🕶{c['stealth']} cpu{c['cpu']}%")
+            return "\n".join(lines)
+        if cmd == "/dbal":
+            s = DBAL_ENGINE.stats()
+            hb = HEARTBEAT.status()
+            lines = [f"🗄️ DBAL :: {s['sources']} sources "
+                     f"({s['external']} external) · {s['migrations']} migrations",
+                     f"🫀 HEARTBEAT :: beats {hb['beats']} · "
+                     f"last {hb['last_beat'] or '—'} · "
+                     f"worker {'RUNNING' if hb['running'] else 'stopped'} · "
+                     f"ring {hb['ring']['fill']}/{hb['ring']['size']}"]
+            for r in DBAL_ENGINE.registry_rows()[:8]:
+                lines.append(f"▸ {r['name']} [{r['kind']}] {r['status']}")
+            return "\n".join(lines)
+        if cmd == "/prompt":
+            task = text[len("/prompt"):].strip()
+            if not task:
+                return ("🧭 PROMPT ROUTER :: usage /prompt <task>\n" +
+                        "\n".join(f"▸ {d['domain']} q{d['quality']:.2f} "
+                                  f"×{d['uses']}" for d in ROUTER.domains()))
+            d = ROUTER.dispatch("telegram-master", "field-minion", task)
+            if not d["ok"]:
+                return f"❌ {d.get('error')}"
+            return (f"🧭 DISPATCH → {d['minion']} :: domain {d['domain']} "
+                    f"(score {d['score']})\n{d['prompt']}")
+        if cmd == "/model":
+            probe = MODEL.probe()
+            if not probe.get("bound"):
+                return "🔗 MODEL :: unbound — run hermes_core_init.py --bind"
+            return (f"🔗 MODEL :: {probe['provider']}/{probe.get('model')}\n"
+                    f"reachability: {probe['reachability']}")
+        if cmd == "/compute":
+            msg = text[len("/compute"):].strip()
+            if msg:
+                history, _ = COMMANDER.chat([], msg)
+                return history[-1]["content"] if history else "No reply."
+            s = COMMANDER.stats()
+            return (f"🎖️ COMPUTE-COMMANDER\n"
+                    f"Pool {s['idle']} idle / {s['busy']} busy / {s['off']} off · "
+                    f"{s['total_power_w']:,}W\n"
+                    f"Offloaded {s['offloaded']} · kept local {s['local_kept']} · "
+                    f"telemetry cycles {s['telemetry_cycles']}\n"
+                    f"usage: /compute <natural-language command>")
+        if cmd == "/billion":
+            s = BILLION.stats()
+            bench = BILLION.benchmark(500)
+            return (f"🌍 BILLION GRID\n"
+                    f"{s['personas']:,} personas addressable · {s['active']} active\n"
+                    f"distilled {s['distilled_bytes']/1048576:.1f} MiB artifact · "
+                    f"on-disk {s['on_disk_bytes']/1024:.0f} KiB ledger · "
+                    f"{s['bytes_per_persona']} B/persona\n"
+                    f"bench: {bench['per_us']}µs/op · {bench['lookups_per_s']:,}/s · "
+                    f"0 model calls")
+        if cmd == "/forecast":
+            hw = TIMESFM.forecast_hardware("cpu", horizon=4)
+            tr = TIMESFM.forecast_traffic(horizon=4)
+            adv = TIMESFM.renderfarm_advice()
+            return (f"📈 TIMESFM FORECAST\n"
+                    f"CPU → {hw['points']} (p90 {hw['p90'][:2]}…)\n"
+                    f"Traffic → {tr['points'][:4]} hits/min\n"
+                    f"Render farm: {adv['action']}")
+        if cmd == "/quant":
+            res = QUANTUM.run_pipeline()
+            h, t = res["hardware"], res["traffic"]
+            return (f"🧬 QUANTUM PIPELINE\n"
+                    f"hardware-matrix :: score {h['score']} → {h['verdict']}\n"
+                    f"swarm-traffic :: score {t['score']} → {t['verdict']}\n"
+                    f"{h['reasoning'][:160]}")
+        if cmd == "/xref":
+            query = text[len("/xref"):].strip()
+            if not query:
+                s = XREF.stats()
+                return (f"🧬 XREF ENGINE\nhub {s['hub_indexed']}/{s['hub_total']} · "
+                        f"cats {s['categories']}\nxrefs {s['xrefs']} · evolved "
+                        f"{s['evolved']} · custom skills {s['custom_skills']}\n"
+                        f"sync cycles {s['sync_cycles']} · last {s['last_sync']}\n"
+                        f"usage: /xref <query>")
+            res = XREF.lookup(query, k=3)
+            lines = [f"🧬 XREF '{query}' → cats: {', '.join(res['categories'])}"]
+            for r in res["results"]:
+                lines.append(f"▸ {r['ref_id']} [{r['kind']}] {r['title']}")
+            if not res["results"] and not res["hub_ready"]:
+                lines.append("(hub indexing in progress — retry in a moment)")
+            return "\n".join(lines)
+        if cmd == "/say" and len(parts) >= 3:
+            agent_name, message = parts[1].upper(), parts[2]
+            agent = next((a for a in STATE.agents.values()
+                          if a["name"] == agent_name), None)
+            if not agent:
+                return f"No agent named {agent_name}."
+            return f"{agent['name']} ▸ " + swarm._agent_reply(agent, message)
+        return HELP_TEXT
+
+
+BRIDGE = TelegramBridge()
