@@ -0,0 +1,122 @@
+"""🔗 MODEL BINDING :: primary reasoning-engine configuration surface.
+
+Stores the bound model in ``~/.hermes/config.json`` so every gateway
+(TUI, Telegram, Discord) and the commander brain read the same endpoint.
+Supported providers: ``local`` (Ollama), ``openrouter`` and ``custom``
+(any OpenAI-compatible base URL).  API keys are referenced, never logged.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import socket
+import threading
+from typing import Any, Dict, Optional
+from urllib.parse import urlparse
+
+from .state import STATE, now_iso
+
+CONFIG_PATH = os.environ.get(
+    "HERMES_CONFIG", os.path.expanduser("~/.hermes/config.json"))
+
+PROVIDERS = {
+    "local": {"endpoint": "http://127.0.0.1:11434", "default_model": "local-model:latest",
+              "needs_key": False},
+    "openrouter": {"endpoint": "https://openrouter.ai/api/v1",
+                   "default_model": "openrouter/auto", "needs_key": True},
+    "custom": {"endpoint": "", "default_model": "", "needs_key": True},
+}
+
+
+class ModelBinding:
+    """Load / write / probe the bound reasoning engine."""
+
+    def __init__(self, config_path: Optional[str] = None) -> None:
+        self.config_path = config_path or CONFIG_PATH
+        self.lock = threading.RLock()
+
+    # -------------------------------------------------------------- config
+    def load(self) -> Dict[str, Any]:
+        if os.path.exists(self.config_path):
+            try:
+                with open(self.config_path, "r", encoding="utf-8") as fh:
+                    return json.load(fh)
+            except (json.JSONDecodeError, OSError):
+                return {"provider": None, "error": "unreadable config"}
+        return {"provider": None}
+
+    def save(self, cfg: Dict[str, Any]) -> None:
+        cfg = dict(cfg)
+        cfg["updated"] = now_iso()
+        cfg.pop("api_key", None)  # never persist keys in plain config
+        os.makedirs(os.path.dirname(self.config_path), exist_ok=True)
+        with open(self.config_path, "w", encoding="utf-8") as fh:
+            json.dump(cfg, fh, indent=2)
+
+    # ---------------------------------------------------------------- bind
+    def bind(self, provider: str, model: str = "", endpoint: str = "",
+             api_key_env: str = "") -> Dict[str, Any]:
+        provider = (provider or "").strip().lower()
+        if provider not in PROVIDERS:
+            return {"ok": False, "error": f"unknown provider '{provider}'",
+                    "providers": sorted(PROVIDERS)}
+        spec = PROVIDERS[provider]
+        model = (model or spec["default_model"]).strip()
+        endpoint = (endpoint or spec["endpoint"]).strip()
+        if spec["needs_key"] and not api_key_env and not os.environ.get(
+                "OPENROUTER_API_KEY") and not os.environ.get("MODEL_API_KEY"):
+            return {"ok": False,
+                    "error": f"provider '{provider}' requires an API key — "
+                             "set OPENROUTER_API_KEY / MODEL_API_KEY or pass "
+                             "api_key_env=NAME_OF_ENV_VAR"}
+        cfg = {"provider": provider, "model": model, "endpoint": endpoint,
+               "api_key_env": api_key_env, "bound": now_iso()}
+        self.save(cfg)
+        STATE.log("OK", "MODEL-BIND",
+                  f"primary engine bound :: {provider}/{model} @ {endpoint}")
+        return {"ok": True, **{k: v for k, v in cfg.items() if k != "api_key_env"}}
+
+    # --------------------------------------------------------------- probe
+    def probe(self) -> Dict[str, Any]:
+        """Check whether the bound endpoint answers (local socket check;
+        remote providers report simulated reachability to stay native-safe)."""
+        cfg = self.load()
+        provider = cfg.get("provider")
+        if not provider:
+            return {"ok": False, "bound": False,
+                    "error": "no model bound yet — run hermes_core_init --bind"}
+        endpoint = cfg.get("endpoint", "")
+        if provider == "local":
+            parsed = urlparse(endpoint or "http://127.0.0.1:11434")
+            host = parsed.hostname or "127.0.0.1"
+            port = parsed.port or 11434
+            try:
+                with socket.create_connection((host, port), timeout=1.5):
+                    return {"ok": True, "bound": True, "provider": provider,
+                            "model": cfg.get("model"),
+                            "reachability": "LIVE (ollama port answers)"}
+            except OSError:
+                return {"ok": True, "bound": True, "provider": provider,
+                        "model": cfg.get("model"),
+                        "reachability": "OFFLINE (no local ollama — simulated "
+                                        "reasoning remains active)"}
+        return {"ok": True, "bound": True, "provider": provider,
+                "model": cfg.get("model"),
+                "reachability": "REGISTERED (remote calls simulated — "
+                                "native-safe mode)"}
+
+    # ------------------------------------------------------------ telemetry
+    def status(self) -> Dict[str, Any]:
+        cfg = self.load()
+        cfg.pop("api_key", None)
+        return {"config_path": self.config_path, **cfg}
+
+    def heartbeat_payload(self) -> str:
+        cfg = self.load()
+        if not cfg.get("provider"):
+            return "[MODEL] unbound"
+        return f"[MODEL] {cfg.get('provider')}/{cfg.get('model', '?')}"
+
+
+MODEL = ModelBinding()
