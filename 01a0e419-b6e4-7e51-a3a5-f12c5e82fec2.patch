+"""📈 TIMESFM-LITE :: time-series foundation model rebuilt from scratch (NumPy).
+
+A compact, dependency-light re-implementation of the TimesFM idea —
+input **patching** + a zero-shot ensemble decoder — running entirely on
+CPU/NumPy (no PyTorch, no downloaded weights).  The ensemble members are
+implemented from scratch:
+
+* seasonal-naive, Holt linear trend, Holt-Winters additive, Theta
+* a patch-attention re-weighter (softmax over patch embeddings)
+
+Model weights are derived from an in-sample backtest on every call, so the
+engine forecasts zero-shot on any stream.  Wired to mission data:
+
+* **hardware matrix** — CPU/RAM series from the memory vault
+* **100k-user traffic** — lookup-swarm hit log aggregation
+* **GPU render farm** — predictive load → container pre-warm advice
+
+Forecasts + advice are persisted to a DBAL ledger
+(`~/.omnihack/vault/timesfm.db`).
+"""
+
+from __future__ import annotations
+
+import os
+import sqlite3
+import threading
+from typing import Any, Dict, List, Optional
+
+import numpy as np
+
+from .state import STATE, now_iso
+
+DB_PATH = os.environ.get(
+    "OMNI_TIMESFM_DB", os.path.expanduser("~/.omnihack/vault/timesfm.db"))
+PATCH_LEN = 8
+
+
+# --------------------------------------------------------------------------- #
+# Patching (TimesFM core idea)
+# --------------------------------------------------------------------------- #
+def patch(series: np.ndarray, patch_len: int = PATCH_LEN) -> np.ndarray:
+    """Slice a 1-D series into (num_patches, patch_len) frames."""
+    series = np.asarray(series, dtype=float).ravel()
+    if series.size < patch_len:
+        pad = np.full(patch_len - series.size, series.mean() if series.size else 0.0)
+        series = np.concatenate([pad, series])
+    n = series.size - (series.size % patch_len)
+    return series[:n].reshape(-1, patch_len)
+
+
+def patch_attention_forecast(series: np.ndarray, horizon: int,
+                             seed: int = 7) -> np.ndarray:
+    """Deterministic decoder: softmax-weighted recombination of patch trends."""
+    patches = patch(series, PATCH_LEN)
+    rng = np.random.default_rng(seed)
+    proj = rng.normal(0.0, 1.0, size=(PATCH_LEN, 4))
+    emb = patches @ proj                                # (P, 4) embeddings
+    trend = np.diff(patches, axis=1).mean(axis=1)       # per-patch slope
+    logits = emb[:, 0] * 1.7 + trend * 3.0
+    w = np.exp(logits - logits.max())
+    w /= w.sum()
+    last_level = patches[-1].mean()
+    drift = float(np.dot(w, trend))
+    t = np.arange(1, horizon + 1, dtype=float)
+    return last_level + drift * t * 0.5
+
+
+# --------------------------------------------------------------------------- #
+# Classical members — implemented from scratch
+# --------------------------------------------------------------------------- #
+def seasonal_naive(series: np.ndarray, horizon: int, season: int = 4) -> np.ndarray:
+    y = np.asarray(series, dtype=float).ravel()
+    season = max(2, min(season, max(2, y.size // 2)))
+    tail = y[-season:]
+    return np.array([tail[i % season] for i in range(horizon)])
+
+
+def holt_linear(series: np.ndarray, horizon: int,
+                alpha: float = 0.45, beta: float = 0.12) -> np.ndarray:
+    y = np.asarray(series, dtype=float).ravel()
+    level, trend = float(y[0]), float(y[1] - y[0]) if y.size > 1 else 0.0
+    for v in y[1:]:
+        prev = level
+        level = alpha * v + (1 - alpha) * (level + trend)
+        trend = beta * (level - prev) + (1 - beta) * trend
+    t = np.arange(1, horizon + 1, dtype=float)
+    return level + trend * t
+
+
+def holt_winters(series: np.ndarray, horizon: int, season: int = 4,
+                 alpha: float = 0.4, beta: float = 0.1,
+                 gamma: float = 0.3) -> np.ndarray:
+    y = np.asarray(series, dtype=float).ravel()
+    m = max(2, min(season, max(2, y.size // 2)))
+    if y.size < 2 * m:
+        return holt_linear(y, horizon)
+    level = float(y[:m].mean())
+    trend = float((y[m:2 * m].mean() - y[:m].mean()) / m)
+    seas = list(y[:m] - level)
+    for v in y[m:]:
+        s0 = seas.pop(0)
+        prev = level
+        level = alpha * (v - s0) + (1 - alpha) * (level + trend)
+        trend = beta * (level - prev) + (1 - beta) * trend
+        seas.append(gamma * (v - level) + (1 - gamma) * s0)
+    out = []
+    for h in range(1, horizon + 1):
+        out.append(level + h * trend + seas[(h - 1) % m])
+    return np.asarray(out)
+
+
+def theta_forecast(series: np.ndarray, horizon: int) -> np.ndarray:
+    """Theta-method: SES on theta-lines blended with linear drift."""
+    y = np.asarray(series, dtype=float).ravel()
+    n = y.size
+    x = np.arange(n, dtype=float)
+    slope = float(np.polyfit(x, y, 1)[0]) if n > 2 else 0.0
+    ses, alpha = float(y[-1]), 0.35
+    for v in reversed(y):
+        ses = alpha * v + (1 - alpha) * ses
+    drift = np.arange(1, horizon + 1, dtype=float) * slope * 0.5
+    return np.full(horizon, ses) + drift
+
+
+# --------------------------------------------------------------------------- #
+class TimesFMLite:
+    """Zero-shot patching forecaster with backtest-weighted ensemble."""
+
+    def __init__(self, db_path: Optional[str] = None) -> None:
+        self.db_path = db_path or DB_PATH
+        self.lock = threading.RLock()
+        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
+        self.forecasts_made = 0
+        self._init_db()
+
+    # ------------------------------------------------------------------ db
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.db_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS forecast_log (
+                ts TEXT, stream TEXT, horizon INTEGER, mae REAL,
+                point_next REAL, p10 REAL, p90 REAL, note TEXT);
+            CREATE TABLE IF NOT EXISTS render_advice (
+                ts TEXT, rig TEXT, predicted_peak REAL, action TEXT);
+            """)
+
+    # ------------------------------------------------------------- ensemble
+    def forecast(self, series: List[float], horizon: int = 6,
+                 stream: str = "generic") -> Dict[str, Any]:
+        y = np.asarray(series, dtype=float).ravel()
+        y = y[~np.isnan(y)] if y.size else y
+        horizon = max(1, min(48, int(horizon)))
+        if y.size < 4:
+            base = float(y[-1]) if y.size else 50.0
+            flat = np.full(horizon, base)
+            return {"ok": True, "stream": stream, "horizon": horizon,
+                    "points": flat.tolist(), "p10": (flat - 5).tolist(),
+                    "p90": (flat + 5).tolist(),
+                    "weights": {"flat-fallback": 1.0},
+                    "note": "insufficient history — flat forecast"}
+
+        models = {
+            "seasonal-naive": lambda s, h: seasonal_naive(s, h),
+            "holt-linear": lambda s, h: holt_linear(s, h),
+            "holt-winters": lambda s, h: holt_winters(s, h),
+            "theta": lambda s, h: theta_forecast(s, h),
+            "patch-attention": lambda s, h: patch_attention_forecast(s, h),
+        }
+
+        # in-sample backtest → MAE → softmax weights
+        hold = max(1, min(horizon, y.size // 4))
+        train, truth = y[:-hold], y[-hold:]
+        maes: Dict[str, float] = {}
+        for name, fn in models.items():
+            try:
+                preds = np.asarray(fn(train, hold), dtype=float)[:hold]
+                maes[name] = float(np.mean(np.abs(preds - truth))) + 1e-6
+            except Exception:
+                maes[name] = 1e6
+        inv = np.array([1.0 / maes[k] for k in models])
+        w = np.exp(inv - inv.max())
+        w /= w.sum()
+        weights = {k: round(float(v), 4) for k, v in zip(models, w)}
+
+        # full-history forecasts, weighted blend
+        fc: Dict[str, np.ndarray] = {}
+        for name, fn in models.items():
+            try:
+                fc[name] = np.asarray(fn(y, horizon), dtype=float)
+            except Exception:
+                fc[name] = np.full(horizon, float(y[-1]))
+        points = sum(w[i] * fc[name] for i, name in enumerate(models))
+
+        # quantiles from backtest residual scale
+        resid = np.concatenate([
+            (np.asarray(models[name](train, hold), dtype=float)[:hold] - truth)
+            for name in models if maes[name] < 1e5])
+        sigma = float(np.std(resid)) if resid.size else float(np.std(y)) * 0.25
+        sigma = max(sigma, float(np.std(y)) * 0.05, 1e-3)
+        p10, p90 = points - 1.28 * sigma, points + 1.28 * sigma
+
+        self.forecasts_made += 1
+        with self.lock, self._conn() as conn:
+            conn.execute("INSERT INTO forecast_log (ts, stream, horizon, mae,"
+                         " point_next, p10, p90, note) VALUES (?,?,?,?,?,?,?,?)",
+                         (now_iso(), stream, horizon, round(min(maes.values()), 3),
+                          round(float(points[0]), 2), round(float(p10[0]), 2),
+                          round(float(p90[0]), 2), f"n={y.size}"))
+        return {"ok": True, "stream": stream, "horizon": horizon,
+                "points": [round(float(v), 2) for v in points],
+                "p10": [round(float(v), 2) for v in p10],
+                "p90": [round(float(v), 2) for v in p90],
+                "weights": weights, "model_mae": maes,
+                "sigma": round(sigma, 3), "n_history": int(y.size)}
+
+    # ------------------------------------------------------- data adapters
+    def hardware_series(self, metric: str = "cpu", min_len: int = 24) -> List[float]:
+        from .memory import MEMORY
+        with MEMORY.lock, MEMORY._conn() as conn:
+            rows = conn.execute(
+                f"SELECT {metric} FROM metrics_history ORDER BY ts DESC"
+                " LIMIT 96").fetchall()
+        series = [float(r[0]) for r in reversed(rows)]
+        if len(series) < min_len:  # seeded synthetic warm-start
+            rnd = np.random.default_rng(1337 + hash(metric) % 1000)
+            base = float(np.mean(series)) if series else 42.0
+            extra, v = [], base
+            for _ in range(min_len - len(series)):
+                v = max(3.0, min(97.0, v + float(rnd.normal(0, 4.5))))
+                extra.append(v)
+            series = extra + series
+        return series
+
+    def traffic_series(self, min_len: int = 24) -> List[float]:
+        from .lookup_swarm import LOOKUP_SWARM
+        with LOOKUP_SWARM.lock, LOOKUP_SWARM._conn() as conn:
+            rows = conn.execute(
+                "SELECT COUNT(*) c FROM hit_log GROUP BY"
+                " strftime('%Y-%m-%d %H:%M', ts) ORDER BY ts DESC"
+                " LIMIT 96").fetchall()
+        series = [float(r["c"]) for r in reversed(rows)]
+        if len(series) < min_len:  # deterministic diurnal warm-start
+            rnd = np.random.default_rng(7860)
+            t = np.arange(min_len - len(series))
+            wave = 18 + 9 * np.sin(t / 3.8) + rnd.normal(0, 1.6, t.size)
+            series = [max(0.0, float(v)) for v in wave] + series
+        return series
+
+    # ------------------------------------------------------------- products
+    def forecast_hardware(self, metric: str = "cpu",
+                          horizon: int = 8) -> Dict[str, Any]:
+        res = self.forecast(self.hardware_series(metric), horizon,
+                            stream=f"hw:{metric}")
+        STATE.log("INFO", "TIMESFM",
+                  f"Forecast hw:{metric} → next {res['points'][0]}"
+                  f" (p10 {res['p10'][0]} / p90 {res['p90'][0]}).")
+        return res
+
+    def forecast_traffic(self, horizon: int = 8) -> Dict[str, Any]:
+        res = self.forecast(self.traffic_series(), horizon, stream="traffic")
+        STATE.log("INFO", "TIMESFM",
+                  f"Forecast traffic → next {res['points'][0]} hits/min.")
+        return res
+
+    def renderfarm_advice(self) -> Dict[str, Any]:
+        """Predictive control: GPU peak forecast → pre-warm recommendation."""
+        loads = []
+        for rig in ("GPU-RIG-01", "GPU-RIG-02"):
+            hw = STATE.hardware.get(rig)
+            if hw:
+                loads.append(float(hw.get("load", 30)))
+        series = self.hardware_series("cpu")
+        blend = [0.5 * a + 0.5 * b for a, b in zip(series, loads[-1] * np.ones(len(series)))] \
+            if loads else series
+        fc = self.forecast(blend, horizon=6, stream="renderfarm")
+        peak = float(max(fc["points"]))
+        queued = sum(1 for t in STATE.render_tasks.values()
+                     if t["status"] in ("RENDERING", "QUEUED"))
+        if peak >= 80:
+            action = f"PRE-WARM 2 extra render containers (peak {peak:.0f}% predicted)"
+        elif peak >= 60:
+            action = f"PRE-WARM 1 render container (peak {peak:.0f}% predicted)"
+        else:
+            action = f"hold capacity — peak only {peak:.0f}% predicted"
+        with self.lock, self._conn() as conn:
+            conn.execute("INSERT INTO render_advice (ts, rig, predicted_peak, action)"
+                         " VALUES (?,?,?,?)",
+                         (now_iso(), "FARM", round(peak, 1), action))
+        STATE.log("OK", "TIMESFM", f"Render farm advice :: {action}")
+        return {"ok": True, "predicted_peak": round(peak, 1),
+                "queued_tasks": queued, "action": action,
+                "forecast": fc}
+
+    # ------------------------------------------------------------ telemetry
+    def stats(self) -> Dict[str, Any]:
+        with self.lock, self._conn() as conn:
+            n_fc = conn.execute("SELECT COUNT(*) c FROM forecast_log").fetchone()["c"]
+            last = conn.execute("SELECT stream, point_next, ts FROM forecast_log"
+                                " ORDER BY ts DESC LIMIT 1").fetchone()
+        return {"forecasts_made": self.forecasts_made, "db_rows": n_fc,
+                "last_stream": last["stream"] if last else "—",
+                "last_value": last["point_next"] if last else None,
+                "db_path": self.db_path}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return f"[TIMESFM] forecasts {s['forecasts_made']} · last {s['last_stream']}"
+
+
+TIMESFM = TimesFMLite()
