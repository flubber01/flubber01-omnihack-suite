+        "--nx-grid": "#0b2a3d",
+        "--nx-accent": "#35d6ff",
+        "--nx-accent2": "#ffd166",
+        "--nx-good": "#4dffa6",
+        "--nx-warn": "#ffb300",
+        "--nx-danger": "#ff4d6d",
+        "--nx-text": "#cdeeff",
+        "--nx-dim": "#4f7d99",
+        "--nx-glow-a": "rgba(53, 214, 255, 0.55)",
+        "--nx-glow-b": "rgba(255, 209, 102, 0.45)",
+        "--nx-font": "'Rajdhani', 'JetBrains Mono', monospace",
