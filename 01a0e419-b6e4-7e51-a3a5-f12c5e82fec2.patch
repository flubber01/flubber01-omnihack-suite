new file mode 100644
index 0000000..7d190fb
--- /dev/null
+++ b/mission_control/core/sync_heartbeat.py
@@ -0,0 +1,190 @@
+"""🫀 SYNC HEARTBEAT :: 120 s background sync worker + logging ring-buffer.
+
+Collects sub-agent telemetry (memory, cross-reference, lookup, billion
+grid, compute commander, stream wall, DBAL), writes one consolidated
+heartbeat row into the DBAL vault every :data:`SYNC_INTERVAL` seconds and
+keeps the last :data:`RING_SIZE` events in a circular in-memory log ring
+so no file handle or unbounded growth is involved.
+"""
+
+from __future__ import annotations
+
+import collections
+import json
+import os
+import sqlite3
+import threading
+from typing import Any, Deque, Dict, List, Optional
+
+from .state import STATE, now_iso
+
+SYNC_INTERVAL = 120          # seconds between heartbeats
+RING_SIZE = 512              # slots in the circular log ring
+DB_PATH = os.path.expanduser("~/.omnihack/vault/dbal.db")
+
+
+class LogRing:
+    """Bounded circular buffer of timestamped log lines (no files, no growth)."""
+
+    def __init__(self, size: int = RING_SIZE) -> None:
+        self.size = size
+        self._ring: Deque[str] = collections.deque(maxlen=size)
+        self.lock = threading.Lock()
+        self.total = 0
+
+    def push(self, line: str) -> None:
+        with self.lock:
+            self._ring.append(f"{now_iso()} :: {line}")
+            self.total += 1
+
+    def tail(self, n: int = 15) -> List[str]:
+        with self.lock:
+            return list(self._ring)[-n:]
+
+    def snapshot(self) -> Dict[str, Any]:
+        with self.lock:
+            return {"size": self.size, "total": self.total,
+                    "fill": len(self._ring)}
+
+
+class SyncHeartbeat:
+    """The periodic collector thread behind every subsystem's health."""
+
+    def __init__(self) -> None:
+        self.ring = LogRing()
+        self.lock = threading.RLock()
+        self.last_payload: Dict[str, Any] = {}
+        self.beats = 0
+        self.last_beat: Optional[str] = None
+        self._stop = threading.Event()
+        self._thread: Optional[threading.Thread] = None
+        self._ensure_table()
+
+    # ------------------------------------------------------------------ db
+    def _ensure_table(self) -> None:
+        os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
+        conn = sqlite3.connect(DB_PATH, timeout=5)
+        conn.execute("""CREATE TABLE IF NOT EXISTS heartbeat_sync (
+            ts TEXT, beat INTEGER, payload TEXT)""")
+        conn.commit()
+        conn.close()
+
+    # ------------------------------------------------------------- workers
+    def _collect(self) -> Dict[str, Any]:
+        payload: Dict[str, Any] = {}
+        try:
+            from .memory import MEMORY
+            payload["memory"] = {"memories": MEMORY.stats()["memories"]}
+        except Exception:  # pragma: no cover — defensive
+            payload["memory"] = {"error": "offline"}
+        try:
+            from .cross_ref_engine import XREF
+            s = XREF.stats()
+            payload["crossref"] = {"xrefs": s["xrefs"],
+                                   "hub": f"{s['hub_indexed']}/{s['hub_total']}"}
+        except Exception:
+            payload["crossref"] = {"error": "offline"}
+        try:
+            from .lookup_swarm import LOOKUP_SWARM
+            s = LOOKUP_SWARM.stats()
+            payload["lookup"] = {"indexed": s["indexed"],
+                                 "hit_rate": s["hit_rate"]}
+        except Exception:
+            payload["lookup"] = {"error": "offline"}
+        try:
+            from .billion_grid import BILLION
+            s = BILLION.stats()
+            payload["billion"] = {"active": s["active"],
+                                  "replies": s["replies_served"]}
+        except Exception:
+            payload["billion"] = {"error": "offline"}
+        try:
+            from .compute_commander import COMMANDER
+            s = COMMANDER.stats()
+            payload["compute"] = {"idle": s["idle"], "busy": s["busy"],
+                                  "offloaded": s["offloaded"]}
+        except Exception:
+            payload["compute"] = {"error": "offline"}
+        try:
+            from .stream_bridge import BRIDGE
+            s = BRIDGE.stats()
+            payload["streams"] = {"sessions": s["sessions"],
+                                  "fps": f"{s['total_fps']}/{s['fps_budget']}"}
+        except Exception:
+            payload["streams"] = {"error": "offline"}
+        try:
+            from .dbal_engine import DBAL_ENGINE
+            payload["dbal"] = {"sources": DBAL_ENGINE.stats()["sources"]}
+        except Exception:
+            payload["dbal"] = {"error": "offline"}
+        return payload
+
+    def beat(self) -> Dict[str, Any]:
+        """One heartbeat cycle: collect → persist → ring-log."""
+        payload = self._collect()
+        with self.lock:
+            self.beats += 1
+            self.last_beat = now_iso()
+            self.last_payload = payload
+            beat_no = self.beats
+        try:
+            conn = sqlite3.connect(DB_PATH, timeout=5)
+            conn.execute("INSERT INTO heartbeat_sync (ts, beat, payload)"
+                         " VALUES (?,?,?)",
+                         (now_iso(), beat_no, json.dumps(payload, default=str)))
+            conn.commit()
+            conn.close()
+        except sqlite3.Error as exc:
+            self.ring.push(f"heartbeat persist failed :: {exc}")
+        def _flat(v: Any) -> str:
+            if isinstance(v, dict):
+                return "/".join(str(x) for x in list(v.values())[:2]) or "ok"
+            return str(v)
+        summary = " ".join(f"{k}:{_flat(v)}" for k, v in payload.items())
+        self.ring.push(f"HEARTBEAT #{beat_no} :: {summary}")
+        STATE.log("OK", "HEARTBEAT", f"beat #{beat_no} synced :: {summary}")
+        return payload
+
+    # ------------------------------------------------------------- service
+    def start(self) -> bool:
+        if STATE.halted:
+            return False
+        if self._thread and self._thread.is_alive():
+            return False
+        self._stop.clear()
+        self._thread = threading.Thread(target=self._loop, daemon=True,
+                                        name="sync-heartbeat")
+        self._thread.start()
+        self.ring.push("heartbeat worker STARTED (120 s interval)")
+        return True
+
+    def stop(self) -> bool:
+        self._stop.set()
+        self.ring.push("heartbeat worker STOPPED")
+        return True
+
+    def _loop(self) -> None:
+        while not self._stop.is_set():
+            if not STATE.halted:
+                try:
+                    self.beat()
+                except Exception as exc:  # never let the worker die
+                    self.ring.push(f"heartbeat error :: {exc}")
+            self._stop.wait(SYNC_INTERVAL)
+
+    # ----------------------------------------------------------- telemetry
+    def status(self) -> Dict[str, Any]:
+        with self.lock:
+            running = bool(self._thread and self._thread.is_alive()
+                           and not self._stop.is_set())
+            return {"running": running, "beats": self.beats,
+                    "last_beat": self.last_beat,
+                    "last_payload": self.last_payload,
+                    "ring": self.ring.snapshot()}
+
+    def heartbeat_lines(self, n: int = 12) -> List[str]:
+        return self.ring.tail(n)
+
+
+HEARTBEAT = SyncHeartbeat()
+HEARTBEAT.start()
