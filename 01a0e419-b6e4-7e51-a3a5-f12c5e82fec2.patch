+#!/usr/bin/env python3
+"""🕸️ API-NEXUS HARVESTER — Omnihack Hermes backend integration hook.
+
+This is the entry point the Omnihack Mission Control backend loads to bring
+the zero-cost API supply engine online.  The real engine lives in
+``mission_control/core/api_nexus.py``; this file wires it to:
+
+  * the DBAL layer (auto-creates ``~/.omnihack/vault/api_nexus.db``),
+  * the 120 s health-check heartbeat (synced to the mission heartbeat),
+  * the adaptive learning curve,
+  * an in-process RPC facade the swarm / daemons / minions call for
+    on-demand, rotated, zero-cost assets.
+
+LEGITIMATE-MODE NOTICE
+------------------------
+This engine manages the operator's OWN keys and genuinely FREE keyless
+endpoints.  It does NOT harvest other people's leaked credentials.  Any
+credential entering the vault must be operator-supplied; scraped secrets are
+redacted and never stored.  See mission_control/core/api_nexus.py.
+
+Usage (standalone self-test)::
+
+    python3 api_nexus_harvester.py                      # boot + cycle + stats
+    python3 api_nexus_harvester.py --rpc <category> [agent]
+    python3 api_nexus_harvester.py --scan <path>        # defensive leak scan
+    python3 api_nexus_harvester.py --store <provider> <category> <key>
+    python3 api_nexus_harvester.py --ingest <name> <url>
+    python3 api_nexus_harvester.py --endpoints [category]
+    python3 api_nexus_harvester.py --vault              # own-key overview
+
+Usage (from code)::
+
+    from api_nexus_harvester import NexusRPC
+    asset = NexusRPC.request("llm-inference", agent="OMNI-PRIME")
+"""
+from __future__ import annotations
+
+import json
+import sys
+
+from mission_control.core.api_nexus import (
+    NEXUS, HEARTBEAT_S, CATEGORIES, looks_like_dummy, detect_provider,
+)
+
+
+class NexusRPC:
+    """In-process RPC facade for swarm agents, daemons and minions."""
+
+    @staticmethod
+    def request(category: str, provider: str = "", agent: str = "—") -> dict:
+        """Return the best healthy zero-cost asset for ``category``."""
+        return NEXUS.request_asset(category, provider, agent)
+
+    @staticmethod
+    def stats() -> dict:
+        return NEXUS.stats()
+
+    @staticmethod
+    def heartbeat() -> str:
+        return NEXUS.heartbeat_payload()
+
+    @staticmethod
+    def categories() -> list:
+        return list(CATEGORIES)
+
+
+def boot() -> str:
+    """Bring the engine online: DBAL init happens in the constructor."""
+    banner = (
+        "◤ API-NEXUS ENTERPRISE ENGINE :: ONLINE ◢\n"
+        f"  vault       : {NEXUS.vault_path}\n"
+        f"  heartbeat   : {HEARTBEAT_S}s (synced to mission heartbeat)\n"
+        f"  categories  : {len(CATEGORIES)}\n"
+        f"  mode        : LEGITIMATE (own keys + free keyless endpoints)"
+    )
+    return banner
+
+
+def _main(argv: list) -> int:
+    print(boot())
+    print()
+
+    if "--rpc" in argv:
+        idx = argv.index("--rpc")
+        cat = argv[idx + 1] if idx + 1 < len(argv) else "utility"
+        agent = argv[idx + 2] if idx + 2 < len(argv) else "HERMES"
+        asset = NexusRPC.request(cat, agent=agent)
+        print("[RPC] request_asset →")
+        print(json.dumps(asset, indent=2, default=str))
+        return 0
+
+    if "--scan" in argv:
+        idx = argv.index("--scan")
+        path = argv[idx + 1] if idx + 1 < len(argv) else "."
+        report = NEXUS.scan_local_tree(path)
+        print("[SCAN] defensive leak scan of YOUR tree →")
+        print(json.dumps(report, indent=2, default=str))
+        return 0
+
+    if "--store" in argv:
+        idx = argv.index("--store")
+        if idx + 3 >= len(argv):
+            print("usage: --store <provider> <category> <key>")
+            return 2
+        res = NEXUS.store_key(argv[idx + 1], argv[idx + 2], argv[idx + 3])
+        print("[STORE] operator key →", json.dumps(res, indent=2))
+        return 0 if res.get("ok") else 1
+
+    if "--ingest" in argv:
+        idx = argv.index("--ingest")
+        if idx + 2 >= len(argv):
+            print("usage: --ingest <source-name> <url>")
+            return 2
+        res = NEXUS.ingest_directory(argv[idx + 1], argv[idx + 2])
+        print("[INGEST] directory →", json.dumps(res, indent=2))
+        return 0 if res.get("ok") else 1
+
+    if "--endpoints" in argv:
+        idx = argv.index("--endpoints")
+        cat = argv[idx + 1] if idx + 1 < len(argv) else ""
+        rows = NEXUS.endpoints(category=cat)
+        print(f"[POOL] {len(rows)} free endpoint(s)"
+              + (f" in '{cat}'" if cat else "") + " →")
+        for e in rows:
+            print(f"  - {e['provider']:18s} {e['category']:20s} "
+                  f"{e['status']:9s} hs={e['health_score']:3d} {e['url']}")
+        return 0
+
+    if "--vault" in argv:
+        rows = NEXUS.vault_overview()
+        print(f"[VAULT] {len(rows)} operator key(s) →")
+        for k in rows:
+            print(f"  #{k['id']:<3d} {k['provider']:12s} {k['category']:20s} "
+                  f"{k['status']:9s} hs={k['health_score']:3d} "
+                  f"rot={k['rotations']} preview={k['key_preview']}")
+        return 0
+
+    # default: one health cycle + telemetry snapshot
+    result = NEXUS.run_health_cycle(live_network=False)
+    print("[HEALTH] one cycle →")
+    print(json.dumps(result, indent=2, default=str))
+    print()
+    print("[TELEMETRY] " + NexusRPC.heartbeat())
+    print()
+    print("[STATS]")
+    print(json.dumps(NexusRPC.stats(), indent=2, default=str))
+
+    # demo the dummy-key rejection + provider detection guards
+    print()
+    print("[GUARDS]")
+    print("  looks_like_dummy('sk-your-key-here') =", looks_like_dummy("sk-your-key-here"))
+    print("  detect_provider('ghp_' + 'A'*40)      =", detect_provider("ghp_" + "A" * 40))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(_main(sys.argv[1:]))
