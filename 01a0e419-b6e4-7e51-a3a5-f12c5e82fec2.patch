+/* ═══════════════════════════════════════════════════════════════════════
+ * OMNI C99 LIGHTWEIGHT INFERENCE ENGINE
+ * Portable, dependency-free micro-inference for CPU-only operation:
+ *   - omni_hash     FNV-1a 64-bit content hash
+ *   - omni_route    deterministic routing decision (text -> bucket)
+ *   - omni_score    fast heuristic confidence score (0..100)
+ *   - omni_generate seed-driven micro text generation into caller buffer
+ * No PyTorch / TensorFlow / GPU. C99, compiles with:
+ *   cc -std=c99 -O2 -shared -fPIC omni_c99.c -o omni_engine.so
+ * The pure-Python fallback in c99_bridge.py implements the SAME math so
+ * behaviour is identical when no compiler is present.
+ * ═══════════════════════════════════════════════════════════════════════ */
+
+#include <stddef.h>
+#include <string.h>
+
+typedef unsigned long long u64;
+
+/* ------------------------------------------------------------------ */
+u64 omni_hash(const char *s, int len)
+{
+    u64 h = 1469598103934665603ULL;           /* FNV offset basis */
+    int i;
+    if (s == NULL || len <= 0)
+        return h;
+    for (i = 0; i < len; i++) {
+        h ^= (u64)(unsigned char)s[i];
+        h *= 1099511628211ULL;                 /* FNV prime */
+    }
+    return h;
+}
+
+/* Map text to one of `buckets` lanes — used for routing decisions.   */
+int omni_route(const char *s, int len, int buckets)
+{
+    if (buckets <= 0)
+        return 0;
+    return (int)(omni_hash(s, len) % (u64)buckets);
+}
+
+/* Heuristic confidence: mixes length, alphanumeric density and       */
+/* punctuation pressure into a stable 0..100 score. Deterministic.    */
+int omni_score(const char *s, int len)
+{
+    int i, alnum = 0, space = 0, punct = 0;
+    u64 h;
+    if (s == NULL || len <= 0)
+        return 0;
+    for (i = 0; i < len; i++) {
+        unsigned char c = (unsigned char)s[i];
+        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+            (c >= '0' && c <= '9'))
+            alnum++;
+        else if (c == ' ' || c == '\t' || c == '\n')
+            space++;
+        else
+            punct++;
+    }
+    h = omni_hash(s, len);
+    int base = (int)((alnum * 100ULL) / (u64)(len > 0 ? len : 1));
+    int spread = (int)(h % 23ULL);             /* stable per-content jitter */
+    int score = base / 2 + (space > 0 ? 22 : 8) + (punct > 2 ? 6 : 2) + spread;
+    if (score > 100)
+        score = 100;
+    if (score < 0)
+        score = 0;
+    return score;
+}
+
+/* Seed-driven micro text generation: splits a 64-bit PRNG stream     */
+/* into syllables. Writes at most max_len-1 chars + NUL. Returns      */
+/* number of characters written.                                      */
+static const char *SYL_A[] = {"ka", "ro", "mi", "ve", "du", "sa", "ne",
+                              "tu", "li", "or"};
+static const char *SYL_B[] = {"zen", "vak", "rim", "tol", "nex", "qua",
+                              "dri", "sol", "fen", "bor"};
+static const char *SYL_C[] = {"ax", "os", "ir", "ul", "ek", "ay",
+                              "on", "is", "ar", "um"};
+
+int omni_generate(u64 seed, char *out, int max_len)
+{
+    int written = 0;
+    int words, w, part;
+    u64 st = seed ? seed : 88172645463325252ULL;
+
+    if (out == NULL || max_len <= 1)
+        return 0;
+
+    words = 4 + (int)(st % 5ULL);              /* 4..8 words */
+    for (w = 0; w < words && written < max_len - 14; w++) {
+        /* xorshift64* step */
+        st ^= st >> 12;
+        st ^= st << 25;
+        st ^= st >> 27;
+        st *= 2685821657736338717ULL;
+
+        part = (int)((st >> 8) % 3ULL);
+        if (part == 0) {
+            const char *a = SYL_A[(st >> 16) % 10ULL];
+            const char *b = SYL_B[(st >> 24) % 10ULL];
+            int la = (int)strlen(a), lb = (int)strlen(b), k;
+            for (k = 0; k < la; k++) out[written++] = a[k];
+            for (k = 0; k < lb; k++) out[written++] = b[k];
+        } else if (part == 1) {
+            const char *b = SYL_B[(st >> 16) % 10ULL];
+            const char *c = SYL_C[(st >> 24) % 10ULL];
+            int lb = (int)strlen(b), lc = (int)strlen(c), k;
+            for (k = 0; k < lb; k++) out[written++] = b[k];
+            for (k = 0; k < lc; k++) out[written++] = c[k];
+        } else {
+            const char *a = SYL_A[(st >> 16) % 10ULL];
+            const char *c = SYL_C[(st >> 24) % 10ULL];
+            int la = (int)strlen(a), lc = (int)strlen(c), k;
+            for (k = 0; k < la; k++) out[written++] = a[k];
+            for (k = 0; k < lc; k++) out[written++] = c[k];
+        }
+        if (w < words - 1 && written < max_len - 1)
+            out[written++] = ' ';
+    }
+    out[written] = '\0';
+    return written;
+}
