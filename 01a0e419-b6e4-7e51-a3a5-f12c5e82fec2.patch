+"""🎖️ COMPUTE-COMMANDER :: autonomous HPC offload & remote GPU control.
+
+A dedicated sub-agent with its own lightweight reasoning brain
+(deterministic tool-execution model built on the C99 engine + intent
+parser) whose sole mission is to keep heavy compute OFF the local cores:
+
+1. **Interception middleware** — render / scrape / tune / embed tasks are
+   classified by weight and diverted to remote nodes instead of choking
+   the swarm's local CPU/GPU.
+2. **Remote pool** — simulated Kaggle/Colab free-tier GPUs + cloud pools;
+   the commander provisions a container runtime, injects the execution
+   script and maps the data stream back (all receipts are simulated, the
+   app stays native-safe).
+3. **Bidirectional control + telemetry bridge** — power on/off/restart/
+   scale via RPC, and a 120 s telemetry cycle syncing load/temp/power of
+   every node into the DBAL.
+"""
+
+from __future__ import annotations
+
+import os
+import random
+import re
+import sqlite3
+import threading
+from typing import Any, Dict, List, Optional, Tuple
+
+from .c99_bridge import C99
+from .state import STATE, now_iso, uid
+
+DB_PATH = os.environ.get(
+    "OMNI_COMPUTE_DB", os.path.expanduser("~/.omnihack/vault/compute.db"))
+
+HEAVY_KINDS = {"render", "scrape", "tune", "train", "embed", "encode"}
+HEAVY_THRESHOLD = 55  # weight >= → offload
+
+
+# --------------------------------------------------------------------------- #
+# Remote node pool (Kaggle / Colab free tiers + cloud pools + remote CPUs)
+# --------------------------------------------------------------------------- #
+def _seed_pool() -> Dict[str, Dict[str, Any]]:
+    return {
+        "KAGGLE-GPU-1": {"provider": "kaggle", "kind": "GPU NODE",
+                          "chip": "2x T4 16GB", "vram_gb": 32, "status": "IDLE",
+                          "load": 4, "temp": 41, "power_w": 145,
+                          "queue": [], "note": "free tier · 30h/week quota"},
+        "KAGGLE-GPU-2": {"provider": "kaggle", "kind": "GPU NODE",
+                          "chip": "2x P100 16GB", "vram_gb": 32, "status": "IDLE",
+                          "load": 2, "temp": 39, "power_w": 160,
+                          "queue": [], "note": "free tier · notebook runtime"},
+        "COLAB-T4": {"provider": "colab", "kind": "GPU NODE",
+                      "chip": "1x T4 15GB", "vram_gb": 15, "status": "IDLE",
+                      "load": 6, "temp": 44, "power_w": 120,
+                      "queue": [], "note": "free tier · session keep-alive"},
+        "CLOUD-POOL-1": {"provider": "cloud", "kind": "GPU POOL",
+                          "chip": "4x A10G 24GB", "vram_gb": 96, "status": "IDLE",
+                          "load": 12, "temp": 47, "power_w": 640,
+                          "queue": [], "note": "spot pool · auto-scale 0-4"},
+        "CLOUD-POOL-2": {"provider": "cloud", "kind": "GPU POOL",
+                          "chip": "2x L4 24GB", "vram_gb": 48, "status": "OFF",
+                          "load": 0, "temp": 30, "power_w": 0,
+                          "queue": [], "note": "scale-to-zero enabled"},
+        "REMOTE-CPU-1": {"provider": "remote", "kind": "CPU CLUSTER",
+                          "chip": "64c EPYC", "vram_gb": 0, "status": "IDLE",
+                          "load": 18, "temp": 52, "power_w": 310,
+                          "queue": [], "note": "scrape/etl farm"},
+    }
+
+
+# --------------------------------------------------------------------------- #
+class NeuralBrain:
+    """Lightweight reasoning model (deterministic tool-execution brain).
+
+    Parses natural-language operator commands into structured infra actions
+    and emits a reasoning trace — no live LLM required.
+    """
+
+    PATTERNS: List[Tuple[str, re.Pattern]] = [
+        ("allocate", re.compile(r"(?i)\b(allocate|provision|assign|give)\b")),
+        ("shift", re.compile(r"(?i)\b(shift|move|migrate|transfer)\b")),
+        ("power-off", re.compile(r"(?i)\b(power\s*off|shutdown|stop node|halt)\b")),
+        ("power-on", re.compile(r"(?i)\b(power\s*on|start node|boot|wake)\b")),
+        ("restart", re.compile(r"(?i)\b(restart|reboot|recycle)\b")),
+        ("scale", re.compile(r"(?i)\b(scale|resize|autoscale)\b")),
+        ("status", re.compile(r"(?i)\b(status|report|telemetry|health)\b")),
+        ("rebalance", re.compile(r"(?i)\b(rebalance|balance|optimise|optimize)\b")),
+    ]
+    TASK_HINTS = [
+        ("render", re.compile(r"(?i)\b(render|ffmpeg|video|encode)\b")),
+        ("scrape", re.compile(r"(?i)\b(scrape|crawl|harvest)\b")),
+        ("tune", re.compile(r"(?i)\b(tune|train|finetune|fine-tune|lora)\b")),
+        ("embed", re.compile(r"(?i)\b(embed|vector|embedding)\b")),
+    ]
+
+    def think(self, text: str) -> Dict[str, Any]:
+        text = (text or "").strip()
+        if not text:
+            return {"ok": False, "error": "empty command", "intent": "none"}
+        intent = "status"
+        for name, pat in self.PATTERNS:
+            if pat.search(text):
+                intent = name
+                break
+        task = next((t for t, p in self.TASK_HINTS if p.search(text)), "render")
+        # node extraction: known pool names or "node <n>" / "pool <n>"
+        node = None
+        up = text.upper()
+        for key in _seed_pool():
+            if key in up or key.split("-")[0] + " " + key.split("-")[-1] in up:
+                node = key
+                break
+        m = re.search(r"(?i)\b(?:node|pool|rig)\s*[-#]?\s*(\d)", text)
+        if m and not node:
+            idx = int(m.group(1))
+            hint = None
+            for provider in ("cloud", "kaggle", "colab", "remote", "cpu"):
+                if provider in text.lower():
+                    hint = provider
+                    break
+            keys = sorted(k for k, v in _seed_pool().items()
+                          if hint is None or v["provider"] == hint
+                          or (hint == "cpu" and v["kind"] == "CPU CLUSTER"))
+            if keys:
+                node = keys[min(idx, len(keys)) - 1]
+        confidence = C99.score(text)
+        trace = (f"brain[cc-7b] ▸ parse intent='{intent}' task='{task}' "
+                 f"node={node or 'auto'} conf={confidence}")
+        return {"ok": True, "intent": intent, "task": task, "node": node,
+                "confidence": confidence, "trace": trace}
+
+
+# --------------------------------------------------------------------------- #
+class ComputeCommander:
+    """Daemon + router + RPC control surface for the remote compute pool."""
+
+    def __init__(self, db_path: Optional[str] = None) -> None:
+        self.db_path = db_path or DB_PATH
+        self.lock = threading.RLock()
+        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
+        self.pool = _seed_pool()
+        self.brain = NeuralBrain()
+        self._rnd = random.Random(9001)
+        self.offloaded = 0
+        self.local_kept = 0
+        self.telemetry_cycles = 0
+        self._init_db()
+
+    # ------------------------------------------------------------------ db
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.db_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS compute_telemetry (
+                ts TEXT, node TEXT, status TEXT, load INTEGER,
+                temp INTEGER, power_w INTEGER, queued INTEGER);
+            CREATE TABLE IF NOT EXISTS offload_log (
+                ts TEXT, task TEXT, kind TEXT, weight INTEGER,
+                node TEXT, decision TEXT);
+            """)
+
+    # ------------------------------------------------------ interception
+    def classify_weight(self, kind: str, size_hint: int = 50) -> int:
+        kind = (kind or "").strip().lower()
+        base = 70 if kind in HEAVY_KINDS else 20
+        return max(1, min(100, base + (int(size_hint) % 30)))
+
+    def intercept(self, task_desc: str, kind: str = "",
+                  size_hint: int = 50) -> Dict[str, Any]:
+        """Interception middleware: heavy → remote node, light → local."""
+        kind = (kind or "").strip().lower()
+        if not kind:
+            low = (task_desc or "").lower()
+            kind = next((k for k in HEAVY_KINDS if k in low), "misc")
+        weight = self.classify_weight(kind, size_hint)
+        if weight < HEAVY_THRESHOLD:
+            self.local_kept += 1
+            decision = "LOCAL (below threshold)"
+            with self.lock, self._conn() as conn:
+                conn.execute("INSERT INTO offload_log (ts, task, kind, weight,"
+                             " node, decision) VALUES (?,?,?,?,?,?)",
+                             (now_iso(), (task_desc or "")[:80], kind, weight,
+                              "LOCAL", decision))
+            return {"ok": True, "decision": "local", "weight": weight,
+                    "node": None, "reason": "light task stays on local cores"}
+
+        node_id, node = self._pick_node(kind)
+        if not node:
+            decision = "QUEUED (all nodes busy)"
+            with self.lock, self._conn() as conn:
+                conn.execute("INSERT INTO offload_log (ts, task, kind, weight,"
+                             " node, decision) VALUES (?,?,?,?,?,?)",
+                             (now_iso(), (task_desc or "")[:80], kind, weight,
+                              "QUEUE", decision))
+            return {"ok": True, "decision": "queued", "weight": weight,
+                    "node": None, "reason": "pool saturated — task queued"}
+
+        node["status"] = "BUSY"
+        node["load"] = min(100, node["load"] + weight // 2)
+        node["queue"].append(task_desc or kind)
+        self.offloaded += 1
+        receipt = {
+            "ok": True, "decision": "offload", "weight": weight, "node": node_id,
+            "container": uid("ctr"),
+            "image": {"render": "omnihack/ffmpeg-farm:1.9",
+                      "scrape": "omnihack/stealth-scraper:2.4",
+                      "tune": "omnihack/lora-tuner:0.9",
+                      "embed": "omnihack/embed-worker:1.3"}.get(kind, "omnihack/worker:1.0"),
+            "script": f"/inject/{kind}-{uid('scr')}.py",
+            "stream_map": f"ws://relay/{node_id.lower()}/stream",
+            "reason": f"weight {weight} ≥ {HEAVY_THRESHOLD} → {node_id} "
+                      f"({node['chip']}, {node['provider']})",
+        }
+        with self.lock, self._conn() as conn:
+            conn.execute("INSERT INTO offload_log (ts, task, kind, weight,"
+                         " node, decision) VALUES (?,?,?,?,?,?)",
+                         (now_iso(), (task_desc or "")[:80], kind, weight,
+                          node_id, "OFFLOAD"))
+        STATE.log("OK", "COMPUTE",
+                  f"Intercepted '{kind}' (w={weight}) → OFFLOADED to {node_id}.")
+        return receipt
+
+    def _pick_node(self, kind: str) -> Tuple[Optional[str], Optional[Dict[str, Any]]]:
+        pref = ("cloud", "kaggle", "colab", "remote") if kind in ("render", "tune", "embed") \
+            else ("remote", "cloud", "kaggle", "colab")
+        for provider in pref:
+            candidates = [(k, n) for k, n in self.pool.items()
+                          if n["provider"] == provider and n["status"] == "IDLE"
+                          and (n["vram_gb"] > 0 or kind in ("scrape", "misc"))]
+            if candidates:
+                return min(candidates, key=lambda kv: kv[1]["load"])
+        idle = [(k, n) for k, n in self.pool.items() if n["status"] == "IDLE"
+                and (n["vram_gb"] > 0 or kind in ("scrape", "misc"))]
+        return min(idle, key=lambda kv: kv[1]["load"]) if idle else (None, None)
+
+    # ------------------------------------------------------------ RPC control
+    def power_control(self, node_id: str, action: str,
+                      value: Optional[int] = None) -> Dict[str, Any]:
+        node = self.pool.get((node_id or "").upper())
+        if not node:
+            return {"ok": False, "error": f"unknown node '{node_id}'",
+                    "nodes": sorted(self.pool)}
+        action = (action or "").strip().lower()
+        if action == "on":
+            node["status"] = "IDLE"
+            node["power_w"] = max(node["power_w"], 90)
+        elif action == "off":
+            node["status"] = "OFF"
+            node["load"], node["power_w"] = 0, 0
+        elif action == "restart":
+            node["status"] = "IDLE"
+            node["load"] = 0
+            node["queue"] = []
+        elif action == "scale":
+            target = max(0, min(100, int(50 if value is None else value)))
+            if target == 0:
+                node["status"], node["load"], node["power_w"] = "OFF", 0, 0
+            else:
+                node["status"] = "IDLE" if node["status"] == "OFF" else node["status"]
+                node["load"] = target
+                node["power_w"] = int(60 + target * 4)
+        else:
+            return {"ok": False, "error": f"unknown action '{action}'",
+                    "actions": ["on", "off", "restart", "scale"]}
+        STATE.log("INFO", "COMPUTE", f"RPC {node_id} :: {action}"
+                  + (f" → {value}" if action == "scale" else ""))
+        return {"ok": True, "node": node_id, "action": action,
+                "status": node["status"], "load": node["load"],
+                "power_w": node["power_w"]}
+
+    def node_rows(self) -> List[List[str]]:
+        return [[k, n["provider"], n["chip"], n["status"], f"{n['load']}%",
+                 f"{n['temp']}°C", f"{n['power_w']}W", str(len(n["queue"]))]
+                for k, n in self.pool.items()]
+
+    # ---------------------------------------------------------- chat channel
+    def chat(self, history: List[Dict[str, str]], message: str) -> Tuple[List[Dict[str, str]], str]:
+        """Dedicated operator chat channel: NL command → infra action."""
+        history = list(history or [])
+        text = (message or "").strip()
+        if not text:
+            return history, ""
+        thought = self.brain.think(text)
+        if not thought.get("ok"):
+            reply = "🎖️ COMMANDER: No command detected. Try 'Allocate free GPU for video render pipeline'."
+            history += [{"role": "user", "content": text},
+                        {"role": "assistant", "content": reply}]
+            return history, ""
+        intent = thought["intent"]
+        if intent == "allocate":
+            res = self.intercept(f"operator: {text}", kind=thought["task"],
+                                 size_hint=thought["confidence"])
+            reply = self._receipt_line("ALLOCATE", res)
+        elif intent == "shift":
+            target = thought["node"] or self._pick_node(thought["task"])[0]
+            if not target:
+                reply = "🎖️ COMMANDER: No idle node available for the shift."
+            else:
+                self.pool[target]["load"] = min(100, self.pool[target]["load"] + 25)
+                reply = (f"🎖️ COMMANDER: Load shifted to **{target}** "
+                         f"({self.pool[target]['chip']}, now "
+                         f"{self.pool[target]['load']}% load).")
+        elif intent in ("power-on", "power-off", "restart"):
+            target = thought["node"] or sorted(self.pool)[0]
+            act = {"power-on": "on", "power-off": "off", "restart": "restart"}[intent]
+            res = self.power_control(target, act)
+            reply = (f"🎖️ COMMANDER: {target} → {res.get('status', '?')} "
+                     f"(load {res.get('load', '?')}%, {res.get('power_w', '?')}W)."
+                     if res["ok"] else f"🎖️ COMMANDER: {res['error']}")
+        elif intent == "scale":
+            target = thought["node"] or "CLOUD-POOL-1"
+            m = re.search(r"(\d{1,3})", text)
+            res = self.power_control(target, "scale", int(m.group(1)) if m else 50)
+            reply = (f"🎖️ COMMANDER: {target} scaled → load {res.get('load')}% "
+                     f"({res.get('power_w')}W)." if res["ok"]
+                     else f"🎖️ COMMANDER: {res['error']}")
+        elif intent == "rebalance":
+            for n in self.pool.values():
+                if n["status"] == "BUSY" and not n["queue"]:
+                    n["status"] = "IDLE"
+                    n["load"] = max(5, n["load"] - 30)
+            reply = "🎖️ COMMANDER: Pool rebalanced — busy nodes without queue returned to IDLE."
+        else:  # status
+            busy = sum(1 for n in self.pool.values() if n["status"] == "BUSY")
+            idle = sum(1 for n in self.pool.values() if n["status"] == "IDLE")
+            off = sum(1 for n in self.pool.values() if n["status"] == "OFF")
+            reply = (f"🎖️ COMMANDER: pool status — {idle} idle · {busy} busy · "
+                     f"{off} off · {self.offloaded} offloads, "
+                     f"{self.local_kept} kept local.")
+        reply += f"\n`{thought['trace']}`"
+        history += [{"role": "user", "content": text},
+                    {"role": "assistant", "content": reply}]
+        STATE.log("INFO", "COMPUTE", f"Chat cmd :: '{text[:50]}' → {intent}")
+        return history, ""
+
+    @staticmethod
+    def _receipt_line(label: str, res: Dict[str, Any]) -> str:
+        if res.get("decision") == "offload":
+            return (f"🎖️ COMMANDER {label}: task offloaded → **{res['node']}** · "
+                    f"container `{res['container']}` · image `{res['image']}` · "
+                    f"stream `{res['stream_map']}`.")
+        if res.get("decision") == "queued":
+            return "🎖️ COMMANDER: pool saturated — task queued for the next free node."
+        return f"🎖️ COMMANDER: task stays local (weight {res.get('weight')})."
+
+    # ------------------------------------------------------- telemetry bridge
+    def telemetry_cycle(self) -> Dict[str, Any]:
+        """120 s sync: sample every node → central DBAL + bus."""
+        rows = []
+        for name, n in self.pool.items():
+            if n["status"] != "OFF":
+                drift = self._rnd.randint(-4, 6)
+                n["load"] = max(0, min(100, n["load"] + drift))
+                n["temp"] = 35 + n["load"] // 3 + self._rnd.randint(0, 4)
+                n["power_w"] = int(60 + n["load"] * 4 + self._rnd.randint(0, 25))
+                if n["status"] == "BUSY" and n["queue"] and self._rnd.random() < 0.4:
+                    n["queue"].pop(0)
+                    if not n["queue"]:
+                        n["status"] = "IDLE"
+                        n["load"] = max(5, n["load"] - 35)
+            rows.append((now_iso(), name, n["status"], n["load"], n["temp"],
+                         n["power_w"], len(n["queue"])))
+        with self.lock, self._conn() as conn:
+            conn.executemany("INSERT INTO compute_telemetry (ts, node, status,"
+                             " load, temp, power_w, queued) VALUES (?,?,?,?,?,?,?)",
+                             rows)
+        self.telemetry_cycles += 1
+        total_w = sum(r[5] for r in rows)
+        STATE.log("INFO", "COMPUTE",
+                  f"Telemetry cycle #{self.telemetry_cycles} :: "
+                  f"{len(rows)} nodes · {total_w}W total draw.")
+        return {"cycle": self.telemetry_cycles, "nodes": len(rows),
+                "total_w": total_w}
+
+    # ------------------------------------------------------------ telemetry
+    def stats(self) -> Dict[str, Any]:
+        with self.lock, self._conn() as conn:
+            n_tel = conn.execute("SELECT COUNT(*) c FROM compute_telemetry").fetchone()["c"]
+            n_off = conn.execute("SELECT COUNT(*) c FROM offload_log").fetchone()["c"]
+        return {"nodes": len(self.pool),
+                "idle": sum(1 for n in self.pool.values() if n["status"] == "IDLE"),
+                "busy": sum(1 for n in self.pool.values() if n["status"] == "BUSY"),
+                "off": sum(1 for n in self.pool.values() if n["status"] == "OFF"),
+                "offloaded": self.offloaded, "local_kept": self.local_kept,
+                "telemetry_cycles": self.telemetry_cycles,
+                "telemetry_rows": n_tel, "offload_rows": n_off,
+                "total_power_w": sum(n["power_w"] for n in self.pool.values())}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return (f"[COMPUTE] {s['idle']} idle/{s['busy']} busy/{s['off']} off · "
+                f"offloads {s['offloaded']} · {s['total_power_w']}W")
+
+
+COMMANDER = ComputeCommander()
