@@ -0,0 +1,258 @@
+"""🖼️ STREAM BRIDGE :: multi-stream grid control plane (WebSocket/RPC sim).
+
+Lightweight asynchronous control plane that attaches to every sub-agent
+workspace / notebook / browser-use instance and streams telemetry + frames
+to the Stream Wall UI, with **bidirectional injection** (clicks, keys,
+scroll) back to the remote instance.  All transports are simulated
+(WS-binary / MJPEG receipts) so the suite runs natively.
+
+Performance guard
+-----------------
+* focused (maximized) session → **30 FPS**
+* background thumbnails       → **2–5 FPS** (dynamic, budget-capped)
+* total FPS budget across the wall is enforced by ``throttle_cycle()``
+* frame payloads carry a compressed-size estimate (binary WS frames)
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import random
+import sqlite3
+import threading
+from typing import Any, Dict, List, Optional
+
+from .state import STATE, now_iso, uid
+
+DB_PATH = os.environ.get(
+    "OMNI_STREAM_DB", os.path.expanduser("~/.omnihack/vault/streams.db"))
+
+FPS_FOCUSED = 30
+FPS_BACKGROUND_MAX = 5
+FPS_IDLE = 2
+FPS_BUDGET = 45           # total fps allowed across all sessions
+KINDS = ["subagent-notebook", "jupyter", "colab", "browser-use"]
+STEALTH_PROFILES = ["GHOST-9", "PHANTOM-3", "CIVILIAN-1", "SPECTRE-7"]
+
+
+class StreamSession:
+    def __init__(self, session_id: str, kind: str, agent: str, node: str) -> None:
+        self.session_id = session_id
+        self.kind = kind
+        self.agent = agent
+        self.node = node
+        self.state = "ACTIVE"            # ACTIVE | FOCUSED | DETACHED
+        self.fps = FPS_IDLE
+        self.fps_target = FPS_IDLE
+        self.stealth = random.choice(STEALTH_PROFILES)
+        self.cpu = random.randint(6, 38)
+        self.gpu = random.randint(0, 44) if kind == "browser-use" else 0
+        self.frames = 0
+        self.bytes_streamed = 0
+        self.mouse = (random.randint(120, 900), random.randint(90, 520))
+        self.last_event = "attached"
+        self.created = now_iso()
+        self._rnd = random.Random(session_id.encode().hex()[:8])
+
+    def frame(self) -> Dict[str, Any]:
+        """One simulated compressed frame (binary WS payload estimate)."""
+        self.frames += 1
+        w, h = (1280, 720) if self.state == "FOCUSED" else (320, 180)
+        size = int(w * h * 0.09 * (0.7 + self._rnd.random() * 0.6))
+        self.bytes_streamed += size
+        self.mouse = (max(0, min(w, self.mouse[0] + self._rnd.randint(-24, 24))),
+                      max(0, min(h, self.mouse[1] + self._rnd.randint(-18, 18))))
+        dom_hash = hashlib.md5(
+            f"{self.session_id}:{self.frames}".encode()).hexdigest()[:10]
+        return {"session_id": self.session_id, "seq": self.frames,
+                "fps": self.fps, "resolution": f"{w}x{h}",
+                "bytes": size, "dom_hash": dom_hash,
+                "mouse": self.mouse, "transport": "ws-binary",
+                "encoding": "mjpeg-q7" if self.state != "FOCUSED" else "mjpeg-q9",
+                "ts": now_iso()}
+
+
+class StreamBridge:
+    """Control plane: attach / focus / throttle / inject / detach."""
+
+    def __init__(self, db_path: Optional[str] = None) -> None:
+        self.db_path = db_path or DB_PATH
+        self.lock = threading.RLock()
+        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
+        self.sessions: Dict[str, StreamSession] = {}
+        self.focused: Optional[str] = None
+        self.throttle_cycles = 0
+        self.injections = 0
+        self._init_db()
+
+    # ------------------------------------------------------------------ db
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.db_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.execute("""
+            CREATE TABLE IF NOT EXISTS stream_events (
+                ts TEXT, session TEXT, event TEXT, detail TEXT)""")
+
+    def _log(self, session: str, event: str, detail: str = "") -> None:
+        with self.lock, self._conn() as conn:
+            conn.execute("INSERT INTO stream_events (ts, session, event, detail)"
+                         " VALUES (?,?,?,?)", (now_iso(), session, event, detail))
+
+    # -------------------------------------------------------------- attach
+    def attach(self, kind: str, agent: str = "—",
+               node: str = "LOCAL") -> Dict[str, Any]:
+        kind = (kind or "").strip().lower()
+        if kind not in KINDS:
+            return {"ok": False, "error": f"unknown stream kind '{kind}'",
+                    "kinds": KINDS}
+        sid = uid("str")
+        self.sessions[sid] = StreamSession(sid, kind, agent or "—", node or "LOCAL")
+        self._log(sid, "attach", f"{kind}@{node} agent={agent}")
+        STATE.log("OK", "STREAMS", f"Attached {kind} :: {sid} on {node}.")
+        return {"ok": True, "session_id": sid, "kind": kind, "node": node,
+                "endpoint": f"wss://bridge/{sid}", "transport": "ws-binary"}
+
+    def detach(self, session_id: str) -> str:
+        s = self.sessions.pop((session_id or "").strip(), None)
+        if not s:
+            return "⚠️ Unknown session."
+        if self.focused == session_id:
+            self.focused = None
+        self._log(session_id, "detach", "")
+        STATE.log("INFO", "STREAMS", f"Detached {session_id}.")
+        return f"🔌 Session {session_id} detached."
+
+    # --------------------------------------------------------------- focus
+    def focus(self, session_id: str) -> Dict[str, Any]:
+        s = self.sessions.get((session_id or "").strip())
+        if not s:
+            return {"ok": False, "error": f"unknown session '{session_id}'",
+                    "sessions": sorted(self.sessions)}
+        if self.focused and self.focused in self.sessions:
+            self.sessions[self.focused].state = "ACTIVE"
+        s.state = "FOCUSED"
+        self.focused = session_id
+        self.throttle_cycle()
+        self._log(session_id, "focus", "maximized in viewport")
+        return {"ok": True, "session_id": session_id, "fps_target": FPS_FOCUSED,
+                "note": "background streams throttled to 2-5 fps (not dropped)"}
+
+    def unfocus(self) -> str:
+        if self.focused and self.focused in self.sessions:
+            self.sessions[self.focused].state = "ACTIVE"
+            self._log(self.focused, "unfocus", "")
+        self.focused = None
+        self.throttle_cycle()
+        return "🪟 Viewport cleared — all streams back to thumbnail rate."
+
+    # ------------------------------------------------------- throttle guard
+    def throttle_cycle(self) -> Dict[str, Any]:
+        """Dynamic FPS budget: focused=30, background capped, total ≤ budget."""
+        live = [s for s in self.sessions.values()]
+        if self.focused and self.focused in self.sessions:
+            f = self.sessions[self.focused]
+            f.fps_target = FPS_FOCUSED
+            rest = FPS_BUDGET - FPS_FOCUSED
+            others = [s for s in live if s.session_id != self.focused]
+            per = min(FPS_BACKGROUND_MAX, max(FPS_IDLE, rest // max(len(others), 1)))
+            for s in others:
+                s.fps_target = per
+        else:
+            per = min(FPS_BACKGROUND_MAX,
+                      max(FPS_IDLE, FPS_BUDGET // max(len(live), 1)))
+            for s in live:
+                s.fps_target = per
+        for s in live:  # drift toward target (simulated ramp)
+            s.fps = s.fps_target
+            s.cpu = max(2, min(96, s.cpu + random.randint(-5, 6)))
+        self.throttle_cycles += 1
+        return {"cycle": self.throttle_cycles, "sessions": len(live),
+                "total_fps": sum(s.fps for s in live),
+                "focused": self.focused}
+
+    # --------------------------------------------------------------- frames
+    def frame(self, session_id: str) -> Dict[str, Any]:
+        s = self.sessions.get((session_id or "").strip())
+        if not s:
+            return {"ok": False, "error": f"unknown session '{session_id}'"}
+        return {"ok": True, **s.frame()}
+
+    # ------------------------------------------------------------- injection
+    def inject(self, session_id: str, action: str,
+               x: int = 0, y: int = 0, payload: str = "") -> Dict[str, Any]:
+        """Bidirectional control: click / key / scroll back to the instance."""
+        s = self.sessions.get((session_id or "").strip())
+        if not s:
+            return {"ok": False, "error": f"unknown session '{session_id}'",
+                    "sessions": sorted(self.sessions)}
+        action = (action or "").strip().lower()
+        if action == "click":
+            s.mouse = (max(0, int(x)), max(0, int(y)))
+            detail = f"click@{s.mouse}"
+        elif action == "key":
+            if not payload:
+                return {"ok": False, "error": "key injection needs payload text"}
+            detail = f"key:{payload[:40]}"
+        elif action == "scroll":
+            detail = f"scrollΔ{int(x)}"
+        else:
+            return {"ok": False, "error": f"unknown action '{action}'",
+                    "actions": ["click", "key", "scroll"]}
+        s.last_event = detail
+        self.injections += 1
+        self._log(session_id, "inject", detail)
+        latency = random.randint(9, 42)
+        STATE.log("INFO", "STREAMS", f"Injected {detail} → {session_id} ({latency}ms).")
+        return {"ok": True, "session_id": session_id, "action": action,
+                "detail": detail, "ack_latency_ms": latency,
+                "echo": "remote instance acknowledged"}
+
+    # ------------------------------------------------------------ reporting
+    def session_cards(self) -> List[Dict[str, Any]]:
+        out = []
+        for s in self.sessions.values():
+            out.append({"session_id": s.session_id, "kind": s.kind,
+                        "agent": s.agent, "node": s.node, "state": s.state,
+                        "fps": s.fps, "stealth": s.stealth,
+                        "cpu": s.cpu, "gpu": s.gpu, "frames": s.frames,
+                        "kb_streamed": s.bytes_streamed // 1024})
+        return out
+
+    def stats(self) -> Dict[str, Any]:
+        live = list(self.sessions.values())
+        with self.lock, self._conn() as conn:
+            n_ev = conn.execute("SELECT COUNT(*) c FROM stream_events").fetchone()["c"]
+        return {"sessions": len(live), "focused": self.focused,
+                "total_fps": sum(s.fps for s in live),
+                "fps_budget": FPS_BUDGET,
+                "kb_streamed": sum(s.bytes_streamed for s in live) // 1024,
+                "injections": self.injections,
+                "throttle_cycles": self.throttle_cycles,
+                "events_db": n_ev}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return (f"[STREAMS] {s['sessions']} sessions · {s['total_fps']}/"
+                f"{s['fps_budget']} fps · focus={s['focused'] or '—'}")
+
+
+BRIDGE = StreamBridge()
+
+
+def seed_streams() -> None:
+    """Populate the wall so every card is live from the first frame."""
+    if BRIDGE.sessions:
+        return
+    BRIDGE.attach("browser-use", agent="OMNI-PRIME", node="LOCAL")
+    BRIDGE.attach("subagent-notebook", agent="MINION-01", node="KAGGLE-GPU-1")
+    BRIDGE.attach("jupyter", agent="MINION-03", node="REMOTE-CPU-1")
+    BRIDGE.attach("colab", agent="MINION-07", node="COLAB-T4")
+    BRIDGE.throttle_cycle()
+
+
+seed_streams()
