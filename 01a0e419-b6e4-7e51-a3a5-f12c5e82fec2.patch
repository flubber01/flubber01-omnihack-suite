+#!/usr/bin/env python3
+"""🛠️ HERMES CORE INIT :: pre-flight checks + model binding + gateway hooks.
+
+Run before first launch to verify the environment, bind the primary
+reasoning engine and confirm gateway readiness::
+
+    python3 hermes_core_init.py                 # full pre-flight report
+    python3 hermes_core_init.py --bind openrouter mistralai/mistral-nemo:free
+    python3 hermes_core_init.py --bind local local-model:latest
+
+The bound engine is written to ``~/.hermes/config.json`` and picked up by
+Mission Control, the Telegram gateway and the Compute-Commander brain.
+
+Security note: this script does **not** touch antivirus or OS security
+settings.  If your AV flags a sandboxed interpreter, configure exclusions
+manually through your OS security UI (Windows Security → Virus & threat
+protection → Exclusions) after verifying file checksums yourself.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib
+import os
+import sqlite3
+import sys
+
+OK, WARN, FAIL = "✅", "⚠️ ", "❌"
+RESULTS: list[tuple[str, str, str]] = []  # (icon, name, detail)
+
+
+def check(name: str, fn) -> None:
+    try:
+        detail = fn()
+        icon = FAIL if isinstance(detail, tuple) else OK
+        if isinstance(detail, tuple):
+            icon, detail = detail
+        RESULTS.append((icon, name, detail))
+    except Exception as exc:  # noqa: BLE001 — report, never crash
+        RESULTS.append((FAIL, name, f"{type(exc).__name__}: {exc}"))
+
+
+# ------------------------------------------------------------------ checks
+def c_python() -> str:
+    if sys.version_info < (3, 10):
+        return (FAIL, f"Python {sys.version.split()[0]} — need ≥3.10")
+    return f"Python {sys.version.split()[0]}"
+
+
+def c_deps() -> str:
+    missing = []
+    for mod in ("gradio", "numpy", "requests", "psutil"):
+        try:
+            importlib.import_module(mod)
+        except ImportError:
+            missing.append(mod)
+    if missing:
+        return (FAIL, "missing: " + ", ".join(missing)
+                + " → bash install.sh")
+    return "gradio, numpy, requests, psutil importable"
+
+
+def c_sqlite() -> str:
+    conn = sqlite3.connect(":memory:")
+    conn.execute("CREATE VIRTUAL TABLE t USING fts5(x)")
+    conn.close()
+    return f"sqlite {sqlite3.sqlite_version} + FTS5"
+
+
+def c_vault() -> str:
+    vault = os.path.expanduser("~/.omnihack/vault")
+    os.makedirs(vault, exist_ok=True)
+    probe = os.path.join(vault, ".write_probe")
+    with open(probe, "w", encoding="utf-8") as fh:
+        fh.write("1")
+    os.remove(probe)
+    return f"writable :: {vault}"
+
+
+def c_modules() -> str:
+    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+    for mod in ("mission_control.core.state",
+                "mission_control.core.dbal_engine",
+                "mission_control.core.sync_heartbeat",
+                "mission_control.core.prompt_router",
+                "mission_control.core.model_binding"):
+        importlib.import_module(mod)
+    return "state, dbal_engine, sync_heartbeat, prompt_router, model_binding"
+
+
+def c_model() -> str:
+    from mission_control.core.model_binding import MODEL
+    cfg = MODEL.load()
+    if not cfg.get("provider"):
+        return (WARN, "no model bound — run: python3 hermes_core_init.py "
+                      "--bind <provider> [model] [endpoint]")
+    probe = MODEL.probe()
+    return f"{cfg.get('provider')}/{cfg.get('model')} :: {probe['reachability']}"
+
+
+def c_gateways() -> str:
+    cfg_path = os.path.expanduser("~/.omnihack/gateway.json")
+    if os.path.exists(cfg_path):
+        return f"gateway config present :: {cfg_path}"
+    return (WARN, "no gateway config — Telegram/Discord hooks will run in "
+                  "loopback mode until configured")
+
+
+# ------------------------------------------------------------------- main
+def preflight() -> int:
+    print("=" * 62)
+    print("  HERMES CORE INIT :: OMNIHACK SUITE PRE-FLIGHT")
+    print("=" * 62)
+    check("Python runtime", c_python)
+    check("Dependencies", c_deps)
+    check("SQLite / FTS5", c_sqlite)
+    check("Vault writability", c_vault)
+    check("Core modules", c_modules)
+    check("Model binding", c_model)
+    check("Gateway hooks", c_gateways)
+    width = max(len(n) for _, n, _ in RESULTS)
+    failures = 0
+    for icon, name, detail in RESULTS:
+        if icon == FAIL:
+            failures += 1
+        print(f"  {icon} {name:<{width}}  {detail}")
+    print("-" * 62)
+    print(f"  RESULT :: {'CLEAR FOR LAUNCH' if failures == 0 else str(failures) + ' ITEM(S) NEED ATTENTION'}")
+    return 0 if failures == 0 else 1
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="OMNIHACK pre-flight + model binding")
+    ap.add_argument("--bind", nargs="+", metavar="ARG",
+                    help="bind model: --bind <local|openrouter|custom> "
+                         "[model] [endpoint] [API_KEY_ENV_VAR]")
+    ap.add_argument("--status", action="store_true", help="show current binding")
+    args = ap.parse_args()
+
+    if args.status:
+        from mission_control.core.model_binding import MODEL
+        print(MODEL.status())
+        return 0
+    if args.bind:
+        from mission_control.core.model_binding import MODEL
+        provider = args.bind[0]
+        model = args.bind[1] if len(args.bind) > 1 else ""
+        endpoint = args.bind[2] if len(args.bind) > 2 else ""
+        key_env = args.bind[3] if len(args.bind) > 3 else ""
+        res = MODEL.bind(provider, model, endpoint, key_env)
+        print(("✅ bound" if res["ok"] else "❌ failed") + f" :: {res}")
+        return 0 if res["ok"] else 1
+    return preflight()
+
+
+if __name__ == "__main__":
+    sys.exit(main())
