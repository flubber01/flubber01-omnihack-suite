+"""🐝 LOOKUP SWARM :: 0-cost agent grid — zero live model calls.
+
+Offline-compressed persona architecture (frozen-teacher style): all
+behavioural traits, dialogue patterns and backstories live in a compact
+SQLite/FTS5 DBAL, so runtime social daemons (Facebook, SoundCloud, X,
+Telegram) answer interactions from a lookup table — **no model calls, no
+API overhead, minimal RAM**.
+
+* **Vita grid** — 100 352 personas (256 niches × 392) built lazily in the
+  background; only the requested rows are ever loaded.
+* **Dialogue bank** — intent × tone templates in an FTS5 index; replies are
+  composed deterministically with the C99 engine (routing + micro text),
+  never with a live model.
+* **Vita threads** — per-platform conversation state machines the daemons
+  drive; hit rates + C99 inference stats stream into the DBAL on the 120 s
+  heartbeat.
+"""
+
+from __future__ import annotations
+
+import os
+import random
+import re
+import sqlite3
+import threading
+import time
+from typing import Any, Dict, List, Optional
+
+from .c99_bridge import C99, py_hash
+from .state import STATE, now_iso, uid
+
+DB_PATH = os.environ.get(
+    "OMNI_LOOKUP_DB", os.path.expanduser("~/.omnihack/vault/lookup_swarm.db"))
+
+PLATFORMS = ["Facebook", "SoundCloud", "X", "Telegram"]
+GRID_NICHES = 256
+GRID_PER_NICHE = 392
+GRID_TOTAL = GRID_NICHES * GRID_PER_NICHE   # 100 352
+
+_NICHE_A = [
+    "tech", "gaming", "music", "fitness", "food", "travel", "finance",
+    "art", "photo", "diy", "science", "fashion", "movies", "books",
+    "pets", "garden", "crypto", "retro", "outdoor", "crafts",
+]
+_NICHE_B = [
+    "daily", "hub", "lab", "corner", "digest", "zone", "circle", "wave",
+    "vault", "scene", "nerds", "clubs", "guild", "squad", "loft", "dock",
+]
+_TONES = ["warm", "punchy", "deadpan"]
+_ARCHETYPES = ["curator", "storyteller", "analyst", "hype", "mentor"]
+
+# intent → base templates ({handle} persona, {line} C99 micro text)
+_BANK_SEED: List[Dict[str, str]] = [
+    {"intent": "greeting", "tone": "warm",
+     "template": "Hey, {handle} here! {line} — what are you building today?"},
+    {"intent": "greeting", "tone": "punchy",
+     "template": "{handle} online. {line}. Let's go."},
+    {"intent": "greeting", "tone": "deadpan",
+     "template": "it's {handle}. {line}. anyway, hi."},
+    {"intent": "question", "tone": "warm",
+     "template": "Great question — {handle} thinks: {line}. Happy to dig deeper!"},
+    {"intent": "question", "tone": "punchy",
+     "template": "Short answer from {handle}: {line}. Long answer in the thread."},
+    {"intent": "question", "tone": "deadpan",
+     "template": "{handle} says: {line}. source: trust me."},
+    {"intent": "feedback", "tone": "warm",
+     "template": "Thanks for the feedback! {handle} notes: {line}."},
+    {"intent": "feedback", "tone": "punchy",
+     "template": "Logged. {handle} ships fixes fast — {line}."},
+    {"intent": "feedback", "tone": "deadpan",
+     "template": "feedback received, filed under '{line}' — {handle}"},
+    {"intent": "collab", "tone": "warm",
+     "template": "Love this idea — {handle} is in. {line}!"},
+    {"intent": "collab", "tone": "punchy",
+     "template": "{handle} x you? Let's run it: {line}."},
+    {"intent": "collab", "tone": "deadpan",
+     "template": "{handle} would collab. {line}. probably."},
+    {"intent": "farewell", "tone": "warm",
+     "template": "Catch you later — {handle} signs off. {line} ✨"},
+    {"intent": "farewell", "tone": "punchy",
+     "template": "Out. — {handle} ({line})"},
+    {"intent": "farewell", "tone": "deadpan",
+     "template": "bye. {line}. — {handle}"},
+]
+_GENERIC = "On it — {handle} keeps it real: {line}."
+INTENTS = sorted({b["intent"] for b in _BANK_SEED})
+
+
+def _slug(text: str) -> str:
+    return re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-")
+
+
+class LookupSwarm:
+    """Zero-model-call persona grid + dialogue lookup + thread state."""
+
+    def __init__(self, db_path: Optional[str] = None,
+                 niches: int = GRID_NICHES, per_niche: int = GRID_PER_NICHE) -> None:
+        self.db_path = db_path or DB_PATH
+        self.niches = niches
+        self.per_niche = per_niche
+        self.grid_total = niches * per_niche
+        self.lock = threading.RLock()
+        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
+
+        self.grid_ready = False
+        self._building = False
+        self._build_thread: Optional[threading.Thread] = None
+
+        self.hits = 0
+        self.misses = 0
+        self.last_heartbeat = ""
+        self._init_db()
+        self._seed_bank()
+
+    # ------------------------------------------------------------------ db
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.db_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS vita_grid (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                persona_key TEXT UNIQUE, handle TEXT, niche TEXT,
+                tone TEXT, archetype TEXT, status TEXT DEFAULT 'idle',
+                interactions INTEGER DEFAULT 0, last_active TEXT);
+            CREATE INDEX IF NOT EXISTS ix_vita_niche ON vita_grid(niche);
+            CREATE TABLE IF NOT EXISTS dialogue_bank (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                intent TEXT, tone TEXT, template TEXT);
+            CREATE VIRTUAL TABLE IF NOT EXISTS dialogue_fts USING fts5(
+                intent, template, content='dialogue_bank',
+                content_rowid='id');
+            CREATE TABLE IF NOT EXISTS vita_threads (
+                thread_id TEXT PRIMARY KEY, persona_key TEXT, platform TEXT,
+                started TEXT, turns INTEGER DEFAULT 0, state TEXT
+                DEFAULT 'open', last_intent TEXT);
+            CREATE TABLE IF NOT EXISTS hit_log (
+                ts TEXT, persona_key TEXT, platform TEXT, intent TEXT,
+                latency_us INTEGER, hit INTEGER);
+            CREATE TABLE IF NOT EXISTS c99_log (
+                ts TEXT, backend TEXT, calls INTEGER, avg_latency_us REAL);
+            """)
+
+    def _seed_bank(self) -> None:
+        with self.lock, self._conn() as conn:
+            n = conn.execute("SELECT COUNT(*) c FROM dialogue_bank").fetchone()["c"]
+            if n:
+                return
+            for row in _BANK_SEED:
+                cur = conn.execute("INSERT INTO dialogue_bank (intent, tone, template)"
+                                   " VALUES (?,?,?)",
+                                   (row["intent"], row["tone"], row["template"]))
+                conn.execute("INSERT INTO dialogue_fts (rowid, intent, template)"
+                             " VALUES (?,?,?)",
+                             (cur.lastrowid, row["intent"], row["template"]))
+            conn.execute("INSERT INTO dialogue_bank (intent, tone, template)"
+                         " VALUES ('generic','warm',?)", (_GENERIC,))
+
+    # ------------------------------------------------------------- grid build
+    def ensure_grid(self, background: bool = True) -> None:
+        with self.lock:
+            if self.grid_ready or self._building:
+                return
+            with self._conn() as conn:
+                n = conn.execute("SELECT COUNT(*) c FROM vita_grid").fetchone()["c"]
+            if n >= self.grid_total:
+                self.grid_ready = True
+                return
+            self._building = True
+        if background:
+            self._build_thread = threading.Thread(target=self._build_grid,
+                                                  daemon=True, name="vita-grid")
+            self._build_thread.start()
+        else:
+            self._build_grid()
+
+    def _persona_row(self, niche: str, i: int) -> tuple:
+        rnd = random.Random(py_hash(f"{niche}:{i}") & ((1 << 63) - 1))
+        handle = f"{_slug(niche).replace('-', '_')}{i:03d}"
+        tone = _TONES[rnd.randrange(len(_TONES))]
+        arch = _ARCHETYPES[rnd.randrange(len(_ARCHETYPES))]
+        return (f"vita.{niche}.{i:03d}", f"@{handle}", niche, tone, arch,
+                now_iso())
+
+    def _build_grid(self) -> None:
+        t0 = time.time()
+        niche_names = [f"{a}-{b}" for a in _NICHE_A for b in _NICHE_B]
+        niche_names = niche_names[:self.niches]
+        while len(niche_names) < self.niches:
+            niche_names.append(f"niche-{len(niche_names)}")
+        batch: List[tuple] = []
+        for niche in niche_names:
+            for i in range(self.per_niche):
+                batch.append(self._persona_row(niche, i))
+                if len(batch) >= 20000:
+                    self._insert_grid(batch)
+                    batch = []
+        if batch:
+            self._insert_grid(batch)
+        with self.lock:
+            self.grid_ready = True
+            self._building = False
+        STATE.log("OK", "LOOKUP",
+                  f"Vita grid online :: {self.grid_total} personas in "
+                  f"{time.time()-t0:.1f}s (0 model calls).")
+
+    def _insert_grid(self, rows: List[tuple]) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executemany(
+                "INSERT OR IGNORE INTO vita_grid"
+                " (persona_key, handle, niche, tone, archetype, last_active)"
+                " VALUES (?,?,?,?,?,?)", rows)
+
+    def grid_status(self) -> Dict[str, Any]:
+        with self.lock, self._conn() as conn:
+            n = conn.execute("SELECT COUNT(*) c FROM vita_grid").fetchone()["c"]
+            active = conn.execute("SELECT COUNT(*) c FROM vita_grid"
+                                  " WHERE status='active'").fetchone()["c"]
+        if n >= self.grid_total:
+            self.grid_ready = True
+        return {"indexed": n, "total": self.grid_total, "ready": self.grid_ready,
+                "building": self._building, "active": active}
+
+    # -------------------------------------------------------------- personas
+    def spawn_vita(self, niche: str = "") -> Dict[str, Any]:
+        """Activate one persona (auto-picks deterministically if no niche)."""
+        self.ensure_grid(background=True)
+        with self.lock, self._conn() as conn:
+            if niche:
+                row = conn.execute(
+                    "SELECT * FROM vita_grid WHERE niche=? AND status='idle'"
+                    " ORDER BY id LIMIT 1", (niche,)).fetchone()
+            else:
+                row = conn.execute("SELECT * FROM vita_grid WHERE status='idle'"
+                                   " ORDER BY id LIMIT 1").fetchone()
+            if not row:
+                return {"ok": False, "error": "no idle persona available"
+                                              " (grid building or exhausted)"}
+            conn.execute("UPDATE vita_grid SET status='active', last_active=?"
+                         " WHERE id=?", (now_iso(), row["id"]))
+        STATE.log("INFO", "LOOKUP",
+                  f"Vita spawned :: {row['persona_key']} ({row['niche']}).")
+        return {"ok": True, "persona_key": row["persona_key"],
+                "handle": row["handle"], "niche": row["niche"],
+                "tone": row["tone"], "archetype": row["archetype"]}
+
+    def vita_card(self, persona_key: str) -> Dict[str, Any]:
+        """On-demand backstory materialisation (progressive disclosure)."""
+        with self.lock, self._conn() as conn:
+            row = conn.execute("SELECT * FROM vita_grid WHERE persona_key=?",
+                               (persona_key,)).fetchone()
+        if not row:
+            return {"ok": False, "error": f"unknown persona '{persona_key}'"}
+        seed = py_hash(persona_key)
+        origin = C99.generate(seed, 48)
+        motto = C99.generate(seed ^ 0xBEEF, 40)
+        return {"ok": True, "persona_key": persona_key, "handle": row["handle"],
+                "niche": row["niche"], "tone": row["tone"],
+                "archetype": row["archetype"], "status": row["status"],
+                "interactions": row["interactions"],
+                "backstory": f"Grew up around '{origin}'; now posts about "
+                             f"{row['niche']}. Motto: \"{motto}\"."}
+
+    # ----------------------------------------------------- zero-call replies
+    def lookup_reply(self, persona_key: str, intent: str,
+                     platform: str = "—") -> Dict[str, Any]:
+        """Compose a reply purely from the bank + C99 routing (no model)."""
+        t0 = time.perf_counter()
+        intent = (intent or "").strip().lower() or "greeting"
+
+        with self.lock, self._conn() as conn:
+            persona = conn.execute("SELECT * FROM vita_grid WHERE persona_key=?",
+                                   (persona_key,)).fetchone()
+            if not persona:
+                self.misses += 1
+                return {"ok": False, "error": f"unknown persona '{persona_key}'"}
+
+            # FTS5 probe for the intent, else exact intent, else generic
+            fts = conn.execute(
+                "SELECT b.template, b.tone FROM dialogue_fts f"
+                " JOIN dialogue_bank b ON b.id = f.rowid"
+                " WHERE dialogue_fts MATCH ? LIMIT 6", (intent,)).fetchall()
+            exact = conn.execute("SELECT * FROM dialogue_bank WHERE intent=?",
+                                 (intent,)).fetchall()
+            pool = list(fts or exact) or conn.execute(
+                "SELECT * FROM dialogue_bank WHERE intent='generic'").fetchall()
+
+        # C99 routing decision: pick the template lane
+        lane = C99.route(f"{persona_key}|{intent}", len(pool))
+        template = pool[lane]["template"]
+        tone = persona["tone"]
+        line = C99.generate(py_hash(f"{persona_key}|{intent}|{tone}"), 44)
+        reply = template.format(handle=persona["handle"], line=line)
+
+        latency_us = int((time.perf_counter() - t0) * 1_000_000)
+        self.hits += 1
+        with self.lock, self._conn() as conn:
+            conn.execute("UPDATE vita_grid SET interactions = interactions + 1,"
+                         " last_active=? WHERE persona_key=?",
+                         (now_iso(), persona_key))
+            conn.execute("INSERT INTO hit_log (ts, persona_key, platform, intent,"
+                         " latency_us, hit) VALUES (?,?,?,?,?,1)",
+                         (now_iso(), persona_key, platform, intent, latency_us))
+        return {"ok": True, "persona_key": persona_key, "platform": platform,
+                "intent": intent, "reply": reply, "latency_us": latency_us,
+                "model_calls": 0}
+
+    # ---------------------------------------------------------- vita threads
+    def thread_open(self, persona_key: str, platform: str) -> Dict[str, Any]:
+        if platform not in PLATFORMS:
+            return {"ok": False, "error": f"unknown platform '{platform}'",
+                    "platforms": PLATFORMS}
+        tid = uid("thr")
+        with self.lock, self._conn() as conn:
+            row = conn.execute("SELECT 1 FROM vita_grid WHERE persona_key=?",
+                               (persona_key,)).fetchone()
+            if not row:
+                return {"ok": False, "error": f"unknown persona '{persona_key}'"}
+            conn.execute("INSERT INTO vita_threads (thread_id, persona_key,"
+                         " platform, started, state) VALUES (?,?,?,?,'open')",
+                         (tid, persona_key, platform, now_iso()))
+        return {"ok": True, "thread_id": tid, "persona_key": persona_key,
+                "platform": platform}
+
+    def thread_turn(self, thread_id: str, intent: str) -> Dict[str, Any]:
+        with self.lock, self._conn() as conn:
+            thr = conn.execute("SELECT * FROM vita_threads WHERE thread_id=?",
+                               (thread_id,)).fetchone()
+        if not thr:
+            return {"ok": False, "error": f"unknown thread '{thread_id}'"}
+        if thr["state"] != "open":
+            return {"ok": False, "error": f"thread is {thr['state']}"}
+        reply = self.lookup_reply(thr["persona_key"], intent, thr["platform"])
+        if not reply["ok"]:
+            return reply
+        with self.lock, self._conn() as conn:
+            conn.execute("UPDATE vita_threads SET turns = turns + 1, last_intent=?"
+                         " WHERE thread_id=?", (intent, thread_id))
+        return reply
+
+    def thread_close(self, thread_id: str) -> str:
+        with self.lock, self._conn() as conn:
+            cur = conn.execute("UPDATE vita_threads SET state='closed'"
+                               " WHERE thread_id=?", (thread_id,))
+        return "🔒 Thread closed." if cur.rowcount else "⚠️ Unknown thread."
+
+    def active_threads(self, limit: int = 20) -> List[Dict[str, Any]]:
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT * FROM vita_threads WHERE state='open'"
+                                " ORDER BY started DESC LIMIT ?", (limit,)).fetchall()
+        return [dict(r) for r in rows]
+
+    # -------------------------------------------------------- daemon cycles
+    def simulate_daemon_cycle(self, platform: str, interactions: int = 6) -> Dict[str, Any]:
+        """One simulated pass of a platform daemon against the lookup grid."""
+        if platform not in PLATFORMS:
+            return {"ok": False, "error": f"unknown platform '{platform}'",
+                    "platforms": PLATFORMS}
+        self.ensure_grid(background=True)
+        rnd = random.Random(int(time.time() * 1000) % 2**31)
+        answered = opened = 0
+        for _ in range(max(1, min(24, int(interactions)))):
+            with self.lock, self._conn() as conn:
+                row = conn.execute("SELECT persona_key FROM vita_grid"
+                                   " WHERE status='active' ORDER BY RANDOM()"
+                                   " LIMIT 1").fetchone()
+            if not row:
+                spawn = self.spawn_vita()
+                if not spawn["ok"]:
+                    break
+                key = spawn["persona_key"]
+            else:
+                key = row["persona_key"]
+            intent = rnd.choice(INTENTS + ["greeting", "question"])
+            if rnd.random() < 0.35:
+                opened += 1
+                thr = self.thread_open(key, platform)
+                if thr["ok"]:
+                    self.thread_turn(thr["thread_id"], intent)
+                    answered += 1
+            else:
+                if self.lookup_reply(key, intent, platform)["ok"]:
+                    answered += 1
+        STATE.log("INFO", "LOOKUP",
+                  f"{platform} daemon cycle :: {answered} organic replies served"
+                  f" from lookup (0 model calls), {opened} thread(s) opened.")
+        return {"ok": True, "platform": platform, "answered": answered,
+                "threads_opened": opened, "model_calls": 0}
+
+    # ------------------------------------------------------- heartbeat/DBAL
+    def run_heartbeat(self) -> Dict[str, Any]:
+        """120 s DBAL sync: snapshot hit-rate + C99 inference stats."""
+        s99 = C99.stats()
+        hit_rate = round(100.0 * self.hits / max(self.hits + self.misses, 1), 1)
+        with self.lock, self._conn() as conn:
+            conn.execute("INSERT INTO c99_log (ts, backend, calls, avg_latency_us)"
+                         " VALUES (?,?,?,?)",
+                         (now_iso(), s99["backend"], s99["calls"],
+                          s99["avg_latency_us"]))
+            conn.execute("DELETE FROM hit_log WHERE ts < datetime('now','-2 day')")
+        self.last_heartbeat = now_iso()
+        STATE.log("INFO", "LOOKUP",
+                  f"Heartbeat :: hit-rate {hit_rate}% ({self.hits} hits) · "
+                  f"C99 {s99['backend']} {s99['calls']} calls · threads "
+                  f"{len(self.active_threads())} open.")
+        return {"hit_rate": hit_rate, "hits": self.hits, "misses": self.misses,
+                "c99_backend": s99["backend"], "c99_calls": s99["calls"]}
+
+    def keeper_tick(self) -> Dict[str, Any]:
+        """Hook executed by the central daemon runner (always-on)."""
+        with self.lock, self._conn() as conn:
+            conn.execute("UPDATE vita_threads SET state='stale'"
+                         " WHERE state='open' AND turns = 0"
+                         " AND started < datetime('now','-1 hour')")
+        return self.run_heartbeat()
+
+    # ------------------------------------------------------------- reporting
+    def stats(self) -> Dict[str, Any]:
+        g = self.grid_status()
+        with self.lock, self._conn() as conn:
+            bank = conn.execute("SELECT COUNT(*) c FROM dialogue_bank").fetchone()["c"]
+            open_thr = conn.execute("SELECT COUNT(*) c FROM vita_threads"
+                                    " WHERE state='open'").fetchone()["c"]
+            recent = conn.execute("SELECT AVG(latency_us) a FROM hit_log").fetchone()["a"]
+        hit_rate = round(100.0 * self.hits / max(self.hits + self.misses, 1), 1)
+        return {**g, "dialogue_bank": bank, "open_threads": open_thr,
+                "hits": self.hits, "misses": self.misses, "hit_rate": hit_rate,
+                "avg_lookup_us": round(recent or 0, 1),
+                "c99_backend": C99.backend,
+                "last_heartbeat": self.last_heartbeat or "—",
+                "platforms": PLATFORMS}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return (f"[LOOKUP] grid {s['indexed']}/{s['total']} · hit-rate "
+                f"{s['hit_rate']}% · threads {s['open_threads']} · "
+                f"c99={s['c99_backend']}")
+
+
+LOOKUP_SWARM = LookupSwarm()
