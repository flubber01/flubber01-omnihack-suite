+"""📦 AWESOME-LLM-APPS :: backend library reference (RPC facade).
+
+Clean mount of the Awesome-LLM-Apps family as a *reference index* — the swarm
+can query starter templates and programmatically "execute" them via Python
+RPC.  Execution returns simulated receipts (metadata + planned steps) so the
+stack stays native-safe; no upstream code is vendored or run.
+
+The mount directory is hyphenated (mirrors the upstream repo path), so load
+this module through the package shim instead of a plain import::
+
+    from external_tools import awesome_llm_apps_rpc
+    rpc = awesome_llm_apps_rpc()
+    hits = rpc.StarterRPC.query("rag vector search")
+    receipt = rpc.StarterRPC.run("rag-starter", agent="OMNI-PRIME")
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+from typing import Any, Dict, List
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_CATALOG_PATH = os.path.join(_HERE, "catalog.json")
+
+
+def _tokenize(text: str) -> set:
+    return set(re.findall(r"[a-z0-9]{2,}", (text or "").lower()))
+
+
+def load_catalog() -> Dict[str, Any]:
+    with open(_CATALOG_PATH) as fh:
+        return json.load(fh)
+
+
+def list_starters() -> List[Dict[str, Any]]:
+    return load_catalog()["starters"]
+
+
+def query(query_text: str, limit: int = 5) -> List[Dict[str, Any]]:
+    """Token-overlap search over the starter index."""
+    q = _tokenize(query_text)
+    if not q:
+        return []
+    scored = []
+    for s in load_catalog()["starters"]:
+        toks = _tokenize(" ".join([s["id"], s["name"], s["category"],
+                                   s["desc"]] + s["tags"]))
+        overlap = len(q & toks)
+        if overlap:
+            scored.append((overlap, s))
+    scored.sort(key=lambda kv: -kv[0])
+    return [{**s, "match": o} for o, s in scored[:limit]]
+
+
+def run_starter(starter_id: str, agent: str = "—",
+                params: Dict[str, Any] | None = None) -> Dict[str, Any]:
+    """Simulated execution receipt for one starter template."""
+    starter = next((s for s in load_catalog()["starters"]
+                    if s["id"] == (starter_id or "").strip()), None)
+    if not starter:
+        return {"ok": False, "error": f"unknown starter '{starter_id}'",
+                "available": [s["id"] for s in load_catalog()["starters"]]}
+    return {
+        "ok": True, "starter": starter["id"], "entry": starter["entry"],
+        "stack": starter["stack"], "agent": agent, "params": params or {},
+        "status": "SIMULATED_OK",
+        "planned_steps": [
+            f"resolve entry :: {starter['entry']}",
+            "materialise env (venv + pinned deps)",
+            f"initialise {' + '.join(starter['stack'][:2])} runtime",
+            "run smoke pass with seeded fixtures",
+            "emit receipt + artifact manifest",
+        ],
+        "note": "reference-mode: simulated receipt, no upstream code executed",
+    }
+
+
+class StarterRPC:
+    """Programmatic RPC surface for the swarm."""
+    list = staticmethod(list_starters)
+    query = staticmethod(query)
+    run = staticmethod(run_starter)
