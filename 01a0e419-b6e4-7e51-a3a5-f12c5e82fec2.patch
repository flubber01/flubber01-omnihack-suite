index 0000000..e791c5e
--- /dev/null
+++ b/mission_control/core/pipeline.py
@@ -0,0 +1,254 @@
+"""CONTENT AUTOMATION PIPELINE :: script → assets → voiceover → render → post.
+
+Every stage returns a plausible simulated artifact so the planner is fully
+navigable without external services.  The FFmpeg stage is a real wrapper
+call-site (stubbed execution) so swapping in a render farm is trivial.
+"""
+
+from __future__ import annotations
+
+import random
+from typing import Any, Dict, List
+
+from .state import STATE, now_iso, uid
+
+_RND = random.Random(99)
+
+VOICES = ["ARIA-9 (fem, warm)", "VOLT-3 (masc, punchy)", "NOVA-5 (fem, narration)",
+          "REX-1 (masc, hype)", "ECHO-7 (neutral, docu)"]
+TONES = ["Hype / Viral", "Educational", "Dark / Cinematic", "Tech Review", "Motivational"]
+PLATFORMS = ["YouTube Shorts", "TikTok", "Instagram Reels", "Facebook", "X (Twitter)"]
+
+HOOKS = [
+    "Nobody is talking about this yet…",
+    "I tested it for 30 days straight. Here's the truth.",
+    "This changes everything you knew about {topic}.",
+    "Stop scrolling — the {topic} secret is finally out.",
+    "POV: you discover {topic} before everyone else.",
+]
+BEATS = [
+    "Reveal the core claim with on-screen proof.",
+    "Cut to b-roll while the voiceover drops the key stat.",
+    "Quick myth-bust: what everyone gets wrong.",
+    "Show the exact steps in three fast cuts.",
+    "Insert pattern-interrupt zoom + sound sting.",
+]
+CTAS = [
+    "Follow for part 2 — tomorrow we go deeper.",
+    "Save this before it gets buried.",
+    "Comment '{topic}' and I'll send the full breakdown.",
+    "Share this with someone who needs it today.",
+]
+
+
+class ContentPipeline:
+    def __init__(self) -> None:
+        self.jobs: Dict[str, Dict[str, Any]] = {}
+
+    # ------------------------------------------------------------------ jobs
+    def new_job(self, topic: str, tone: str, length: int,
+                platforms: List[str], profile: str) -> Dict[str, Any]:
+        job = {
+            "id": uid("vid"),
+            "topic": (topic or "untitled brief").strip(),
+            "tone": tone,
+            "length_s": int(length),
+            "platforms": list(platforms or []),
+            "profile": profile,
+            "stage": "IDEATION",
+            "progress": 0.0,
+            "script": "",
+            "assets": [],
+            "voiceover": {},
+            "render": {},
+            "posts": [],
+            "created_at": now_iso(),
+        }
+        self.jobs[job["id"]] = job
+        STATE.content_queue.append(job)
+        STATE.log("INFO", "PIPELINE", f"New content job {job['id']} :: {job['topic']}")
+        return job
+
+    # ---------------------------------------------------------------- stages
+    def write_script(self, job_id: str) -> Dict[str, Any]:
+        job = self.jobs.get(job_id)
+        if not job:
+            return {"ok": False, "error": "unknown job"}
+        rnd = random.Random(job_id)
+        topic = job["topic"]
+        hook = rnd.choice(HOOKS).format(topic=topic)
+        lines = [f"🎬 SCRIPT :: '{topic}'  [{job['tone']} · {job['length_s']}s]",
+                 "", f"[0:00 HOOK] {hook}"]
+        beats = rnd.sample(BEATS, k=3)
+        t = 3
+        seg = max(4, (job["length_s"] - 12) // 3)
+        for i, b in enumerate(beats, 1):
+            lines.append(f"[0:{t:02d} BEAT {i}] {b}  (VO: '{topic}' context #{i})")
+            t += seg
+        lines.append(f"[0:{min(t, 59):02d} CTA] {rnd.choice(CTAS).format(topic=topic)}")
+        lines += ["", "#shorts #viral #" + topic.replace(" ", "")[:24]]
+        job["script"] = "\n".join(lines)
+        job["stage"] = "SCRIPTED"
+        STATE.log("OK", "PIPELINE", f"Script written for {job_id}.")
+        return {"ok": True, "script": job["script"]}
+
+    def fetch_assets(self, job_id: str) -> Dict[str, Any]:
+        job = self.jobs.get(job_id)
+        if not job:
+            return {"ok": False, "error": "unknown job"}
+        rnd = random.Random(job_id + "assets")
+        assets = []
+        for i in range(rnd.randint(4, 6)):
+            assets.append({
+                "id": uid("ast"),
+                "kind": rnd.choice(["stock-video", "image", "b-roll", "meme", "chart"]),
+                "source": rnd.choice(["Pexels", "Pixabay", "Storyblocks", "LocalVault"]),
+                "duration_s": rnd.randint(2, 9),
+                "tags": [job["topic"].split()[0].lower(), "vertical", "4k"],
+            })
+        job["assets"] = assets
+        job["stage"] = "ASSETS_READY"
+        STATE.log("OK", "PIPELINE", f"Fetched {len(assets)} assets for {job_id}.")
+        return {"ok": True, "assets": assets}
+
+    def generate_voiceover(self, job_id: str, voice: str) -> Dict[str, Any]:
+        job = self.jobs.get(job_id)
+        if not job:
+            return {"ok": False, "error": "unknown job"}
+        words = max(20, len(job.get("script", "").split()) or job["length_s"] * 2)
+        vo = {
+            "engine": "omniTTS-neural (stub)",
+            "voice": voice,
+            "words": words,
+            "est_duration_s": round(words / 2.6, 1),
+            "file": f"/render/{job['id']}/voiceover.wav",
+            "loudness_lufs": -16.0,
+        }
+        job["voiceover"] = vo
+        job["stage"] = "VOICEOVER_READY"
+        STATE.log("OK", "PIPELINE", f"Voiceover synthesized for {job_id} ({voice}).")
+        return {"ok": True, "voiceover": vo}
+
+    def render(self, job_id: str) -> Dict[str, Any]:
+        """Simulated FFmpeg concatenation wrapper."""
+        job = self.jobs.get(job_id)
+        if not job:
+            return {"ok": False, "error": "unknown job"}
+        task = {"id": uid("rnd"), "job": job_id, "status": "RENDERING", "progress": 0}
+        STATE.render_tasks[task["id"]] = task
+        # 🎖️ Compute-Commander interception: heavy FFmpeg work → remote pool
+        try:
+            from .compute_commander import COMMANDER
+            offload = COMMANDER.intercept(f"ffmpeg render {job_id}", kind="render",
+                                           size_hint=job["length_s"])
+        except Exception:
+            offload = {"decision": "local", "node": None}
+        cmd = ("ffmpeg -y -f concat -safe 0 -i clips.txt "
+               f"-i {job['voiceover'].get('file', 'vo.wav')} "
+               "-vf scale=1080:1920 -c:v libx264 -preset veryfast -c:a aac "
+               f"-t {job['length_s']} {job['id']}.mp4")
+        target = offload.get("node") or "LOCAL-CPU"
+        STATE.log("INFO", "FFMPEG", f"Render task {task['id']} dispatched :: "
+                                    f"{job['id']}.mp4 on {target}")
+        render = {
+            "task_id": task["id"],
+            "ffmpeg_cmd": cmd,
+            "compute_node": target,
+            "offload_decision": offload.get("decision"),
+            "resolution": "1080x1920 (9:16)",
+            "codec": "H.264 / AAC",
+            "output": f"/render/{job['id']}/{job['id']}.mp4",
+            "simulated_frames": job["length_s"] * 30,
+        }
+        job["render"] = render
+        job["stage"] = "RENDERED"
+        task["status"] = "DONE"
+        STATE.log("OK", "FFMPEG", f"Render complete :: {job['id']}.mp4 "
+                                  f"({job['length_s']}s @ 1080x1920).")
+        return {"ok": True, "render": render, "ffmpeg_cmd": cmd}
+
+    def distribute(self, job_id: str) -> Dict[str, Any]:
+        job = self.jobs.get(job_id)
+        if not job:
+            return {"ok": False, "error": "unknown job"}
+        posts = []
+        for platform in job["platforms"]:
+            posts.append({
+                "platform": platform,
+                "profile": job["profile"],
+                "status": "UPLOADED (simulated)",
+                "url": f"https://{platform.split()[0].lower()}.example/{job['id']}",
+                "cookies": "stored-profile-cookies",
+                "uploaded_at": now_iso(),
+            })
+        job["posts"] = posts
+        job["stage"] = "DISTRIBUTED"
+        STATE.pipeline_runs.append({"id": job_id, "status": "COMPLETE",
+                                    "targets": len(posts)})
+        STATE.log("OK", "DISTRIBUTE", f"{job_id} pushed to {len(posts)} platform(s).")
+        return {"ok": True, "posts": posts}
+
+    # ----------------------------------------------------------------- table
+    def queue_rows(self) -> List[List[str]]:
+        rows = []
+        for job in reversed(STATE.content_queue):
+            rows.append([
+                job["id"], job["topic"][:32], job["tone"],
+                str(job["length_s"]) + "s", ",".join(p.split()[0] for p in job["platforms"]),
+                job["profile"], job["stage"],
+            ])
+        return rows
+
+    def run_autopilot(self, topic: str, tone: str, length: int,
+                      platforms: List[str], profile: str, voice: str) -> Dict[str, Any]:
+        """Full one-click flow: ideation ➔ scripting ➔ rendering ➔ distribution."""
+        job = self.new_job(topic, tone, length, platforms, profile)
+        self.write_script(job["id"])
+        self.fetch_assets(job["id"])
+        # 🕸️ API-NEXUS supply line: pull a zero-cost endpoint for the run
+        nexus_supply = None
+        try:
+            from .api_nexus import NEXUS
+            nexus_supply = NEXUS.request_asset("utility", agent=profile or "FACTORY")
+            if nexus_supply.get("ok"):
+                STATE.log("INFO", "API-NEXUS",
+                          f"Supplied {nexus_supply['kind']} "
+                          f"({nexus_supply['provider']}) to autopilot {job['id']}.")
+        except Exception:
+            nexus_supply = None
+        self.generate_voiceover(job["id"], voice)
+        self.render(job["id"])
+        post = self.distribute(job["id"])
+        # 🧠 procedural memory: how the factory executed this run
+        try:
+            from .memory import MEMORY
+            MEMORY.store(profile or "FACTORY",
+                         f"autopilot render '{topic}' ({length}s, {tone}) → posted to "
+                         f"{', '.join(p['platform'] for p in post.get('posts', []))}",
+                         kind="procedural", importance=8)
+        except Exception:
+            pass
+        # 🧬 closed learning loop: fuse this multi-step run into a custom skill
+        try:
+            from .cross_ref_engine import XREF
+            trace = [
+                {"skill_id": "content.ideation", "exit_code": 0, "runtime_ms": 90,
+                 "params": {"topic": topic}},
+                {"skill_id": "content.scripting", "exit_code": 0, "runtime_ms": 120,
+                 "params": {"tone": tone}},
+                {"skill_id": "content.assets", "exit_code": 0, "runtime_ms": 160,
+                 "params": {"count": len(job.get("assets", []))}},
+                {"skill_id": "content.voiceover", "exit_code": 0, "runtime_ms": 140,
+                 "params": {"voice": voice}},
+                {"skill_id": "content.render", "exit_code": 0,
+                 "runtime_ms": job["length_s"] * 30, "params": {"res": "1080x1920"}},
+                {"skill_id": "content.distribute", "exit_code": 0, "runtime_ms": 200,
+                 "params": {"platforms": len(post.get("posts", []))}},
+            ]
+            XREF.evolve_skill(trace, title=f"autopilot-{job['id']}")
+        except Exception:
+            pass
+        return {"ok": True, "job": job, "posts": post.get("posts", [])}
+
+
+PIPELINE = ContentPipeline()
diff --git a/mission_control/core/prompt_router.py b/mission_control/core/prompt_router.py
new file mode 100644
index 0000000..9001c86
--- /dev/null
+++ b/mission_control/core/prompt_router.py
@@ -0,0 +1,226 @@
+"""🧭 PROMPT ROUTER :: master → minion prompt dispatch database.
+
+The OMNI master agents consult this registry to hand every minion the
+single best-fit prompt for its assigned task.  Routing is a weighted
+token-overlap score (task tokens vs template domain/keywords) multiplied
+by the template's learned quality factor, which :meth:`feedback` tunes
+after every completed dispatch.
+
+All templates are **own, clean boilerplate** — no third-party or leaked
+prompt material is stored or fetched.  Dispatch receipts land in
+``prompt_db.db`` for audit and quality learning.
+"""
+
+from __future__ import annotations
+
+import re
+import sqlite3
+import threading
+from typing import Any, Dict, List, Optional
+
+import os as _os
+
+from .state import STATE, now_iso
+
+DB_PATH = _os.environ.get(
+    "OMNI_PROMPT_DB", _os.path.expanduser("~/.omnihack/vault/prompt_db.db"))
+
+_WORD = re.compile(r"[a-z0-9]{3,}")
+
+
+def _tokens(text: str) -> List[str]:
+    return _WORD.findall((text or "").lower())
+
+
+# Own clean templates: (domain, keywords, template)
+OWN_TEMPLATES: List[Dict[str, str]] = [
+    {"domain": "social_post",
+     "keywords": "post tweet thread caption social instagram x tiktok publish",
+     "template": "Write one concise, on-brand social media post about: {task}. "
+                 "Keep it under 280 characters, include one call to action and "
+                 "max two hashtags."},
+    {"domain": "scrape_report",
+     "keywords": "scrape crawl extract parse html page asset data collect",
+     "template": "Extract the structured facts from: {task}. Return a JSON "
+                 "object with keys: title, items, links, confidence. Do not "
+                 "invent data that is not present in the source."},
+    {"domain": "browser_ops",
+     "keywords": "browser navigate click form login session tab cookie",
+     "template": "Drive the remote browser to complete: {task}. Act step by "
+                 "step, wait for page loads between actions, capture a "
+                 "screenshot after the final step and report the resulting URL."},
+    {"domain": "render_video",
+     "keywords": "render video ffmpeg clip montage encode media timeline",
+     "template": "Produce the media asset for: {task}. Use the FFmpeg pipeline "
+                 "with sensible defaults, report file size, duration and the "
+                 "vault path of the finished asset."},
+    {"domain": "code_fix",
+     "keywords": "code fix bug python error stack trace test refactor",
+     "template": "Diagnose and fix the issue in: {task}. First reproduce it "
+                 "with a minimal case, then apply the smallest correct patch "
+                 "and verify with the provided tests."},
+    {"domain": "research_brief",
+     "keywords": "research summary sources brief compare analysis report",
+     "template": "Research and summarize: {task}. Deliver a brief of max five "
+                 "bullet points with one source reference per claim and a "
+                 "final one-line verdict."},
+    {"domain": "api_connector",
+     "keywords": "api key endpoint connect webhook oauth token integration",
+     "template": "Wire up the integration for: {task}. Validate the provided "
+                 "credentials with a lightweight status call, store them only "
+                 "in the vault, and report the connection health."},
+    {"domain": "telemetry_check",
+     "keywords": "telemetry heartbeat health monitor sync stats daemon",
+     "template": "Run a health sweep for: {task}. Report CPU, memory, vault "
+                 "writability and the last heartbeat age; flag anything older "
+                 "than two sync intervals."},
+]
+
+
+class PromptRouter:
+    """Registry, router and dispatch ledger for minion prompts."""
+
+    def __init__(self, db_path: Optional[str] = None) -> None:
+        self.db_path = db_path or DB_PATH
+        self.lock = threading.RLock()
+        _os.makedirs(_os.path.dirname(self.db_path), exist_ok=True)
+        self._init_db()
+        self._seed()
+
+    # ------------------------------------------------------------------ db
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.db_path, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS prompt_templates (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                domain TEXT UNIQUE, keywords TEXT, template TEXT,
+                quality REAL DEFAULT 0.5, uses INTEGER DEFAULT 0);
+            CREATE TABLE IF NOT EXISTS dispatch_log (
+                ts TEXT, commander TEXT, minion TEXT, task TEXT,
+                domain TEXT, template_id INTEGER, score REAL,
+                feedback REAL);
+            """)
+
+    def _seed(self) -> None:
+        with self.lock, self._conn() as conn:
+            for t in OWN_TEMPLATES:
+                conn.execute("INSERT OR IGNORE INTO prompt_templates"
+                             " (domain, keywords, template) VALUES (?,?,?)",
+                             (t["domain"], t["keywords"], t["template"]))
+
+    # -------------------------------------------------------------- routing
+    def score(self, task: str, keywords: str) -> float:
+        """Token-overlap score in [0,1] between task text and a template."""
+        task_toks, kw_toks = set(_tokens(task)), set(_tokens(keywords))
+        if not task_toks or not kw_toks:
+            return 0.0
+        return len(task_toks & kw_toks) / min(len(task_toks), len(kw_toks)) + \
+            0.05 * len(task_toks & kw_toks) / len(kw_toks)
+
+    def route(self, task: str, top_n: int = 3) -> List[Dict[str, Any]]:
+        """Rank templates for a task: token score × quality, best first."""
+        task = (task or "").strip()
+        if not task:
+            return []
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT * FROM prompt_templates").fetchall()
+        ranked = []
+        for r in rows:
+            s = self.score(task, r["keywords"])
+            weighted = round(s * (0.5 + float(r["quality"])), 4)
+            ranked.append({"id": r["id"], "domain": r["domain"],
+                           "score": round(s, 4), "quality": round(float(r["quality"]), 3),
+                           "weighted": weighted, "template": r["template"],
+                           "uses": r["uses"]})
+        ranked.sort(key=lambda x: (x["weighted"], x["score"]), reverse=True)
+        return ranked[:max(1, min(10, top_n))]
+
+    # ------------------------------------------------------------ dispatch
+    def dispatch(self, commander: str, minion: str, task: str,
+                 domain: Optional[str] = None) -> Dict[str, Any]:
+        """Pick (or force) a template, record the receipt, return the prompt."""
+        task = (task or "").strip()
+        if not task:
+            return {"ok": False, "error": "empty task"}
+        with self.lock, self._conn() as conn:
+            if domain:
+                row = conn.execute("SELECT * FROM prompt_templates WHERE domain=?",
+                                   (domain,)).fetchone()
+                if not row:
+                    return {"ok": False, "error": f"unknown domain '{domain}'",
+                            "domains": [d["domain"] for d in self.domains()]}
+                chosen, score = dict(row), 1.0
+            else:
+                best = self.route(task, top_n=1)
+                if not best:
+                    return {"ok": False, "error": "no templates available"}
+                chosen = best[0]
+                score = chosen["score"]
+            prompt = chosen["template"].replace("{task}", task)
+            conn.execute("UPDATE prompt_templates SET uses = uses + 1 WHERE id=?",
+                         (chosen["id"],))
+            conn.execute("INSERT INTO dispatch_log (ts, commander, minion, task,"
+                         " domain, template_id, score, feedback) VALUES"
+                         " (?,?,?,?,?,?,?,NULL)",
+                         (now_iso(), commander or "master", minion or "minion",
+                          task[:400], chosen["domain"], chosen["id"], score))
+        STATE.log("OK", "PROMPT-ROUTER",
+                  f"dispatch {commander or 'master'}→{minion or 'minion'} :: "
+                  f"domain={chosen['domain']} score={round(score, 3)}")
+        return {"ok": True, "domain": chosen["domain"], "template_id": chosen["id"],
+                "score": round(score, 4), "prompt": prompt,
+                "minion": minion or "minion"}
+
+    # ------------------------------------------------------------ feedback
+    def feedback(self, template_id: int, quality: float) -> Dict[str, Any]:
+        """Feed outcome quality (0..1) back into the template's weight."""
+        quality = max(0.0, min(1.0, float(quality)))
+        with self.lock, self._conn() as conn:
+            row = conn.execute("SELECT quality FROM prompt_templates WHERE id=?",
+                               (template_id,)).fetchone()
+            if not row:
+                return {"ok": False, "error": f"unknown template {template_id}"}
+            new_q = round(0.7 * float(row["quality"]) + 0.3 * quality, 4)
+            conn.execute("UPDATE prompt_templates SET quality=? WHERE id=?",
+                         (new_q, template_id))
+            conn.execute("UPDATE dispatch_log SET feedback=? WHERE template_id=?"
+                         " AND feedback IS NULL", (quality, template_id))
+        return {"ok": True, "template_id": template_id, "quality": new_q}
+
+    # -------------------------------------------------------------- queries
+    def domains(self) -> List[Dict[str, Any]]:
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT id, domain, quality, uses FROM"
+                                " prompt_templates ORDER BY domain").fetchall()
+        return [dict(r) for r in rows]
+
+    def recent_dispatches(self, limit: int = 15) -> List[Dict[str, Any]]:
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT ts, commander, minion, task, domain,"
+                                " score, feedback FROM dispatch_log"
+                                " ORDER BY ts DESC, rowid DESC LIMIT ?",
+                                (max(1, min(100, limit)),)).fetchall()
+        return [dict(r) for r in rows]
+
+    def stats(self) -> Dict[str, Any]:
+        with self.lock, self._conn() as conn:
+            n_t = conn.execute("SELECT COUNT(*) c FROM prompt_templates"
+                               ).fetchone()["c"]
+            n_d = conn.execute("SELECT COUNT(*) c FROM dispatch_log").fetchone()["c"]
+            avg_q = conn.execute("SELECT AVG(quality) a FROM prompt_templates"
+                                 ).fetchone()["a"] or 0
+        return {"templates": n_t, "dispatches": n_d,
+                "avg_quality": round(float(avg_q), 3), "db_path": self.db_path}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return (f"[PROMPTS] {s['templates']} templates · {s['dispatches']} "
+                f"dispatches · avg quality {s['avg_quality']}")
+
+
+ROUTER = PromptRouter()
