@@ -0,0 +1,205 @@
+"""⚙️ C99 BRIDGE :: portable lightweight inference without heavy frameworks.
+
+Compiles ``mission_control/c99/omni_c99.c`` (C99, no dependencies) into a
+shared library on first use (cached by source hash under
+``~/.omnihack/c99/``) and drives it through ``ctypes``:
+
+* ``route(text, buckets)``  — deterministic routing decisions
+* ``score(text)``           — fast heuristic validation score 0..100
+* ``generate(seed, n)``     — seed-driven micro text generation
+
+When no compiler exists the bridge transparently falls back to a
+pure-Python implementation of the SAME math (FNV-1a + xorshift64*), so
+results are identical either way.  Every call is counted for telemetry;
+inference logs land in the DBAL through the lookup-swarm heartbeat.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import os
+import subprocess
+import threading
+import time
+from typing import Dict, Optional
+
+from .state import STATE
+
+_C_SRC = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
+                      "c99", "omni_c99.c")
+_CACHE_DIR = os.environ.get(
+    "OMNI_C99_CACHE", os.path.expanduser("~/.omnihack/c99"))
+
+FNV_OFFSET = 1469598103934665603
+FNV_PRIME = 1099511628211
+_MASK64 = (1 << 64) - 1
+
+_SYL_A = ["ka", "ro", "mi", "ve", "du", "sa", "ne", "tu", "li", "or"]
+_SYL_B = ["zen", "vak", "rim", "tol", "nex", "qua", "dri", "sol", "fen", "bor"]
+_SYL_C = ["ax", "os", "ir", "ul", "ek", "ay", "on", "is", "ar", "um"]
+
+
+# --------------------------------------------------------------------------- #
+# Pure-Python mirror of the C99 math (fallback & verification)
+# --------------------------------------------------------------------------- #
+def py_hash(text: str) -> int:
+    h = FNV_OFFSET
+    for b in (text or "").encode("utf-8", errors="replace"):
+        h ^= b
+        h = (h * FNV_PRIME) & _MASK64
+    return h
+
+
+def py_route(text: str, buckets: int) -> int:
+    if buckets <= 0:
+        return 0
+    return py_hash(text) % buckets
+
+
+def py_score(text: str) -> int:
+    s = text or ""
+    if not s:
+        return 0
+    alnum = sum(c.isalnum() for c in s)
+    space = sum(c in " \t\n" for c in s)
+    punct = len(s) - alnum - space
+    base = (alnum * 100) // len(s)
+    spread = py_hash(s) % 23
+    score = base // 2 + (22 if space else 8) + (6 if punct > 2 else 2) + spread
+    return max(0, min(100, score))
+
+
+def py_generate(seed: int, max_len: int = 64) -> str:
+    st = (seed & _MASK64) or 88172645463325252
+    out: list = []
+    words = 4 + st % 5
+    for w in range(words):
+        st ^= st >> 12
+        st = (st ^ (st << 25)) & _MASK64
+        st ^= st >> 27
+        st = (st * 2685821657736338717) & _MASK64
+        part = (st >> 8) % 3
+        if part == 0:
+            out.append(_SYL_A[(st >> 16) % 10] + _SYL_B[(st >> 24) % 10])
+        elif part == 1:
+            out.append(_SYL_B[(st >> 16) % 10] + _SYL_C[(st >> 24) % 10])
+        else:
+            out.append(_SYL_A[(st >> 16) % 10] + _SYL_C[(st >> 24) % 10])
+    return " ".join(out)[:max_len]
+
+
+# --------------------------------------------------------------------------- #
+class C99Bridge:
+    """Compile-once, call-often native micro-inference bridge."""
+
+    def __init__(self) -> None:
+        self.lock = threading.RLock()
+        self.lib: Optional[ctypes.CDLL] = None
+        self.backend = "fallback"
+        self.build_note = ""
+        self.calls = 0
+        self.total_us = 0
+        self._try_compile()
+
+    # ------------------------------------------------------------ compile
+    def _try_compile(self) -> None:
+        try:
+            with open(_C_SRC) as fh:
+                src = fh.read()
+            digest = hashlib.sha1(src.encode()).hexdigest()[:12]
+            os.makedirs(_CACHE_DIR, exist_ok=True)
+            so_path = os.path.join(_CACHE_DIR, f"omni_engine_{digest}.so")
+            if not os.path.exists(so_path):
+                cc = None
+                for cand in ("cc", "gcc", "clang"):
+                    from shutil import which
+                    if which(cand):
+                        cc = cand
+                        break
+                if not cc:
+                    self.build_note = "no C compiler found"
+                    return
+                tmp = so_path + ".tmp.c"
+                with open(tmp, "w") as fh:
+                    fh.write(src)
+                proc = subprocess.run(
+                    [cc, "-std=c99", "-O2", "-shared", "-fPIC", tmp,
+                     "-o", so_path],
+                    capture_output=True, text=True, timeout=60)
+                os.unlink(tmp)
+                if proc.returncode != 0:
+                    self.build_note = f"compile failed: {proc.stderr[:160]}"
+                    return
+            lib = ctypes.CDLL(so_path)
+            lib.omni_hash.restype = ctypes.c_ulonglong
+            lib.omni_hash.argtypes = [ctypes.c_char_p, ctypes.c_int]
+            lib.omni_route.restype = ctypes.c_int
+            lib.omni_route.argtypes = [ctypes.c_char_p, ctypes.c_int, ctypes.c_int]
+            lib.omni_score.restype = ctypes.c_int
+            lib.omni_score.argtypes = [ctypes.c_char_p, ctypes.c_int]
+            lib.omni_generate.restype = ctypes.c_int
+            lib.omni_generate.argtypes = [ctypes.c_ulonglong, ctypes.c_char_p,
+                                          ctypes.c_int]
+            self.lib = lib
+            self.backend = "native-c99"
+            self.build_note = so_path
+            STATE.log("OK", "C99", f"Native inference engine compiled :: {so_path}")
+        except Exception as exc:
+            self.build_note = f"build error: {exc}"
+
+    # ------------------------------------------------------------- invoke
+    def _meter(self, t0: float) -> None:
+        self.calls += 1
+        self.total_us += int((time.time() - t0) * 1_000_000)
+
+    def route(self, text: str, buckets: int) -> int:
+        t0 = time.time()
+        if self.lib is not None:
+            data = (text or "").encode("utf-8", errors="replace")
+            res = int(self.lib.omni_route(data, len(data), int(buckets)))
+        else:
+            res = py_route(text, buckets)
+        with self.lock:
+            self._meter(t0)
+        return res
+
+    def score(self, text: str) -> int:
+        t0 = time.time()
+        if self.lib is not None:
+            data = (text or "").encode("utf-8", errors="replace")
+            res = int(self.lib.omni_score(data, len(data)))
+        else:
+            res = py_score(text)
+        with self.lock:
+            self._meter(t0)
+        return res
+
+    def generate(self, seed: int, max_len: int = 64) -> str:
+        t0 = time.time()
+        max_len = max(8, min(512, int(max_len)))
+        if self.lib is not None:
+            buf = ctypes.create_string_buffer(max_len)
+            self.lib.omni_generate(ctypes.c_ulonglong(seed & _MASK64), buf, max_len)
+            res = buf.value.decode("utf-8", errors="replace")
+        else:
+            res = py_generate(seed, max_len)
+        with self.lock:
+            self._meter(t0)
+        return res
+
+    # ---------------------------------------------------------- telemetry
+    def stats(self) -> Dict[str, object]:
+        with self.lock:
+            avg = round(self.total_us / max(self.calls, 1), 1)
+            return {"backend": self.backend, "build": self.build_note,
+                    "calls": self.calls, "avg_latency_us": avg,
+                    "source": _C_SRC}
+
+    def heartbeat_payload(self) -> str:
+        s = self.stats()
+        return (f"[C99] backend {s['backend']} · calls {s['calls']} · "
+                f"avg {s['avg_latency_us']}µs")
+
+
+C99 = C99Bridge()
