+"""📚 SKILL LOADER :: self-improving agent skills ⇄ ~/.hermes/skills/ ⇄ DBAL.
+
+Ingests modular capability manifests (``omnihack.custom-skill/1`` schema —
+the same format the cross-reference evolution loop writes) from
+``~/.hermes/skills/``, validates them against loading gates, registers them
+into a callable registry, and closes the self-improvement loop:
+
+* **pull_skill(query)** — agents dynamically pull the best-matching loaded
+  skill on demand (token-overlap scoring × confidence weight).
+* **feedback(skill_id, ok, runtime_ms)** — execution outcomes update the
+  skill's confidence in the DBAL; winners rise, losers decay toward
+  retirement.  That is the self-optimising part.
+* **rescan()** — hot-reload: pick up newly evolved skills without restart.
+
+Backend middleware only — no frontend involvement.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import sqlite3
+import threading
+from typing import Any, Dict, List, Optional
+
+from .state import STATE, now_iso
+
+SKILLS_DIR = os.environ.get(
+    "OMNI_HERMES_SKILLS", os.path.expanduser("~/.hermes/skills"))
+PERF_DB = os.environ.get(
+    "OMNI_SKILL_PERF_DB", os.path.expanduser("~/.omnihack/vault/skill_perf.db"))
+
+MAX_STEPS = 16
+MAX_MANIFEST_BYTES = 64_000
+_RETIRE_THRESHOLD = 0.15
+
+
+def _tokenize(text: str) -> set:
+    return set(re.findall(r"[a-z0-9]{2,}", (text or "").lower()))
+
+
+class SkillLoader:
+    """Registry + DBAL performance ledger for evolved/custom skills."""
+
+    def __init__(self, skills_dir: Optional[str] = None,
+                 perf_db: Optional[str] = None) -> None:
+        self.skills_dir = skills_dir or SKILLS_DIR
+        self.perf_db = perf_db or PERF_DB
+        self.lock = threading.RLock()
+        self.registry: Dict[str, Dict[str, Any]] = {}
+        os.makedirs(self.skills_dir, exist_ok=True)
+        os.makedirs(os.path.dirname(self.perf_db), exist_ok=True)
+        self._init_db()
+        self.rescan(verbose=False)
+
+    # ------------------------------------------------------------------ db
+    def _conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.perf_db, timeout=5)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self.lock, self._conn() as conn:
+            conn.executescript("""
+            CREATE TABLE IF NOT EXISTS skill_perf (
+                skill_id TEXT PRIMARY KEY, title TEXT,
+                confidence REAL DEFAULT 0.5, uses INTEGER DEFAULT 0,
+                ok_runs INTEGER DEFAULT 0, fail_runs INTEGER DEFAULT 0,
+                avg_runtime_ms REAL DEFAULT 0, status TEXT DEFAULT 'active',
+                updated TEXT);
+            CREATE TABLE IF NOT EXISTS load_log (
+                ts TEXT, skill_id TEXT, result TEXT, note TEXT);
+            """)
+
+    def _log_load(self, conn: sqlite3.Connection, skill_id: str,
+                  result: str, note: str) -> None:
+        conn.execute("INSERT INTO load_log (ts, skill_id, result, note)"
+                     " VALUES (?,?,?,?)", (now_iso(), skill_id, result, note))
+
+    # ------------------------------------------------------------- loading
+    def rescan(self, verbose: bool = True) -> Dict[str, Any]:
+        """(Re)load every manifest in ~/.hermes/skills/ through the gates."""
+        loaded = rejected = 0
+        try:
+            entries = sorted(os.listdir(self.skills_dir))
+        except OSError:
+            entries = []
+        for fname in entries:
+            if not fname.endswith(".json"):
+                continue
+            path = os.path.join(self.skills_dir, fname)
+            try:
+                if os.path.getsize(path) > MAX_MANIFEST_BYTES:
+                    raise ValueError("manifest too large (bloat guard)")
+                with open(path) as fh:
+                    manifest = json.load(fh)
+            except Exception as exc:
+                rejected += 1
+                with self.lock, self._conn() as conn:
+                    self._log_load(conn, fname, "REJECTED", f"read: {exc}")
+                continue
+            sid = manifest.get("id") or fname[:-5]
+            gate = self._gate(manifest)
+            with self.lock, self._conn() as conn:
+                if gate:
+                    rejected += 1
+                    self._log_load(conn, sid, "REJECTED", gate)
+                    continue
+                self.registry[sid] = {
+                    "id": sid, "title": manifest.get("title", sid),
+                    "steps": manifest.get("steps", []),
+                    "signature": manifest.get("signature", ""),
+                    "created": manifest.get("created", ""),
+                    "path": path,
+                }
+                conn.execute(
+                    "INSERT OR IGNORE INTO skill_perf (skill_id, title, updated)"
+                    " VALUES (?,?,?)", (sid, manifest.get("title", sid), now_iso()))
+                self._log_load(conn, sid, "LOADED", f"{len(manifest.get('steps', []))} steps")
+            loaded += 1
+        if verbose or loaded:
+            STATE.log("INFO", "SKILL-LOADER",
+                      f"Rescan :: {loaded} loaded / {rejected} rejected "
+                      f"(registry now {len(self.registry)}).")
+        return {"loaded": loaded, "rejected": rejected,
+                "registry_size": len(self.registry)}
+
+    @staticmethod
+    def _gate(manifest: Dict[str, Any]) -> Optional[str]:
+        if manifest.get("schema") != "omnihack.custom-skill/1":
+            return "gate: schema mismatch"
+        steps = manifest.get("steps")
+        if not isinstance(steps, list) or not (1 <= len(steps) <= MAX_STEPS):
+            return "gate: steps missing/out of bounds"
+        for s in steps:
+            if not isinstance(s, dict) or not s.get("skill_id"):
+                return "gate: step lacks skill_id"
+        if not manifest.get("id") or not manifest.get("signature"):
+            return "gate: id/signature required"
+        return None
+
+    # ------------------------------------------------------------- pulling
+    def pull_skill(self, query: str, agent: str = "—") -> Dict[str, Any]:
+        """On-demand pull: token match × confidence; updates usage ledger."""
+        q_tokens = _tokenize(query)
+        if not q_tokens:
+            return {"ok": False, "error": "empty query"}
+        best: Optional[Dict[str, Any]] = None
+        best_score = 0.0
+        with self.lock, self._conn() as conn:
+            perf = {r["skill_id"]: dict(r) for r in
+                    conn.execute("SELECT * FROM skill_perf").fetchall()}
+        for sid, skill in self.registry.items():
+            conf = perf.get(sid, {}).get("confidence", 0.5) or 0.5
+            if perf.get(sid, {}).get("status") == "retired":
+                continue
+            toks = _tokenize(sid.replace(".", " ") + " " + skill["title"] + " " +
+                             " ".join(s.get("skill_id", "") for s in skill["steps"]))
+            overlap = len(q_tokens & toks)
+            if not overlap:
+                continue
+            score = overlap * conf
+            if score > best_score:
+                best_score, best = score, {**skill, "confidence": conf,
+                                           "match_score": round(score, 3)}
+        if not best:
+            return {"ok": False, "error": "no loaded skill matches",
+                    "registry_size": len(self.registry)}
+        with self.lock, self._conn() as conn:
+            conn.execute("UPDATE skill_perf SET uses = uses + 1, updated=?"
+                         " WHERE skill_id=?", (now_iso(), best["id"]))
+        STATE.log("INFO", "SKILL-LOADER",
+                  f"Pulled '{best['id']}' ← {agent} (score {best['match_score']}).")
+        return {"ok": True, "skill": best, "agent": agent}
+
+    # ------------------------------------------------------------ feedback
+    def feedback(self, skill_id: str, ok: bool, runtime_ms: int = 0) -> Dict[str, Any]:
+        """Closed self-improvement loop: outcomes reshape confidence."""
+        with self.lock, self._conn() as conn:
+            row = conn.execute("SELECT * FROM skill_perf WHERE skill_id=?",
+                               (skill_id,)).fetchone()
+            if not row:
+                return {"ok": False, "error": f"unknown skill '{skill_id}'"}
+            conf = row["confidence"]
+            conf = min(0.99, conf + 0.08) if ok else max(0.0, conf - 0.12)
+            status = "retired" if conf < _RETIRE_THRESHOLD else "active"
+            n = max(row["uses"], 1)
+            avg = row["avg_runtime_ms"] + (runtime_ms - row["avg_runtime_ms"]) / n
+            conn.execute(
+                "UPDATE skill_perf SET confidence=?, ok_runs = ok_runs + ?,"
+                " fail_runs = fail_runs + ?, avg_runtime_ms=?, status=?,"
+                " updated=? WHERE skill_id=?",
+                (round(conf, 3), 1 if ok else 0, 0 if ok else 1,
+                 round(avg, 1), status, now_iso(), skill_id))
+            if status == "retired" and row["status"] != "retired":
+                STATE.log("WARN", "SKILL-LOADER",
+                          f"Skill '{skill_id}' retired (confidence {conf:.2f}).")
+        return {"ok": True, "skill_id": skill_id, "confidence": conf,
+                "status": status}
+
+    # ----------------------------------------------------------- reporting
+    def overview(self) -> List[Dict[str, Any]]:
+        with self.lock, self._conn() as conn:
+            rows = conn.execute("SELECT * FROM skill_perf ORDER BY confidence DESC,"
+                                " uses DESC").fetchall()
+        return [dict(r) for r in rows]
+
+    def stats(self) -> Dict[str, Any]:
+        with self.lock, self._conn() as conn:
+            n_perf = conn.execute("SELECT COUNT(*) c FROM skill_perf").fetchone()["c"]
+            retired = conn.execute("SELECT COUNT(*) c FROM skill_perf"
+                                   " WHERE status='retired'").fetchone()["c"]
+            n_loads = conn.execute("SELECT COUNT(*) c FROM load_log"
+                                   " WHERE result='LOADED'").fetchone()["c"]
+        return {"registry": len(self.registry), "perf_rows": n_perf,
+                "retired": retired, "total_loads": n_loads,
+                "skills_dir": self.skills_dir}
+
+
+LOADER = SkillLoader()
